#include <stdint.h>
//TDs
TD U C U8;
TD U S U16;
TD U INT U32;
//regular kernel externs
extern VD print(CC *string);
extern VD printint(U INT count);
extern VD putc(C character);

VD calc_help(VD)
{//index for calc
	print("AneoEngine simple calculator\n");
	print("Calculator commands:\n");
	print("- Add two decimal values                         - calc_add(X Y);\n");
	print("- Subtract second decimal value from first value - calc_subtract(X Y);\n");
	print("- Multiply two decimal values                    - calc_multiply(X Y);\n");
	print("- Divide first decimal value by second value     - calc_divide(X Y);\n");
	print("- Modulo first decimal value by second value     - calc_modulo(X Y);\n");
	
}


U calc_add(U adden_1, U adden_2)
{//add decimals
	U sum = adden_1 + adden_2;
	printint(sum);
	return 0;
}

U calc_subtract(U minuend, U subtrahend)
{//subtract decimals
	U difference = minuend - subtrahend;
	printint(difference);
	return 0;
}

U calc_multiply(U factor_1, U factor_2)
{//subtract decimals
	U product = factor_1 * factor_2;
	printint(product);
	return 0;
}

U calc_divide(U dividend, U divisor)
{//divide decimals
	U quotient = dividend / divisor;
	printint(quotient);
	return 0;
}

U calc_modulo(U dividend, U divisor)
{//divide decimals
	U remainder = dividend % divisor;
	printint(remainder);
	return 0;
}
