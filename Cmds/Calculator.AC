#include <stdint.h>
//TDs
TD U C U8;
TD U S U16;
TD U INT U32;
//regular kernel externs
extern VD print(CC *string);
extern VD printint(U INT count);
extern VD putc(C character);
extern INT strcmp(CC *array, CC *boundary);
extern VD printx(U32 x_value);

VD calc_help(VD)
{
	print("AneoEngine simple calculator\n");
	print("Calculator commands:\n");
	print("- Add two decimal values                         - calc.add(X Y);\n");
	print("- Subtract second decimal value from first value - calc.subtract(X Y);\n");
	print("- Multiply two decimal values                    - calc.multiply(X Y);\n");
	print("- Divide first decimal value by second value     - calc.divide(X Y);\n");
	print("- Modulo first decimal value by second value     - calc.modulo(X Y);\n");
}

U calc_decimal(INT operation, U factor_1, U factor_2)
{//decimal calc
	if(operation == 1)                      //add
		printint(factor_1 + factor_2);	
	else if(operation == 2)
		printint(factor_1 - factor_2);	//subtract	
	else if(operation == 3)		
		printint(factor_1 * factor_2);	//multiply
	else if(operation == 4)
		printint(factor_1 / factor_2);	//divide
	else if(operation == 5)
		printint(factor_1 % factor_2);  //modulo
}

U calc_hexadecimal(INT operation, U32 factor_1, U32 factor_2)
{//hexadecimal
	if(operation == 1)                      //add
		printx(factor_1 + factor_2);	
	else if(operation == 2)
		printx(factor_1 - factor_2);	//subtract	
	else if(operation == 3)		
		printx(factor_1 * factor_2);	//multiply
	else if(operation == 4)
		printx(factor_1 / factor_2);	//divide
	else if(operation == 5)
		printx(factor_1 % factor_2);    //modulo
}