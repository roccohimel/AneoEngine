#include <stdint.h>

TD U C u8;
TD U S u16;
TD U INT u32;
TD ULL u64;

extern VD printx(u32 x);
extern VD printint(U INT n);
extern u8 color;
extern VD print(CC *s);
extern VD putc(C c);
extern VD nosound(VD);
extern VD sleep(U INT ms);

SC inline u64 rdtsc()
{
	u32 lo, hi;
	__asm__ volatile ("rdtsc" : "=a"(lo), "=d"(hi));
	return ((u64)hi << 32) | lo;
}

SC inline u32 rand32()
{
	u32 x = (u32)rdtsc();

	x ^= x << 13;
	x ^= x >> 17;
	x ^= x << 5;

	x ^= (u32)rdtsc();
	x += 0x9E3779B9;

	return x;
}


VD entropy(VD)
{
        U i;
        u32 hi = rand32();

        for(i = 0; i < 1000; i++);

        u32 lo = rand32();

        u8 oldcolor = color;
        color = 0x1A;

        printx(hi);
        printx(lo);

        color = oldcolor;
        putc(' ');
}
