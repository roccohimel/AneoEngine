#include <stdint.h>

TD U C u8;
TD U S u16;
TD U INT u32;

extern VD print(CC *s);
extern VD putc(C c);
extern VD printx(u32 x);
extern VD printint(U INT n);

u32 get_bit64(u32 hi, u32 lo, INT pos)
{
	INT p;
	if (pos >= 32)
	{
		p = pos - 32;
		return (hi >> p) & 1;
	}
	return (lo >> pos) & 1;
}

u32 udiv10_64(u32 hi, u32 lo, u32 *qhi_out, u32 *qlo_out)
{
	u32 qhi = 0;
	u32 qlo = 0;
	u32 rem = 0;
	INT pos;
	u32 bit;
	u32 carry;
	u32 qbit;

	for (pos = 63; pos >= 0; pos = pos - 1)
	{
		bit = get_bit64(hi, lo, pos);

		rem = (rem << 1) | bit;

		if (rem >= 10)
		{
			rem = rem - 10;
			qbit = 1;
		}
		else
		{
			qbit = 0;
		}

		carry = (qlo >> 31) & 1;
		qlo = (qlo << 1) | qbit;
		qhi = (qhi << 1) | carry;
	}

	*qhi_out = qhi;
	*qlo_out = qlo;
	return rem;
}

VD print_dec64(u32 hi, u32 lo)
{
	C buf[24];
	INT i = 0;
	u32 qhi;
	u32 qlo;
	u32 rem;

	if (hi == 0 && lo == 0)
	{
		putc('0');
		return;
	}

	while (hi != 0 || lo != 0)
	{
		rem = udiv10_64(hi, lo, &qhi, &qlo);
		buf[i] = (C)rem + '0';
		i = i + 1;
		hi = qhi;
		lo = qlo;
	}

	while (i > 0)
	{
		i = i - 1;
		putc(buf[i]);
	}
}

VD print_bin64(u32 hi, u32 lo)
{
	INT i;
	INT started = 0;
	u32 bit;

	for (i = 31; i >= 0; i = i - 1)
	{
		bit = (hi >> i) & 1;
		if (bit == 1)
			started = 1;
		if (started == 1)
			putc((C)bit + '0');
	}

	for (i = 31; i >= 0; i = i - 1)
	{
		bit = (lo >> i) & 1;
		if (bit == 1)
			started = 1;
		if (started == 1)
			putc((C)bit + '0');
	}

	if (started == 0)
		putc('0');
}

VD hex_to_hilo(CC *hex, u32 *hi_out, u32 *lo_out)
{
	u32 hi = 0;
	u32 lo = 0;
	C c;
	u32 digit;

	while (*hex)
	{
		c = *hex;

		if (c >= '0' && c <= '9')
			digit = c - '0';
		else if (c >= 'a' && c <= 'f')
			digit = c - 'a' + 10;
		else if (c >= 'A' && c <= 'F')
			digit = c - 'A' + 10;
		else
			break;

		hi = (hi << 4) | (lo >> 28);
		lo = (lo << 4) | digit;
		hex = hex + 1;
	}

	*hi_out = hi;
	*lo_out = lo;
}

VD convert(CC *strhex)
{
	u32 hi;
	u32 lo;

	hex_to_hilo(strhex, &hi, &lo);

	print("Decimal: ");
	print_dec64(hi, lo);
	print("\n");
	print("Binary: ");
	print_bin64(hi, lo);
	print("\n");
}
