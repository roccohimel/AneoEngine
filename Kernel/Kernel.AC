u8 hexval(C character)
{
	if(character >= '0' && character <= '9')
		return character - '0';
	if(character >= 'a' && character <= 'f')
		return character - 'a' + 10;
	if(character >= 'A' && character <= 'F')
		return character - 'A' + 10;
	return 0;
}

u32 atox(CC *string)
{
	u32 value = 0;
	while(*string) {
		C character = *string++;
		if(character >= '0' && character <= '9')
			value = (value << 4) | (character - '0');
		else if(character >= 'a' && character <= 'f')
			value = (value << 4) | (character - 'a' + 10);
		else if(character >= 'A' && character <= 'F')
			value = (value << 4) | (character - 'A' + 10);
		else
			break;
	}
	return value;
}

u32 parsex(CC *string)
{
	if(string[0] == '0' && (string[1] == 'x' || string[1] == 'X'))
		return atox(string + 2);
	return atoi(string);
}
// CPDRIVE U32 ABI FIX - ACTUAL MODIFIED FILE
#define CP_MAX_DRIVES 4
#define CP_BOOT_KERNEL_LBA 105
#define CP_BOOT_KERNEL_SECTORS 512
#define CP_NONE 0
#define CP_ATA 1
#define CP_ATAPI 2
TD U C CP_U8;
TD U S CP_U16;
TD U INT CP_U32;
TD ST {
	CP_U16 io;
	CP_U16 ctrl;
	CP_U8 slave;
	CP_U8 type;
	CP_U8 lba48;
	CP_U32 sectors;
	CP_U32 block_size;
	C model[41];
} CPDrive;
SC CPDrive cp_drives[CP_MAX_DRIVES];
SC CP_U16 cp_buffer[1024];
SC CP_U16 cp_sector_buffer[256];
SC CP_U16 cp_verify_buffer[256];
SC CP_U16 cp_scan_ios[4] = {0x1F0, 0x1F0, 0x170, 0x170};
SC CP_U16 cp_scan_ctrls[4] = {0x3F6, 0x3F6, 0x376, 0x376};
SC CP_U8 cp_scan_slaves[4] = {0, 1, 0, 1};

SC inline CP_U8 cp_inb(CP_U16 port)
{
	return inb(port);
}

SC inline CP_U16 cp_inw(CP_U16 port)
{
	return inw(port);
}

SC inline VD cp_outb(CP_U16 port, CP_U8 value)
{
	outb(port, value);
}

SC inline VD cp_outw(CP_U16 port, CP_U16 value)
{
	outw(port, value);
}

SC VD cp_delay(CPDrive *drive)
{
	cp_inb(drive->ctrl);
	cp_inb(drive->ctrl);
	cp_inb(drive->ctrl);
	cp_inb(drive->ctrl);
}

SC INT cp_wait_not_busy(CPDrive *drive)
{
	CP_U32 timeout = 10000000;
	while(timeout--)
		if(!(cp_inb(drive->io + 7) & 0x80))
			return 1;
	return 0;
}

SC INT cp_wait_drq(CPDrive *drive)
{
	CP_U32 timeout = 10000000;
	CP_U8 status;
	while(timeout--) {
		status = cp_inb(drive->io + 7);
		if(status & 0x21)
			return 0;
		if(!(status & 0x80) && (status & 0x08))
			return 1;
	}
	return 0;
}

SC INT cp_wait_done(CPDrive *drive)
{
	CP_U8 status;
	if(!cp_wait_not_busy(drive))
		return 0;
	status = cp_inb(drive->io + 7);
	if(status & 0x21)
		return 0;
	return 1;
}

SC VD cp_set_name(CPDrive *drive, CC *name)
{
	CP_U32 index = 0;
	while(name[index] && index < 40) {
		drive->model[index] = name[index];
		index++;
	}
	drive->model[index] = 0;
}

SC VD cp_model_from_identify(CPDrive *drive, CP_U16 *identify)
{
	CP_U32 index;
	CP_U32 end;
	for(index = 0; index < 20; index++) {
		drive->model[index * 2] = (C)(identify[27 + index] >> 8);
		drive->model[index * 2 + 1] =
			(C)(identify[27 + index] & 0xFF);
	}
	drive->model[40] = 0;
	end = 40;
	while(end &&
	      (drive->model[end - 1] == ' ' ||
	       drive->model[end - 1] == 0))
		end--;
	drive->model[end] = 0;
}

SC INT cp_atapi_packet_read(CPDrive *drive,
				CP_U8 *packet,
				CP_U32 bytes,
				CP_U8 *buffer)
{
	CP_U32 index;
	CP_U32 done = 0;
	CP_U32 count;
	CP_U32 words;
	CP_U16 value;
	if(!cp_wait_not_busy(drive))
		return 0;
	cp_outb(drive->io + 6,
		0xA0 | (drive->slave << 4));
	cp_delay(drive);
	cp_outb(drive->io + 1, 0);
	cp_outb(drive->io + 2, 0);
	cp_outb(drive->io + 3, 0);
	cp_outb(drive->io + 4,
		(CP_U8)(bytes & 0xFF));
	cp_outb(drive->io + 5,
		(CP_U8)((bytes >> 8) & 0xFF));
	cp_outb(drive->io + 7, 0xA0);
	if(!cp_wait_drq(drive))
		return 0;
	for(index = 0; index < 6; index++) {
		cp_outw(drive->io,
			(CP_U16)packet[index * 2] |
			((CP_U16)packet[index * 2 + 1] << 8));
	}
	while(done < bytes) {
		if(!cp_wait_drq(drive))
			return 0;
		count = (CP_U32)cp_inb(drive->io + 4);
		count |= (CP_U32)cp_inb(drive->io + 5) << 8;
		if(!count)
			return 0;
		words = (count + 1) >> 1;
		for(index = 0; index < words; index++) {
			value = cp_inw(drive->io);
			if(done + index * 2 < bytes) {
				buffer[done + index * 2] =
					(CP_U8)(value & 0xFF);
			}
			if(done + index * 2 + 1 < bytes) {
				buffer[done + index * 2 + 1] =
					(CP_U8)(value >> 8);
			}
		}
		done += count;
	}
	return cp_wait_done(drive);
}

SC INT cp_atapi_capacity(CPDrive *drive)
{
	CP_U8 packet[12];
	CP_U8 data[8];
	CP_U32 index;
	CP_U32 last_lba;
	CP_U32 block_size;
	for(index = 0; index < 12; index++)
		packet[index] = 0;
	packet[0] = 0x25;
	if(!cp_atapi_packet_read(drive,
				 packet,
				 8,
				 data))
		return 0;
	last_lba =
		((CP_U32)data[0] << 24) |
		((CP_U32)data[1] << 16) |
		((CP_U32)data[2] << 8) |
		(CP_U32)data[3];
	block_size =
		((CP_U32)data[4] << 24) |
		((CP_U32)data[5] << 16) |
		((CP_U32)data[6] << 8) |
		(CP_U32)data[7];
	drive->sectors = last_lba + 1;
	drive->block_size = block_size;
	return 1;
}

SC INT cp_identify(CPDrive *drive)
{
	CP_U16 identify[256];
	CP_U32 index;
	CP_U8 mid;
	CP_U8 high;
	CP_U8 status;
	drive->type = CP_NONE;
	drive->lba48 = 0;
	drive->sectors = 0;
	drive->block_size = 0;
	drive->model[0] = 0;
	cp_outb(drive->io + 6,
		0xA0 | (drive->slave << 4));
	cp_delay(drive);
	cp_outb(drive->io + 2, 0);
	cp_outb(drive->io + 3, 0);
	cp_outb(drive->io + 4, 0);
	cp_outb(drive->io + 5, 0);
	cp_outb(drive->io + 7, 0xEC);
	cp_delay(drive);
	status = cp_inb(drive->io + 7);
	if(!status)
		return 0;
	if(!cp_wait_not_busy(drive))
		return 0;
	mid = cp_inb(drive->io + 4);
	high = cp_inb(drive->io + 5);
	if((mid == 0x14 && high == 0xEB) ||
	   (mid == 0x69 && high == 0x96)) {
		drive->type = CP_ATAPI;
		cp_outb(drive->io + 7, 0xA1);
		if(!cp_wait_drq(drive))
			return 0;
	} else {
		drive->type = CP_ATA;
		if(!cp_wait_drq(drive))
			return 0;
	}
	for(index = 0; index < 256; index++)
		identify[index] = cp_inw(drive->io);
	cp_model_from_identify(drive, identify);
	if(drive->type == CP_ATA) {
		drive->block_size = 512;
		if((identify[83] & (1 << 10)) &&
		   (identify[100] ||
		    identify[101] ||
		    identify[102] ||
		    identify[103])) {
			drive->lba48 = 1;
			if(identify[102] || identify[103])
				drive->sectors = 0xFFFFFFFFU;
			else
				drive->sectors =
					(CP_U32)identify[100] |
					((CP_U32)identify[101] << 16);
		} else {
			drive->sectors =
				(CP_U32)identify[60] |
				((CP_U32)identify[61] << 16);
		}
		if(!drive->model[0])
			cp_set_name(drive, "ATA Disk");
		return drive->sectors != 0;
	}
	if(!drive->model[0])
		cp_set_name(drive, "ATAPI CD-ROM");
	return cp_atapi_capacity(drive);
}

SC INT cp_scan_drives(VD)
{
	CP_U32 index;
	INT count = 0;
	for(index = 0; index < CP_MAX_DRIVES; index++) {
		cp_drives[index].io = cp_scan_ios[index];
		cp_drives[index].ctrl = cp_scan_ctrls[index];
		cp_drives[index].slave = cp_scan_slaves[index];
		if(cp_identify(&cp_drives[index]))
			count++;
	}
	return count;
}

SC INT cp_find_source(VD)
{
	CP_U8 bios_drive =
		*((CP_U8 *)0x0500);
	CP_U32 wanted;
	CP_U32 found;
	CP_U32 index;
	INT first_ata = -1;
	INT first_atapi = -1;
	for(index = 0; index < CP_MAX_DRIVES; index++) {
		if(cp_drives[index].type == CP_ATA &&
		   first_ata < 0)
			first_ata = (INT)index;
		if(cp_drives[index].type == CP_ATAPI &&
		   first_atapi < 0)
			first_atapi = (INT)index;
	}
	if(bios_drive < 0x80)
		return first_atapi;
	if(bios_drive >= 0xE0) {
		wanted = bios_drive - 0xE0;
		found = 0;
		for(index = 0; index < CP_MAX_DRIVES; index++) {
			if(cp_drives[index].type != CP_ATAPI)
				continue;
			if(found == wanted)
				return (INT)index;
			found++;
		}
		return first_atapi;
	}
	wanted = bios_drive - 0x80;
	found = 0;
	for(index = 0; index < CP_MAX_DRIVES; index++) {
		if(cp_drives[index].type != CP_ATA)
			continue;
		if(found == wanted)
			return (INT)index;
		found++;
	}
	return first_ata;
}

SC INT cp_ata_read(CPDrive *drive,
		       CP_U32 lba,
		       CP_U16 *buffer)
{
	CP_U32 index;
	if(!cp_wait_not_busy(drive))
		return 0;
	if(drive->lba48 && lba > 0x0FFFFFFFU) {
		cp_outb(drive->io + 6,
			0xE0 | (drive->slave << 4));
		cp_delay(drive);
		cp_outb(drive->io + 2, 0);
		cp_outb(drive->io + 3,
			(CP_U8)(lba >> 24));
		cp_outb(drive->io + 4, 0);
		cp_outb(drive->io + 5, 0);
		cp_outb(drive->io + 2, 1);
		cp_outb(drive->io + 3,
			(CP_U8)lba);
		cp_outb(drive->io + 4,
			(CP_U8)(lba >> 8));
		cp_outb(drive->io + 5,
			(CP_U8)(lba >> 16));
		cp_outb(drive->io + 7, 0x24);
	} else {
		if(lba > 0x0FFFFFFFU)
			return 0;
		cp_outb(drive->io + 6,
			0xE0 |
			(drive->slave << 4) |
			((CP_U8)(lba >> 24) & 0x0F));
		cp_delay(drive);
		cp_outb(drive->io + 2, 1);
		cp_outb(drive->io + 3,
			(CP_U8)lba);
		cp_outb(drive->io + 4,
			(CP_U8)(lba >> 8));
		cp_outb(drive->io + 5,
			(CP_U8)(lba >> 16));
		cp_outb(drive->io + 7, 0x20);
	}
	if(!cp_wait_drq(drive))
		return 0;
	for(index = 0; index < 256; index++)
		buffer[index] = cp_inw(drive->io);
	return cp_wait_done(drive);
}

SC INT cp_ata_write(CPDrive *drive,
			CP_U32 lba,
			CP_U16 *buffer)
{
	CP_U32 index;
	if(!cp_wait_not_busy(drive))
		return 0;
	if(drive->lba48 && lba > 0x0FFFFFFFU) {
		cp_outb(drive->io + 6,
			0xE0 | (drive->slave << 4));
		cp_delay(drive);
		cp_outb(drive->io + 2, 0);
		cp_outb(drive->io + 3,
			(CP_U8)(lba >> 24));
		cp_outb(drive->io + 4, 0);
		cp_outb(drive->io + 5, 0);
		cp_outb(drive->io + 2, 1);
		cp_outb(drive->io + 3,
			(CP_U8)lba);
		cp_outb(drive->io + 4,
			(CP_U8)(lba >> 8));
		cp_outb(drive->io + 5,
			(CP_U8)(lba >> 16));
		cp_outb(drive->io + 7, 0x34);
	} else {
		if(lba > 0x0FFFFFFFU)
			return 0;
		cp_outb(drive->io + 6,
			0xE0 |
			(drive->slave << 4) |
			((CP_U8)(lba >> 24) & 0x0F));
		cp_delay(drive);
		cp_outb(drive->io + 2, 1);
		cp_outb(drive->io + 3,
			(CP_U8)lba);
		cp_outb(drive->io + 4,
			(CP_U8)(lba >> 8));
		cp_outb(drive->io + 5,
			(CP_U8)(lba >> 16));
		cp_outb(drive->io + 7, 0x30);
	}
	if(!cp_wait_drq(drive))
		return 0;
	for(index = 0; index < 256; index++)
		cp_outw(drive->io, buffer[index]);
	return cp_wait_done(drive);
}

SC INT cp_ata_flush(CPDrive *drive)
{
	if(!cp_wait_not_busy(drive))
		return 0;
	cp_outb(drive->io + 6,
		0xE0 | (drive->slave << 4));
	cp_outb(drive->io + 7, 0xE7);
	return cp_wait_done(drive);
}

SC INT cp_atapi_read(CPDrive *drive,
			 CP_U32 lba,
			 CP_U16 *buffer)
{
	CP_U8 packet[12];
	CP_U32 index;
	for(index = 0; index < 12; index++)
		packet[index] = 0;
	packet[0] = 0xA8;
	packet[2] = (CP_U8)(lba >> 24);
	packet[3] = (CP_U8)(lba >> 16);
	packet[4] = (CP_U8)(lba >> 8);
	packet[5] = (CP_U8)lba;
	packet[9] = 1;
	return cp_atapi_packet_read(drive,
				     packet,
				     2048,
				     (CP_U8 *)buffer);
}

SC VD cp_print_u32(CP_U32 value)
{
	C buffer[11];
	CP_U32 count = 0;
	if(!value) {
		putc('0');
		return;
	}
	while(value) {
		buffer[count++] =
			'0' + value % 10;
		value /= 10;
	}
	while(count)
		putc(buffer[--count]);
}

SC CP_U32 cp_mib(CPDrive *drive)
{
	CP_U32 sectors = (CP_U32)drive->sectors;
	if(drive->block_size == 2048)
		return sectors / 512;
	return sectors / 2048;
}

SC VD cp_print_location(CPDrive *drive)
{
	if(drive->io == 0x1F0)
		print("Primary ");
	else
		print("Secondary ");
	if(drive->slave)
		print("Slave");
	else
		print("Master");
}

SC CP_U32 cp_read_line(C *buffer,
			   CP_U32 max)
{
	CP_U32 length = 0;
	INT key;
	while(1) {
		key = getkey();
		if(key == '\r' || key == '\n') {
			putc('\n');
			buffer[length] = 0;
			return length;
		}
		if((key == '\b' || key == 127) &&
		   length) {
			length--;
			putc('\b');
			putc(' ');
			putc('\b');
			continue;
		}
		if(key >= 32 &&
		   key <= 126 &&
		   length + 1 < max) {
			buffer[length++] = (C)key;
			putc((C)key);
		}
	}
}

SC CP_U32 cp_parse_number(C *buffer)
{
	CP_U32 value = 0;
	CP_U32 index = 0;
	while(buffer[index] >= '0' &&
	      buffer[index] <= '9') {
		value =
			value * 10 +
			(CP_U32)(buffer[index] - '0');
		index++;
	}
	if(buffer[index])
		return 0;
	return value;
}

SC INT cp_is_yes(C *buffer)
{
	return
		(buffer[0] == 'Y' ||
		 buffer[0] == 'y') &&
		(buffer[1] == 'E' ||
		 buffer[1] == 'e') &&
		(buffer[2] == 'S' ||
		 buffer[2] == 's') &&
		buffer[3] == 0;
}

SC VD cp_progress(CP_U32 mib)
{
	print("Copied ");
	cp_print_u32(mib);
	print(" MiB\n");
}

SC INT cp_matches_running_kernel(CP_U16 *buffer)
{
	CP_U16 *kernel = (CP_U16 *)0x10000;
	CP_U32 word;
	for(word = 0; word < 256; word++) {
		if(buffer[word] != kernel[word])
			return 0;
	}
	return 1;
}

SC INT cp_find_copied_kernel(CPDrive *target,
			     CP_U32 image_sectors,
			     CP_U32 *kernel_lba)
{
	CP_U32 lba;
	for(lba = 1; lba < image_sectors; lba++) {
		if(!cp_ata_read(target,
				 lba,
				 cp_verify_buffer)) {
			print("\nKernel scan read failed at disk sector ");
			cp_print_u32(lba);
			putc('\n');
			return 0;
		}
		if(cp_matches_running_kernel(cp_verify_buffer)) {
			*kernel_lba = lba;
			return 1;
		}
	}
	return 0;
}

SC INT cp_copy_kernel_sector(CPDrive *target,
			     CP_U32 source_lba,
			     CP_U32 target_lba)
{
	CP_U32 word;
	if(!cp_ata_read(target,
			 source_lba,
			 cp_sector_buffer))
		return 0;
	if(!cp_ata_write(target,
			  target_lba,
			  cp_sector_buffer))
		return 0;
	if(!cp_ata_read(target,
			 target_lba,
			 cp_verify_buffer))
		return 0;
	for(word = 0; word < 256; word++) {
		if(cp_verify_buffer[word] !=
		   cp_sector_buffer[word])
			return 0;
	}
	return 1;
}

SC INT cp_place_kernel_for_hdd_boot(CPDrive *target,
				    CP_U32 image_sectors)
{
	CP_U32 found_lba;
	CP_U32 index;
	CP_U32 source_lba;
	CP_U32 target_lba;
	if(!cp_find_copied_kernel(target,
				 image_sectors,
				 &found_lba)) {
		print("\nCould not find the copied kernel image.\n");
		return 0;
	}
	print("Kernel image found at disk sector ");
	cp_print_u32(found_lba);
	putc('\n');
	if(found_lba == CP_BOOT_KERNEL_LBA)
		return 1;
	if(found_lba + CP_BOOT_KERNEL_SECTORS >
	   image_sectors) {
		print("Copied kernel image is incomplete.\n");
		return 0;
	}
	print("Placing kernel at boot sector ");
	cp_print_u32(CP_BOOT_KERNEL_LBA);
	print("...\n");
	if(found_lba > CP_BOOT_KERNEL_LBA) {
		for(index = 0; index < CP_BOOT_KERNEL_SECTORS; index++) {
			source_lba = found_lba + index;
			target_lba = CP_BOOT_KERNEL_LBA + index;
			if(!cp_copy_kernel_sector(target,
						 source_lba,
						 target_lba)) {
				print("Kernel placement failed at sector ");
				cp_print_u32(target_lba);
				putc('\n');
				return 0;
			}
		}
	} else {
		index = CP_BOOT_KERNEL_SECTORS;
		while(index) {
			index--;
			source_lba = found_lba + index;
			target_lba = CP_BOOT_KERNEL_LBA + index;
			if(!cp_copy_kernel_sector(target,
						 source_lba,
						 target_lba)) {
				print("Kernel placement failed at sector ");
				cp_print_u32(target_lba);
				putc('\n');
				return 0;
			}
		}
	}
	if(!cp_ata_flush(target))
		return 0;
	if(!cp_ata_read(target,
			 CP_BOOT_KERNEL_LBA,
			 cp_verify_buffer))
		return 0;
	if(!cp_matches_running_kernel(cp_verify_buffer)) {
		print("Installed kernel entry verification failed.\n");
		return 0;
	}
	print("Installed kernel entry verified.\n");
	return 1;
}

SC INT cp_copy_ata(CPDrive *source,
		       CPDrive *target)
{
	CP_U32 lba;
	for(lba = 0;
	    lba < source->sectors;
	    lba++) {
		if(!cp_ata_read(source,
				lba,
				cp_buffer)) {
			print("\nRead failed at sector ");
			cp_print_u32((CP_U32)lba);
			putc('\n');
			return 0;
		}
		if(!cp_ata_write(target,
				 lba,
				 cp_buffer)) {
			print("\nWrite failed at sector ");
			cp_print_u32((CP_U32)lba);
			putc('\n');
			return 0;
		}
		if(!(lba & 0x7FFF))
			cp_progress(
				((CP_U32)lba) / 2048);
	}
	return cp_ata_flush(target);
}

SC INT cp_copy_atapi(CPDrive *source,
			 CPDrive *target)
{
	CP_U32 lba;
	CP_U32 target_lba;
	CP_U32 source_sectors;
	CP_U32 part;
	CP_U32 word;
	source_sectors = (CP_U32)source->sectors;
	for(lba = 0;
	    lba < source_sectors;
	    lba++) {
		if(!cp_atapi_read(source,
				  lba,
				  cp_buffer)) {
			print("\nRead failed at CD sector ");
			cp_print_u32(lba);
			putc('\n');
			return 0;
		}
		target_lba = lba * 4;
		for(part = 0; part < 4; part++) {
			for(word = 0; word < 256; word++)
				cp_sector_buffer[word] =
					cp_buffer[part * 256 + word];
			if(!cp_ata_write(
				   target,
				   (target_lba + part),
				   cp_sector_buffer)) {
				print(
					"\nWrite failed at disk sector ");
				cp_print_u32(target_lba + part);
				putc('\n');
				return 0;
			}
			if(!cp_ata_read(
				   target,
				   (target_lba + part),
				   cp_verify_buffer)) {
				print(
					"\nVerify read failed at disk sector ");
				cp_print_u32(target_lba + part);
				putc('\n');
				return 0;
			}
			for(word = 0; word < 256; word++) {
				if(cp_verify_buffer[word] !=
				   cp_sector_buffer[word]) {
					print(
						"\nVerify failed at disk sector ");
					cp_print_u32(target_lba + part);
					putc('\n');
					return 0;
				}
			}
		}
		if(!(lba & 0x1FFF))
			cp_progress(lba / 512);
	}
	return cp_ata_flush(target);
}

VD cpdrive(VD)
{
	INT source_index;
	INT targets[CP_MAX_DRIVES];
	INT target_count = 0;
	INT target_index;
	CP_U32 index;
	CP_U32 choice;
	CP_U32 source_mib;
	CP_U32 source_image_sectors;
	CP_U32 required_sectors;
	C input[16];
	CPDrive *source;
	CPDrive *target;
	print("\nScanning drives...\n");
	if(!cp_scan_drives()) {
		print("No IDE devices found.\n");
		return;
	}
	source_index = cp_find_source();
	if(source_index < 0) {
		print(
			"Could not map the BIOS boot drive "
			"to an IDE device.\n");
		return;
	}
	source = &cp_drives[source_index];
	if(source->type == CP_ATAPI &&
	   source->block_size != 2048) {
		print(
			"The boot CD does not use "
			"2048-byte logical sectors.\n");
		return;
	}
	source_mib = cp_mib(source);
	if(source->type == CP_ATAPI)
		source_image_sectors =
			(CP_U32)source->sectors * 4;
	else
		source_image_sectors =
			(CP_U32)source->sectors;
	print("\nSource: Current disk - ");
	print(source->model);
	print(" ");
	cp_print_u32(source_mib);
	print(" MiB (");
	cp_print_location(source);
	print(")\n\n");
	for(index = 0; index < CP_MAX_DRIVES; index++) {
		if((INT)index == source_index ||
		   cp_drives[index].type != CP_ATA)
			continue;
		targets[target_count] = (INT)index;
		print("Device ");
		cp_print_u32(
			(CP_U32)target_count + 1);
		print(": ");
		print(cp_drives[index].model);
		print(" ");
		cp_print_u32(
			cp_mib(&cp_drives[index]));
		print(" MiB (");
		cp_print_location(&cp_drives[index]);
		print(")\n");
		target_count++;
	}
	if(!target_count) {
		print(
			"No writable destination "
			"disks found.\n");
		return;
	}
	print("\n>");
	cp_read_line(input, sizeof(input));
	choice = cp_parse_number(input);
	if(!choice ||
	   choice > (CP_U32)target_count) {
		print("Invalid device.\n");
		return;
	}
	target_index = targets[choice - 1];
	target = &cp_drives[target_index];
	if(source->type == CP_ATAPI)
		required_sectors =
			source_image_sectors;
	else
		required_sectors =
			source->sectors;
	if(target->sectors < required_sectors) {
		print("Destination is too small.\n");
		return;
	}
	print("\nTHIS ERASES DEVICE ");
	cp_print_u32(choice);
	print(" COMPLETELY.\n");
	print("Type YES to continue: ");
	cp_read_line(input, sizeof(input));
	if(!cp_is_yes(input)) {
		print("Cancelled.\n");
		return;
	}
	print("\nInstalling AneoEngine to Device ");
	cp_print_u32(choice);
	print("\n");
	if(source->type == CP_ATAPI) {
		if(!cp_copy_atapi(source, target)) {
			print("Copy failed.\n");
			return;
		}
		if(!cp_place_kernel_for_hdd_boot(
			   target,
			   source_image_sectors)) {
			print("Kernel installation failed.\n");
			return;
		}
	} else {
		if(!cp_copy_ata(source, target)) {
			print("Copy failed.\n");
			return;
		}
	}
	cp_progress(source_mib);
	print("\nAneoEngine media copy complete.\n");
}
