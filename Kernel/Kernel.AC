VD clear(VD)
{//clear the screen
	INT index;
	INT x_coordinate;
	INT y_coordinate;
	cursor_hide();
	if(console_mode == CON_WINDOW) {
		if(wm_on && wm_active >= 0 && wm_active < WM_WINDOWS && wm_windows[wm_active].alive) {
			INT identifier;
			identifier = wm_active;
			for(y_coordinate = 0; y_coordinate < con_h; y_coordinate++) {
				index = y_coordinate * WM_CONTENT_W;
				fast_memset8(wm_buf_Cs + identifier * WM_BUFFER_SIZE + index, ' ', con_w);
				fast_memset8(wm_buf_attrs + identifier * WM_BUFFER_SIZE + index, color, con_w);
			}
			cx = 0;
			cy = 0;
			wm_redraw_region(wm_windows[identifier].x, wm_windows[identifier].y, wm_windows[identifier].x + wm_windows[identifier].w - 1, wm_windows[identifier].y + wm_windows[identifier].h - 1);
			cursor_update();
			return;
		}
		mouse_hide();
		for(y_coordinate = 0; y_coordinate < con_h; y_coordinate++) {
			index = (con_y + y_coordinate) * W + con_x;
			fast_memset8(screen_Cs + index, ' ', con_w);
			fast_memset8(screen_attrs + index, color, con_w);
		}
		gfx_clear_text_rect(con_x, con_y, con_w, con_h, (color >> 4) & 0x0F);
		cx = 0;
		cy = 0;
		cursor_update();
		mouse_show();
		return;
	}
	index = 0;
	gfx_fill((color >> 4) & 0x0F);
	while(index < W * H) {
		screen_Cs[index] = ' ';
		screen_attrs[index] = color;
		index++;
	}
	cx = 0;
	cy = 1;
	cursor_update();
}

