#define ACRI_MAX_LOCAL_VARS 32
#define ACRI_MAX_FUNCS 24
#define ACRI_MAX_PARAMS 8
#define ACRI_MAX_CALLS 12
#define ACRI_MAX_RUNTIMES 4
#define ACRI_NAME_MAX 32
#define ACRI_LINE_MAX 256
#define ACRI_LOOP_LIMIT 100000
TD ST {
	C name[ACRI_NAME_MAX];
	INT value;
	INT used;
} AcriVar;
TD ST {
	AcriVar vars[ACRI_MAX_LOCAL_VARS];
} AcriFrame;
TD ST {
	C name[ACRI_NAME_MAX];
	C params[ACRI_MAX_PARAMS * ACRI_NAME_MAX];
	INT param_count;
	INT body_start;
	INT body_end;
	INT used;
} AcriFunc;
TD ST {
	C *data;
	INT size;
	AcriVar globals[ACRI_MAX_VARS];
	AcriFrame frames[ACRI_MAX_CALLS];
	AcriFunc funcs[ACRI_MAX_FUNCS];
	INT func_count;
	INT frame_depth;
	INT returned;
	INT return_value;
	INT breaking;
	INT continuing;
	INT error;
	INT error_pos;
	CC *error_text;
	INT top_statements;
} AcriRuntime;
TD ST {
	AcriRuntime *rt;
	INT pos;
	INT end;
} AcriExpr;
SC AcriRuntime acri_runtimes[ACRI_MAX_RUNTIMES];
SC INT acri_runtime_depth = 0;
INT acri_eval_slice(AcriRuntime *rt, INT start, INT end);
VD acri_exec_range(AcriRuntime *rt, INT start, INT end);
INT acri_call(AcriRuntime *rt, CC *name, INT *args, INT argc, INT call_pos);
INT acri_statement_end(AcriRuntime *rt, INT start, INT limit);
VD acri_exec_simple(AcriRuntime *rt, INT start, INT end);
VD acri_wait_for_wm(INT id);

INT acri_is_name_start(C character)
{
	return (character >= 'a' && character <= 'z') ||
	       (character >= 'A' && character <= 'Z') || character == '_';
}

INT acri_is_name_C(C character)
{
	return acri_is_name_start(character) || (character >= '0' && character <= '9');
}

C acri_ch(AcriRuntime *runtime, INT pos)
{
	if(pos < 0 || pos >= runtime->size)
		return 0;
	return runtime->data[pos];
}

VD acri_copy_name(C *dst, CC *src)
{
	INT index;
	index = 0;
	while(src[index] && index < ACRI_NAME_MAX - 1) {
		dst[index] = src[index];
		index++;
	}
	dst[index] = 0;
}

VD acri_fail(AcriRuntime *runtime, CC *text, INT pos)
{
	if(runtime->error)
		return;
	runtime->error = 1;
	runtime->error_pos = pos;
	runtime->error_text = text;
}

INT acri_skip(AcriRuntime *runtime, INT pos, INT end)
{
	for(;;) {
		while(pos < end &&
		     (acri_ch(runtime, pos) == ' ' || acri_ch(runtime, pos) == '\t' ||
		      acri_ch(runtime, pos) == '\r' || acri_ch(runtime, pos) == '\n'))
			pos++;
		if(pos + 1 < end && acri_ch(runtime, pos) == '/' && acri_ch(runtime, pos + 1) == '/') {
			pos += 2;
			while(pos < end && acri_ch(runtime, pos) != '\n')
				pos++;
			continue;
		}
		if(pos + 1 < end && acri_ch(runtime, pos) == '/' && acri_ch(runtime, pos + 1) == '*') {
			pos += 2;
			while(pos + 1 < end &&
			     !(acri_ch(runtime, pos) == '*' && acri_ch(runtime, pos + 1) == '/'))
				pos++;
			if(pos + 1 < end)
				pos += 2;
			continue;
		}
		break;
	}
	return pos;
}

INT acri_word_at(AcriRuntime *runtime, INT pos, INT end, CC *word)
{
	INT index;
	index = 0;
	while(word[index]) {
		if(pos + index >= end || acri_ch(runtime, pos + index) != word[index])
			return 0;
		index++;
	}
	if(pos > 0 && acri_is_name_C(acri_ch(runtime, pos - 1)))
		return 0;
	if(pos + index < end && acri_is_name_C(acri_ch(runtime, pos + index)))
		return 0;
	return 1;
}

INT acri_read_name(AcriRuntime *runtime, INT pos, INT end, C *out)
{
	INT index;
	pos = acri_skip(runtime, pos, end);
	if(!acri_is_name_start(acri_ch(runtime, pos))) {
		out[0] = 0;
		return -1;
	}
	index = 0;
	while(pos < end && acri_is_name_C(acri_ch(runtime, pos))) {
		if(index < ACRI_NAME_MAX - 1)
			out[index++] = acri_ch(runtime, pos);
		pos++;
	}
	out[index] = 0;
	return pos;
}

INT acri_find_match(AcriRuntime *runtime, INT open_pos, INT end, C open_C, C close_C)
{
	INT pos;
	INT depth;
	C quote;
	C character;
	pos = open_pos;
	depth = 0;
	quote = 0;
	while(pos < end) {
		character = acri_ch(runtime, pos);
		if(quote) {
			if(character == '\\') {
				pos += 2;
				continue;
			}
			if(character == quote)
				quote = 0;
			pos++;
			continue;
		}
		if(character == '"' || character == '\'') {
			quote = character;
			pos++;
			continue;
		}
		if(character == '/' && pos + 1 < end && acri_ch(runtime, pos + 1) == '/') {
			pos += 2;
			while(pos < end && acri_ch(runtime, pos) != '\n')
				pos++;
			continue;
		}
		if(character == '/' && pos + 1 < end && acri_ch(runtime, pos + 1) == '*') {
			pos += 2;
			while(pos + 1 < end &&
			     !(acri_ch(runtime, pos) == '*' && acri_ch(runtime, pos + 1) == '/'))
				pos++;
			if(pos + 1 < end)
				pos += 2;
			continue;
		}
		if(character == open_C)
			depth++;
		else if(character == close_C) {
			depth--;
			if(depth == 0)
				return pos;
		}
		pos++;
	}
	return -1;
}

INT acri_parse_type(AcriRuntime *runtime, INT pos, INT end, INT *after)
{
	C word[ACRI_NAME_MAX];
	INT position;
	position = acri_skip(runtime, pos, end);
	if(acri_word_at(runtime, position, end, "SC")) {
		position += 2;
		position = acri_skip(runtime, position, end);
	}
	position = acri_read_name(runtime, position, end, word);
	if(position < 0)
		return 0;
	if(strcmp(word, "U") == 0 || strcmp(word, "S") == 0) {
		position = acri_read_name(runtime, position, end, word);
		if(position < 0)
			return 0;
		if(strcmp(word, "INT") != 0 && strcmp(word, "C") != 0 && strcmp(word, "S") != 0)
			return 0;
		*after = position;
		return 1;
	}
	if(strcmp(word, "INT") == 0 || strcmp(word, "C") == 0 ||
	   strcmp(word, "VD") == 0 || strcmp(word, "u8") == 0 ||
	   strcmp(word, "u16") == 0 || strcmp(word, "u32") == 0 ||
	   strcmp(word, "u64") == 0)
	{
		*after = position;
		return 1;
	}
	return 0;
}

INT acri_detect_function(AcriRuntime *runtime, INT pos, INT end,
	C *name, INT *params_start, INT *params_end,
	INT *body_start, INT *body_end, INT *next)
{
	INT position;
	INT close;
	pos = acri_skip(runtime, pos, end);
	if(!acri_parse_type(runtime, pos, end, &position))
		return 0;
	position = acri_read_name(runtime, position, end, name);
	if(position < 0)
		return 0;
	position = acri_skip(runtime, position, end);
	if(acri_ch(runtime, position) != '(')
		return 0;
	close = acri_find_match(runtime, position, end, '(', ')');
	if(close < 0)
		return 0;
	*params_start = position + 1;
	*params_end = close;
	position = acri_skip(runtime, close + 1, end);
	if(acri_ch(runtime, position) != '{')
		return 0;
	close = acri_find_match(runtime, position, end, '{', '}');
	if(close < 0)
		return 0;
	*body_start = position + 1;
	*body_end = close;
	*next = close + 1;
	return 1;
}

C *acri_param_slot(AcriFunc *function, INT index)
{
	return function->params + index * ACRI_NAME_MAX;
}

VD acri_parse_params(AcriRuntime *runtime, AcriFunc *function, INT start, INT end)
{
	INT pos;
	INT after_type;
	C name[ACRI_NAME_MAX];
	function->param_count = 0;
	pos = acri_skip(runtime, start, end);
	if(acri_word_at(runtime, pos, end, "VD"))
		return;
	while(pos < end && function->param_count < ACRI_MAX_PARAMS) {
		if(!acri_parse_type(runtime, pos, end, &after_type)) {
			acri_fail(runtime, "bad function parameter", pos);
			return;
		}
		pos = acri_read_name(runtime, after_type, end, name);
		if(pos < 0) {
			acri_fail(runtime, "missing parameter name", after_type);
			return;
		}
		acri_copy_name(acri_param_slot(function, function->param_count), name);
		function->param_count++;
		pos = acri_skip(runtime, pos, end);
		if(acri_ch(runtime, pos) == ',') {
			pos++;
			continue;
		}
		break;
	}
}

VD acri_collect_functions(AcriRuntime *runtime)
{
	INT pos;
	INT parameter_start;
	INT parameter_end;
	INT body_start_1;
	INT body_end_1;
	INT next;
	C name[ACRI_NAME_MAX];
	AcriFunc *fn;
	pos = 0;
	while(pos < runtime->size && !runtime->error) {
		pos = acri_skip(runtime, pos, runtime->size);
		if(pos >= runtime->size)
			break;
		if(acri_detect_function(runtime, pos, runtime->size, name, &parameter_start, &parameter_end, &body_start_1, &body_end_1, &next)) {
			if(runtime->func_count >= ACRI_MAX_FUNCS) {
				acri_fail(runtime, "too many functions", pos);
				return;
			}
			fn = &runtime->funcs[runtime->func_count++];
			fn->used = 1;
			acri_copy_name(fn->name, name);
			fn->body_start = body_start_1;
			fn->body_end = body_end_1;
			acri_parse_params(runtime, fn, parameter_start, parameter_end);
			pos = next;
			continue;
		}
		pos = acri_statement_end(runtime, pos, runtime->size);
		if(pos <= 0)
			break;
	}
}

AcriVar *acri_find_in(AcriVar *vars, INT count, CC *name)
{
	INT index;
	for(index = 0; index < count; index++)
		if(vars[index].used && strcmp(vars[index].name, name) == 0)
			return &vars[index];
	return 0;
}

AcriVar *acri_find_var(AcriRuntime *runtime, CC *name)
{
	AcriVar *v;
	if(runtime->frame_depth > 0) {
		v = acri_find_in(runtime->frames[runtime->frame_depth - 1].vars,
			ACRI_MAX_LOCAL_VARS, name);
		if(v)
			return v;
	}
	return acri_find_in(runtime->globals, ACRI_MAX_VARS, name);
}

AcriVar *acri_make_in(AcriRuntime *runtime, AcriVar *vars, INT count,
	CC *name, INT pos)
{
	INT index;
	AcriVar *v;
	v = acri_find_in(vars, count, name);
	if(v)
		return v;
	for(index = 0; index < count; index++) {
		if(!vars[index].used) {
			vars[index].used = 1;
			vars[index].value = 0;
			acri_copy_name(vars[index].name, name);
			return &vars[index];
		}
	}
	acri_fail(runtime, "too many variables", pos);
	return 0;
}

AcriVar *acri_make_var(AcriRuntime *runtime, CC *name, INT pos)
{
	if(runtime->frame_depth > 0)
		return acri_make_in(runtime,
			runtime->frames[runtime->frame_depth - 1].vars,
			ACRI_MAX_LOCAL_VARS, name, pos);
	return acri_make_in(runtime, runtime->globals, ACRI_MAX_VARS, name, pos);
}

VD acri_expr_skip(AcriExpr *expression_parser)
{
	expression_parser->pos = acri_skip(expression_parser->rt, expression_parser->pos, expression_parser->end);
}
INT acri_expr_or(AcriExpr *ep);

INT acri_expr_primary(AcriExpr *expression_parser)
{
	AcriRuntime *rt;
	INT pos;
	INT value;
	INT argc;
	INT args[ACRI_MAX_PARAMS];
	C name[ACRI_NAME_MAX];
	AcriVar *v;
	C character;
	rt = expression_parser->rt;
	acri_expr_skip(expression_parser);
	pos = expression_parser->pos;
	character = acri_ch(rt, pos);
	if(character == '(') {
		expression_parser->pos++;
		value = acri_expr_or(expression_parser);
		acri_expr_skip(expression_parser);
		if(acri_ch(rt, expression_parser->pos) != ')')
			acri_fail(rt, "missing )", expression_parser->pos);
		else
			expression_parser->pos++;
		return value;
	}
	if(character == '\'') {
		expression_parser->pos++;
		character = acri_ch(rt, expression_parser->pos++);
		if(character == '\\') {
			character = acri_ch(rt, expression_parser->pos++);
			if(character == 'n') character = '\n';
			else if(character == 't') character = '\t';
			else if(character == 'r') character = '\r';
			else if(character == '0') character = 0;
		}
		if(acri_ch(rt, expression_parser->pos) == '\'')
			expression_parser->pos++;
		else
			acri_fail(rt, "bad character literal", pos);
		return (INT)character;
	}
	if(character >= '0' && character <= '9') {
		value = 0;
		if(character == '0' && (acri_ch(rt, pos + 1) == 'x' || acri_ch(rt, pos + 1) == 'X')) {
			expression_parser->pos += 2;
			while(expression_parser->pos < expression_parser->end) {
				character = acri_ch(rt, expression_parser->pos);
				if(character >= '0' && character <= '9') character -= '0';
				else if(character >= 'a' && character <= 'f') character = character - 'a' + 10;
				else if(character >= 'A' && character <= 'F') character = character - 'A' + 10;
				else break;
				value = value * 16 + character;
				expression_parser->pos++;
			}
			return value;
		}
		while(expression_parser->pos < expression_parser->end && acri_ch(rt, expression_parser->pos) >= '0' && acri_ch(rt, expression_parser->pos) <= '9') {
			value = value * 10 + acri_ch(rt, expression_parser->pos) - '0';
			expression_parser->pos++;
		}
		return value;
	}
	if(acri_is_name_start(character)) {
		expression_parser->pos = acri_read_name(rt, expression_parser->pos, expression_parser->end, name);
		acri_expr_skip(expression_parser);
		if(acri_ch(rt, expression_parser->pos) == '(') {
			expression_parser->pos++;
			argc = 0;
			acri_expr_skip(expression_parser);
			if(acri_ch(rt, expression_parser->pos) != ')') {
				while(expression_parser->pos < expression_parser->end) {
					if(argc >= ACRI_MAX_PARAMS) {
						acri_fail(rt, "too many arguments", expression_parser->pos);
						break;
					}
					args[argc++] = acri_expr_or(expression_parser);
					acri_expr_skip(expression_parser);
					if(acri_ch(rt, expression_parser->pos) == ',') {
						expression_parser->pos++;
						continue;
					}
					break;
				}
			}
			acri_expr_skip(expression_parser);
			if(acri_ch(rt, expression_parser->pos) != ')')
				acri_fail(rt, "missing ) after arguments", expression_parser->pos);
			else
				expression_parser->pos++;
			return acri_call(rt, name, args, argc, pos);
		}
		if(strcmp(name, "true") == 0)
			return 1;
		if(strcmp(name, "false") == 0)
			return 0;
		v = acri_find_var(rt, name);
		if(!v) {
			acri_fail(rt, "unknown variable", pos);
			return 0;
		}
		return v->value;
	}
	acri_fail(rt, "expected expression", pos);
	return 0;
}

INT acri_expr_unary(AcriExpr *expression_parser)
{
	C character;
	INT value;
	acri_expr_skip(expression_parser);
	character = acri_ch(expression_parser->rt, expression_parser->pos);
	if(character == '!' || character == '-' || character == '+' || character == '~') {
		expression_parser->pos++;
		value = acri_expr_unary(expression_parser);
		if(character == '!') return !value;
		if(character == '-') return -value;
		if(character == '~') return ~value;
		return value;
	}
	return acri_expr_primary(expression_parser);
}

INT acri_expr_mul(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	C operator;
	value = acri_expr_unary(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		operator = acri_ch(expression_parser->rt, expression_parser->pos);
		if(operator != '*' && operator != '/' && operator != '%')
			break;
		expression_parser->pos++;
		right = acri_expr_unary(expression_parser);
		if((operator == '/' || operator == '%') && right == 0) {
			acri_fail(expression_parser->rt, "division by zero", expression_parser->pos);
			return 0;
		}
		if(operator == '*') value *= right;
		else if(operator == '/') value /= right;
		else value %= right;
	}
	return value;
}

INT acri_expr_add(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	C operator;
	value = acri_expr_mul(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		operator = acri_ch(expression_parser->rt, expression_parser->pos);
		if(operator != '+' && operator != '-')
			break;
		expression_parser->pos++;
		right = acri_expr_mul(expression_parser);
		if(operator == '+') value += right;
		else value -= right;
	}
	return value;
}

INT acri_shift_left_value(INT value, INT count)
{
	INT next;
	while(count > 0) {
		next = value * 2;
		value = next;
		count--;
	}
	return value;
}

INT acri_shift_right_value(INT value, INT count)
{
	INT next;
	while(count > 0) {
		if(value < 0 && value % 2 != 0)
			next = value / 2 - 1;
		else
			next = value / 2;
		value = next;
		count--;
	}
	return value;
}

INT acri_expr_shift(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	value = acri_expr_add(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) == '<' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '<') {
			expression_parser->pos += 2;
			right = acri_expr_add(expression_parser);
			if(right < 0 || right > 31) {
				acri_fail(expression_parser->rt, "invalid shift count", expression_parser->pos);
				return 0;
			}
			value = acri_shift_left_value(value, right);
		}
		else if(acri_ch(expression_parser->rt, expression_parser->pos) == '>' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '>') {
			expression_parser->pos += 2;
			right = acri_expr_add(expression_parser);
			if(right < 0 || right > 31) {
				acri_fail(expression_parser->rt, "invalid shift count", expression_parser->pos);
				return 0;
			}
			value = acri_shift_right_value(value, right);
		}
		else break;
	}
	return value;
}

INT acri_expr_rel(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	INT operator;
	value = acri_expr_shift(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		operator = 0;
		if(acri_ch(expression_parser->rt, expression_parser->pos) == '<' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '=') operator = 1;
		else if(acri_ch(expression_parser->rt, expression_parser->pos) == '>' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '=') operator = 2;
		else if(acri_ch(expression_parser->rt, expression_parser->pos) == '<' && acri_ch(expression_parser->rt, expression_parser->pos + 1) != '<') operator = 3;
		else if(acri_ch(expression_parser->rt, expression_parser->pos) == '>' && acri_ch(expression_parser->rt, expression_parser->pos + 1) != '>') operator = 4;
		if(!operator) break;
		if(operator <= 2)
			expression_parser->pos += 2;
		else
			expression_parser->pos++;
		right = acri_expr_shift(expression_parser);
		if(operator == 1) value = value <= right;
		else if(operator == 2) value = value >= right;
		else if(operator == 3) value = value < right;
		else value = value > right;
	}
	return value;
}

INT acri_expr_eq(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	INT equal;
	value = acri_expr_rel(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) == '=' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '=')
			equal = 1;
		else if(acri_ch(expression_parser->rt, expression_parser->pos) == '!' && acri_ch(expression_parser->rt, expression_parser->pos + 1) == '=')
			equal = 0;
		else break;
		expression_parser->pos += 2;
		right = acri_expr_rel(expression_parser);
		if(equal)
			value = value == right;
		else
			value = value != right;
	}
	return value;
}

INT acri_expr_band(AcriExpr *expression_parser)
{
	INT value;
	value = acri_expr_eq(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) != '&' || acri_ch(expression_parser->rt, expression_parser->pos + 1) == '&')
			break;
		expression_parser->pos++;
		value &= acri_expr_eq(expression_parser);
	}
	return value;
}

INT acri_expr_bxor(AcriExpr *expression_parser)
{
	INT value;
	value = acri_expr_band(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) != '^')
			break;
		expression_parser->pos++;
		value ^= acri_expr_band(expression_parser);
	}
	return value;
}

INT acri_expr_bor(AcriExpr *expression_parser)
{
	INT value;
	value = acri_expr_bxor(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) != '|' || acri_ch(expression_parser->rt, expression_parser->pos + 1) == '|')
			break;
		expression_parser->pos++;
		value |= acri_expr_bxor(expression_parser);
	}
	return value;
}

INT acri_expr_and(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	value = acri_expr_bor(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) != '&' || acri_ch(expression_parser->rt, expression_parser->pos + 1) != '&')
			break;
		expression_parser->pos += 2;
		right = acri_expr_bor(expression_parser);
		value = value && right;
	}
	return value;
}

INT acri_expr_or(AcriExpr *expression_parser)
{
	INT value;
	INT right;
	value = acri_expr_and(expression_parser);
	for(;;) {
		acri_expr_skip(expression_parser);
		if(acri_ch(expression_parser->rt, expression_parser->pos) != '|' || acri_ch(expression_parser->rt, expression_parser->pos + 1) != '|')
			break;
		expression_parser->pos += 2;
		right = acri_expr_and(expression_parser);
		value = value || right;
	}
	return value;
}

INT acri_eval_slice(AcriRuntime *runtime, INT start, INT end)
{
	AcriExpr ep;
	INT value;
	ep.rt = runtime;
	ep.pos = start;
	ep.end = end;
	value = acri_expr_or(&ep);
	acri_expr_skip(&ep);
	if(!runtime->error && ep.pos < end)
		acri_fail(runtime, "unexpected expression text", ep.pos);
	return value;
}

AcriFunc *acri_find_func(AcriRuntime *runtime, CC *name)
{
	INT index;
	for(index = 0; index < runtime->func_count; index++)
		if(runtime->funcs[index].used && strcmp(runtime->funcs[index].name, name) == 0)
			return &runtime->funcs[index];
	return 0;
}

VD acri_wait_for_wm(INT window_id)
{
	INT character_value;
	INT count;
	INT sec;
	INT last_sec;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	last_sec = -1;
	while(wm_windows[window_id].alive &&
	      (wm_windows[window_id].task_wake != 0 ||
	       wm_windows[window_id].tune_running))
	{
		ticks_poll();
		if(wm_windows[window_id].task_wake != 0 &&
		   total_ticks >= wm_windows[window_id].task_wake)
			wm_windows[window_id].task_wake = 0;
		if(wm_windows[window_id].tune_running)
			wm_tune_step(window_id);
		sec = rtc_get_second();
		if(sec != last_sec) {
			update_rtc_only();
			memstat_overlay_refresh(1);
			last_sec = sec;
		}
		wm_flash_poll();
		wm_mouse_poll();
		for(count = 0; count < WM_WINDOWS; count++) {
			if(count == window_id || !wm_windows[count].alive)
				continue;
			if(!wm_windows[count].task_pending &&
			   !wm_windows[count].task_running &&
			   wm_windows[count].task_wake == 0 &&
			   !wm_windows[count].tune_running)
				continue;
			wm_task_step(count);
		}
		character_value = getkey();
		if(character_value)
			wm_handle_key(character_value);
	}
}

INT acri_builtin(AcriRuntime *runtime, CC *name, INT *args, INT argc, INT *handled, INT pos)
{
	*handled = 1;
	if(strcmp(name, "printINT") == 0 || strcmp(name, "printint") == 0) {
		if(argc != 1) acri_fail(runtime, "printINT needs 1 argument", pos);
		else printINT(args[0]);
		return 0;
	}
	if(strcmp(name, "printx") == 0) {
		if(argc != 1) acri_fail(runtime, "printx needs 1 argument", pos);
		else printx(args[0]);
		return 0;
	}
	if(strcmp(name, "putc") == 0) {
		if(argc != 1) acri_fail(runtime, "putc needs 1 argument", pos);
		else putc((C)args[0]);
		return 0;
	}
	if(strcmp(name, "beep") == 0) {
		if(argc != 1) acri_fail(runtime, "beep needs 1 argument", pos);
		else beep(args[0]);
		return 0;
	}
	if(strcmp(name, "sleep") == 0) {
		if(argc != 1)
			acri_fail(runtime, "sleep needs 1 argument", pos);
		else if(wm_on &&
		        wm_task_exec_win >= 0 &&
		        wm_task_exec_win < WM_WINDOWS &&
		        wm_windows[wm_task_exec_win].alive)
		{
			if(args[0] < 0)
				args[0] = 0;
			wm_windows[wm_task_exec_win].task_wake =
				total_ticks + args[0];
			acri_wait_for_wm(wm_task_exec_win);
		}
		else
			sleep(args[0]);
		return 0;
	}
	if(strcmp(name, "color") == 0) {
		if(argc != 1) acri_fail(runtime, "color needs 1 argument", pos);
		else color = args[0];
		return color;
	}
	if(strcmp(name, "outb") == 0) {
		if(argc != 2) acri_fail(runtime, "outb needs 2 arguments", pos);
		else outb(args[0], args[1]);
		return 0;
	}
	if(strcmp(name, "outw") == 0) {
		if(argc != 2) acri_fail(runtime, "outw needs 2 arguments", pos);
		else outw(args[0], args[1]);
		return 0;
	}
	if(strcmp(name, "outl") == 0) {
		if(argc != 2) acri_fail(runtime, "outl needs 2 arguments", pos);
		else outl(args[0], args[1]);
		return 0;
	}
	if(strcmp(name, "inb") == 0) {
		if(argc != 1) acri_fail(runtime, "inb needs 1 argument", pos);
		else return inb(args[0]);
		return 0;
	}
	if(strcmp(name, "inw") == 0) {
		if(argc != 1) acri_fail(runtime, "inw needs 1 argument", pos);
		else return inw(args[0]);
		return 0;
	}
	if(strcmp(name, "inl") == 0) {
		if(argc != 1) acri_fail(runtime, "inl needs 1 argument", pos);
		else return inl(args[0]);
		return 0;
	}
	if(strcmp(name, "clear") == 0) {
		if(argc != 0) acri_fail(runtime, "clear needs no arguments", pos);
		else clear();
		return 0;
	}
	if(strcmp(name, "nosound") == 0) {
		if(argc != 0) acri_fail(runtime, "nosound needs no arguments", pos);
		else nosound();
		return 0;
	}
	if(strcmp(name, "entropy") == 0) {
		if(argc != 0) acri_fail(runtime, "entropy needs no arguments", pos);
		else entropy();
		return 0;
	}
	if(strcmp(name, "save") == 0) {
		if(argc != 0) acri_fail(runtime, "save needs no arguments", pos);
		else return as_save_to_disk();
		return 0;
	}
	if(strcmp(name, "load") == 0) {
		if(argc != 0) acri_fail(runtime, "load needs no arguments", pos);
		else return as_load_from_disk();
		return 0;
	}
	*handled = 0;
	return 0;
}

INT acri_call(AcriRuntime *runtime, CC *name, INT *args, INT argc, INT call_pos)
{
	AcriFunc *fn;
	AcriFrame *frame;
	AcriVar *v;
	INT index;
	INT value;
	INT handled;
	INT old_returned;
	INT old_return_value;
	INT old_breaking;
	INT old_continuing;
	value = acri_builtin(runtime, name, args, argc, &handled, call_pos);
	if(handled || runtime->error)
		return value;
	fn = acri_find_func(runtime, name);
	if(!fn) {
		acri_fail(runtime, "unknown function", call_pos);
		return 0;
	}
	if(argc != fn->param_count) {
		acri_fail(runtime, "wrong argument count", call_pos);
		return 0;
	}
	if(runtime->frame_depth >= ACRI_MAX_CALLS) {
		acri_fail(runtime, "function call stack full", call_pos);
		return 0;
	}
	frame = &runtime->frames[runtime->frame_depth];
	for(index = 0; index < ACRI_MAX_LOCAL_VARS; index++)
		frame->vars[index].used = 0;
	runtime->frame_depth++;
	for(index = 0; index < argc; index++) {
		v = acri_make_var(runtime, acri_param_slot(fn, index), call_pos);
		if(v)
			v->value = args[index];
	}
	old_returned = runtime->returned;
	old_return_value = runtime->return_value;
	old_breaking = runtime->breaking;
	old_continuing = runtime->continuing;
	runtime->returned = 0;
	runtime->return_value = 0;
	runtime->breaking = 0;
	runtime->continuing = 0;
	acri_exec_range(runtime, fn->body_start, fn->body_end);
	value = runtime->return_value;
	runtime->returned = old_returned;
	runtime->return_value = old_return_value;
	runtime->breaking = old_breaking;
	runtime->continuing = old_continuing;
	runtime->frame_depth--;
	return value;
}

INT acri_find_top_semicolon(AcriRuntime *runtime, INT start, INT end)
{
	INT pos;
	INT paren;
	C quote;
	C character;
	pos = start;
	paren = 0;
	quote = 0;
	while(pos < end) {
		character = acri_ch(runtime, pos);
		if(quote) {
			if(character == '\\') pos++;
			else if(character == quote) quote = 0;
			pos++;
			continue;
		}
		if(character == '"' || character == '\'') {
			quote = character;
			pos++;
			continue;
		}
		if(character == '(') paren++;
		else if(character == ')') paren--;
		else if(character == ';' && paren == 0) return pos;
		pos++;
	}
	return end;
}

INT acri_statement_end(AcriRuntime *runtime, INT start, INT limit)
{
	INT pos;
	INT close;
	INT end1;
	pos = acri_skip(runtime, start, limit);
	if(pos >= limit)
		return limit;
	if(acri_ch(runtime, pos) == '{') {
		close = acri_find_match(runtime, pos, limit, '{', '}');
		if(close < 0)
			return limit;
		return close + 1;
	}
	if(acri_word_at(runtime, pos, limit, "if")) {
		pos = acri_skip(runtime, pos + 2, limit);
		if(acri_ch(runtime, pos) != '(') return acri_find_top_semicolon(runtime, pos, limit) + 1;
		close = acri_find_match(runtime, pos, limit, '(', ')');
		if(close < 0) return limit;
		end1 = acri_statement_end(runtime, close + 1, limit);
		pos = acri_skip(runtime, end1, limit);
		if(acri_word_at(runtime, pos, limit, "else"))
			return acri_statement_end(runtime, pos + 4, limit);
		return end1;
	}
	if(acri_word_at(runtime, pos, limit, "while")) {
		pos = acri_skip(runtime, pos + 5, limit);
		if(acri_ch(runtime, pos) != '(') return limit;
		close = acri_find_match(runtime, pos, limit, '(', ')');
		if(close < 0) return limit;
		return acri_statement_end(runtime, close + 1, limit);
	}
	if(acri_word_at(runtime, pos, limit, "for")) {
		pos = acri_skip(runtime, pos + 3, limit);
		if(acri_ch(runtime, pos) != '(') return limit;
		close = acri_find_match(runtime, pos, limit, '(', ')');
		if(close < 0) return limit;
		return acri_statement_end(runtime, close + 1, limit);
	}
	pos = acri_find_top_semicolon(runtime, pos, limit);
	if(pos < limit)
		return pos + 1;
	return limit;
}

INT acri_top_operator(AcriRuntime *runtime, INT start, INT end, INT *op_len, INT *op_kind)
{
	INT pos;
	INT paren;
	C quote;
	C character;
	paren = 0;
	quote = 0;
	for(pos = start; pos < end; pos++) {
		character = acri_ch(runtime, pos);
		if(quote) {
			if(character == '\\') pos++;
			else if(character == quote) quote = 0;
			continue;
		}
		if(character == '"' || character == '\'') {
			quote = character;
			continue;
		}
		if(character == '(') { paren++; continue; }
		if(character == ')') { paren--; continue; }
		if(paren != 0) continue;
		if((character == '+' || character == '-' || character == '*' || character == '/' || character == '%' ||
		    character == '&' || character == '|' || character == '^') && acri_ch(runtime, pos + 1) == '=')
		{
			*op_len = 2;
			*op_kind = character;
			return pos;
		}
		if(character == '=' && acri_ch(runtime, pos + 1) != '=') {
			*op_len = 1;
			*op_kind = '=';
			return pos;
		}
	}
	return -1;
}

VD acri_copy_statement(AcriRuntime *runtime, INT start, INT end, C *line)
{
	INT index;
	INT inner_index;
	start = acri_skip(runtime, start, end);
	while(end > start &&
	     (acri_ch(runtime, end - 1) == ' ' || acri_ch(runtime, end - 1) == '\t' ||
	      acri_ch(runtime, end - 1) == '\r' || acri_ch(runtime, end - 1) == '\n'))
		end--;
	inner_index = 0;
	for(index = start; index < end && inner_index < ACRI_LINE_MAX - 1; index++)
		line[inner_index++] = acri_ch(runtime, index);
	line[inner_index] = 0;
}

INT acri_shell_statement(CC *line)
{
	if(starts(line, "print(\"") || starts(line, "tune(\"") ||
	   starts(line, "run(\"") || starts(line, "ls(\"") ||
	   starts(line, "mkdir(\"") || starts(line, "touch(\"") ||
	   starts(line, "cat(\"") || starts(line, "cd(\"") ||
	   starts(line, "edit(\"") || starts(line, "rm(\"") ||
	   starts(line, "cp(\"") || starts(line, "mv(\"") ||
	   starts(line, "comment(\""))
		return 1;
	if(strcmp(line, "cls;") == 0 || strcmp(line, "help;") == 0 ||
	   strcmp(line, "__help;") == 0 || strcmp(line, "vmoff;") == 0 ||
	   strcmp(line, "halt;") == 0 || strcmp(line, "addr;") == 0 ||
	   strcmp(line, "memstat;") == 0 || strcmp(line, "ls;") == 0 ||
	   strcmp(line, "nosound;") == 0 || strcmp(line, "save;") == 0 ||
	   strcmp(line, "load;") == 0 || strcmp(line, "n;") == 0 ||
	   strcmp(line, "atadbg;") == 0 || strcmp(line, "saveity;") == 0 ||
	   strcmp(line, "saveitn;") == 0 || strcmp(line, "fault;") == 0 ||
	   strcmp(line, "reboot;") == 0 || strcmp(line, "cpdrive;") == 0 ||
	   strcmp(line, "mm;") == 0)
		return 1;
	return 0;
}

VD acri_apply_assignment(AcriRuntime *runtime, AcriVar *value_1, INT operator, INT value, INT pos)
{
	if(!value_1)
		return;
	if(operator == '=') value_1->value = value;
	else if(operator == '+') value_1->value += value;
	else if(operator == '-') value_1->value -= value;
	else if(operator == '*') value_1->value *= value;
	else if(operator == '/') {
		if(value == 0) acri_fail(runtime, "division by zero", pos);
		else value_1->value /= value;
	}
	else if(operator == '%') {
		if(value == 0) acri_fail(runtime, "division by zero", pos);
		else value_1->value %= value;
	}
	else if(operator == '&') value_1->value &= value;
	else if(operator == '|') value_1->value |= value;
	else if(operator == '^') value_1->value ^= value;
}

VD acri_exec_simple(AcriRuntime *runtime, INT start, INT end)
{
	INT pos;
	INT type_end;
	INT name_end;
	INT op_pos;
	INT op_len;
	INT op_kind;
	INT value;
	C name[ACRI_NAME_MAX];
	C line[ACRI_LINE_MAX];
	AcriVar *v;
	pos = acri_skip(runtime, start, end);
	while(end > pos &&
	     (acri_ch(runtime, end - 1) == ' ' || acri_ch(runtime, end - 1) == '\t' ||
	      acri_ch(runtime, end - 1) == '\r' || acri_ch(runtime, end - 1) == '\n' ||
	      acri_ch(runtime, end - 1) == ';'))
		end--;
	if(pos >= end)
		return;
	if(acri_parse_type(runtime, pos, end, &type_end)) {
		pos = type_end;
		for(;;) {
			name_end = acri_read_name(runtime, pos, end, name);
			if(name_end < 0) {
				acri_fail(runtime, "missing variable name", pos);
				return;
			}
			v = acri_make_var(runtime, name, pos);
			pos = acri_skip(runtime, name_end, end);
			if(acri_ch(runtime, pos) == '=') {
				pos++;
				op_pos = pos;
				while(op_pos < end && acri_ch(runtime, op_pos) != ',')
					op_pos++;
				value = acri_eval_slice(runtime, pos, op_pos);
				if(v) v->value = value;
				pos = op_pos;
			}
			if(acri_ch(runtime, pos) != ',')
				break;
			pos++;
		}
		return;
	}
	if(acri_ch(runtime, pos) == '+' && acri_ch(runtime, pos + 1) == '+') {
		name_end = acri_read_name(runtime, pos + 2, end, name);
		v = acri_find_var(runtime, name);
		if(!v) acri_fail(runtime, "unknown variable", pos);
		else v->value++;
		return;
	}
	if(acri_ch(runtime, pos) == '-' && acri_ch(runtime, pos + 1) == '-') {
		name_end = acri_read_name(runtime, pos + 2, end, name);
		v = acri_find_var(runtime, name);
		if(!v) acri_fail(runtime, "unknown variable", pos);
		else v->value--;
		return;
	}
	name_end = acri_read_name(runtime, pos, end, name);
	if(name_end >= 0) {
		name_end = acri_skip(runtime, name_end, end);
		if(name_end + 1 < end && acri_ch(runtime, name_end) == '+' && acri_ch(runtime, name_end + 1) == '+') {
			v = acri_find_var(runtime, name);
			if(!v) acri_fail(runtime, "unknown variable", pos);
			else v->value++;
			return;
		}
		if(name_end + 1 < end && acri_ch(runtime, name_end) == '-' && acri_ch(runtime, name_end + 1) == '-') {
			v = acri_find_var(runtime, name);
			if(!v) acri_fail(runtime, "unknown variable", pos);
			else v->value--;
			return;
		}
	}
	op_pos = acri_top_operator(runtime, pos, end, &op_len, &op_kind);
	if(op_pos >= 0) {
		name_end = acri_read_name(runtime, pos, op_pos, name);
		if(name_end < 0 || acri_skip(runtime, name_end, op_pos) != op_pos) {
			acri_fail(runtime, "assignment needs a variable", pos);
			return;
		}
		v = acri_find_var(runtime, name);
		if(!v) {
			acri_fail(runtime, "unknown variable", pos);
			return;
		}
		value = acri_eval_slice(runtime, op_pos + op_len, end);
		acri_apply_assignment(runtime, v, op_kind, value, op_pos);
		return;
	}
	acri_copy_statement(runtime, start, end, line);
	if(line[0] && line[strlen(line) - 1] != ';' && strlen(line) < ACRI_LINE_MAX - 1) {
		line[strlen(line) + 1] = 0;
		line[strlen(line)] = ';';
	}
	if(acri_shell_statement(line)) {
		if(wm_on &&
		   wm_task_exec_win >= 0 &&
		   wm_task_exec_win < WM_WINDOWS &&
		   wm_windows[wm_task_exec_win].alive &&
		   !starts(line, "run(\""))
		{
			wm_task_run_line(wm_task_exec_win, line);
			if(wm_windows[wm_task_exec_win].task_wake != 0 ||
			   wm_windows[wm_task_exec_win].tune_running)
				acri_wait_for_wm(wm_task_exec_win);
		}
		else
			shell_exec(line);
		return;
	}
	acri_eval_slice(runtime, pos, end);
}

VD acri_exec_if(AcriRuntime *runtime, INT *cursor, INT limit)
{
	INT pos;
	INT close;
	INT body_start;
	INT body_end;
	INT after;
	INT else_start;
	INT else_end;
	INT condition;
	pos = acri_skip(runtime, *cursor + 2, limit);
	if(acri_ch(runtime, pos) != '(') {
		acri_fail(runtime, "if needs (condition)", pos);
		return;
	}
	close = acri_find_match(runtime, pos, limit, '(', ')');
	if(close < 0) {
		acri_fail(runtime, "unclosed if condition", pos);
		return;
	}
	condition = acri_eval_slice(runtime, pos + 1, close);
	body_start = acri_skip(runtime, close + 1, limit);
	body_end = acri_statement_end(runtime, body_start, limit);
	after = acri_skip(runtime, body_end, limit);
	else_start = -1;
	else_end = after;
	if(acri_word_at(runtime, after, limit, "else")) {
		else_start = acri_skip(runtime, after + 4, limit);
		else_end = acri_statement_end(runtime, else_start, limit);
	}
	if(condition)
		acri_exec_range(runtime, body_start, body_end);
	else if(else_start >= 0)
		acri_exec_range(runtime, else_start, else_end);
	if(else_start >= 0)
		*cursor = else_end;
	else
		*cursor = body_end;
}

VD acri_exec_while(AcriRuntime *runtime, INT *cursor, INT limit)
{
	INT pos;
	INT close;
	INT body_start;
	INT body_end;
	INT loops;
	pos = acri_skip(runtime, *cursor + 5, limit);
	if(acri_ch(runtime, pos) != '(') {
		acri_fail(runtime, "while needs (condition)", pos);
		return;
	}
	close = acri_find_match(runtime, pos, limit, '(', ')');
	if(close < 0) {
		acri_fail(runtime, "unclosed while condition", pos);
		return;
	}
	body_start = acri_skip(runtime, close + 1, limit);
	body_end = acri_statement_end(runtime, body_start, limit);
	loops = 0;
	while(!runtime->error && !runtime->returned && acri_eval_slice(runtime, pos + 1, close)) {
		acri_exec_range(runtime, body_start, body_end);
		if(runtime->breaking) {
			runtime->breaking = 0;
			break;
		}
		if(runtime->continuing)
			runtime->continuing = 0;
		loops++;
		if(loops >= ACRI_LOOP_LIMIT) {
			acri_fail(runtime, "loop limit reached", pos);
			break;
		}
	}
	*cursor = body_end;
}

VD acri_for_parts(AcriRuntime *runtime, INT start, INT end,
	INT *semi1, INT *semi2)
{
	INT pos;
	INT paren;
	C quote;
	C character;
	*semi1 = -1;
	*semi2 = -1;
	paren = 0;
	quote = 0;
	for(pos = start; pos < end; pos++) {
		character = acri_ch(runtime, pos);
		if(quote) {
			if(character == '\\') pos++;
			else if(character == quote) quote = 0;
			continue;
		}
		if(character == '"' || character == '\'') { quote = character; continue; }
		if(character == '(') { paren++; continue; }
		if(character == ')') { paren--; continue; }
		if(character == ';' && paren == 0) {
			if(*semi1 < 0) *semi1 = pos;
			else { *semi2 = pos; return; }
		}
	}
}

VD acri_exec_for(AcriRuntime *runtime, INT *cursor, INT limit)
{
	INT pos;
	INT close;
	INT semi1;
	INT semi2;
	INT body_start;
	INT body_end;
	INT loops;
	INT condition;
	pos = acri_skip(runtime, *cursor + 3, limit);
	if(acri_ch(runtime, pos) != '(') {
		acri_fail(runtime, "for needs (...) ", pos);
		return;
	}
	close = acri_find_match(runtime, pos, limit, '(', ')');
	if(close < 0) {
		acri_fail(runtime, "unclosed for header", pos);
		return;
	}
	acri_for_parts(runtime, pos + 1, close, &semi1, &semi2);
	if(semi1 < 0 || semi2 < 0) {
		acri_fail(runtime, "for needs init; condition; step", pos);
		return;
	}
	body_start = acri_skip(runtime, close + 1, limit);
	body_end = acri_statement_end(runtime, body_start, limit);
	acri_exec_simple(runtime, pos + 1, semi1);
	loops = 0;
	while(!runtime->error && !runtime->returned) {
		condition = 1;
		if(acri_skip(runtime, semi1 + 1, semi2) < semi2)
			condition = acri_eval_slice(runtime, semi1 + 1, semi2);
		if(!condition)
			break;
		acri_exec_range(runtime, body_start, body_end);
		if(runtime->breaking) {
			runtime->breaking = 0;
			break;
		}
		if(runtime->continuing)
			runtime->continuing = 0;
		acri_exec_simple(runtime, semi2 + 1, close);
		loops++;
		if(loops >= ACRI_LOOP_LIMIT) {
			acri_fail(runtime, "loop limit reached", pos);
			break;
		}
	}
	*cursor = body_end;
}

VD acri_exec_range(AcriRuntime *runtime, INT start, INT end)
{
	INT pos;
	INT stmt_end;
	INT semicolon;
	INT parameter_start;
	INT parameter_end;
	INT body_start;
	INT body_end;
	INT next;
	C name[ACRI_NAME_MAX];
	pos = acri_skip(runtime, start, end);
	if(acri_ch(runtime, pos) == '{') {
		next = acri_find_match(runtime, pos, end, '{', '}');
		if(next < 0) {
			acri_fail(runtime, "unclosed block", pos);
			return;
		}
		pos++;
		end = next;
	}
	while(pos < end && !runtime->error && !runtime->returned &&
	      !runtime->breaking && !runtime->continuing)
	{
		pos = acri_skip(runtime, pos, end);
		if(pos >= end || acri_ch(runtime, pos) == '}')
			break;
		if(acri_detect_function(runtime, pos, end, name, &parameter_start, &parameter_end, &body_start, &body_end, &next)) {
			pos = next;
			continue;
		}
		if(acri_word_at(runtime, pos, end, "if")) {
			acri_exec_if(runtime, &pos, end);
			continue;
		}
		if(acri_word_at(runtime, pos, end, "while")) {
			acri_exec_while(runtime, &pos, end);
			continue;
		}
		if(acri_word_at(runtime, pos, end, "for")) {
			acri_exec_for(runtime, &pos, end);
			continue;
		}
		if(acri_word_at(runtime, pos, end, "return")) {
			semicolon = acri_find_top_semicolon(runtime, pos + 6, end);
			if(acri_skip(runtime, pos + 6, semicolon) < semicolon)
				runtime->return_value = acri_eval_slice(runtime, pos + 6, semicolon);
			else
				runtime->return_value = 0;
			runtime->returned = 1;
			if(semicolon < end)
				pos = semicolon + 1;
			else
				pos = end;
			continue;
		}
		if(acri_word_at(runtime, pos, end, "break")) {
			runtime->breaking = 1;
			pos = acri_statement_end(runtime, pos, end);
			continue;
		}
		if(acri_word_at(runtime, pos, end, "continue")) {
			runtime->continuing = 1;
			pos = acri_statement_end(runtime, pos, end);
			continue;
		}
		if(acri_ch(runtime, pos) == '{') {
			stmt_end = acri_statement_end(runtime, pos, end);
			acri_exec_range(runtime, pos, stmt_end);
			pos = stmt_end;
			continue;
		}
		stmt_end = acri_statement_end(runtime, pos, end);
		acri_exec_simple(runtime, pos, stmt_end);
		runtime->top_statements++;
		pos = stmt_end;
	}
}

VD acri_reset(AcriRuntime *runtime, C *data, INT size)
{
	INT index;
	INT inner_index;
	runtime->data = data;
	runtime->size = size;
	runtime->func_count = 0;
	runtime->frame_depth = 0;
	runtime->returned = 0;
	runtime->return_value = 0;
	runtime->breaking = 0;
	runtime->continuing = 0;
	runtime->error = 0;
	runtime->error_pos = 0;
	runtime->error_text = 0;
	runtime->top_statements = 0;
	for(index = 0; index < ACRI_MAX_VARS; index++)
		runtime->globals[index].used = 0;
	for(index = 0; index < ACRI_MAX_FUNCS; index++)
		runtime->funcs[index].used = 0;
	for(index = 0; index < ACRI_MAX_CALLS; index++)
		for(inner_index = 0; inner_index < ACRI_MAX_LOCAL_VARS; inner_index++)
			runtime->frames[index].vars[inner_index].used = 0;
}

VD acri_report(AcriRuntime *runtime)
{
	if(!runtime->error)
		return;
	print_red("Script error: ");
	if(runtime->error_text)
		print_red(runtime->error_text);
	print_red(" at byte ");
	printINT(runtime->error_pos);
	print_red("\n");
}

VD acri_run_data(C *data, INT size)
{
	AcriRuntime *rt;
	AcriFunc *main_fn;
	INT args[1];
	if(acri_runtime_depth >= ACRI_MAX_RUNTIMES) {
		print_red("Script runtime stack full\n");
		return;
	}
	rt = &acri_runtimes[acri_runtime_depth++];
	acri_reset(rt, data, size);
	acri_collect_functions(rt);
	if(!rt->error)
		acri_exec_range(rt, 0, size);
	main_fn = acri_find_func(rt, "main");
	if(!rt->error && main_fn)
		acri_call(rt, "main", args, 0, 0);
	acri_report(rt);
	acri_runtime_depth--;
}

VD run_script(CC *path)
{
	C *data;
	INT size;
	if(as_get_file_data(path, &data, &size) != 0) {
		print_red("File not found\n");
		return;
	}
	acri_run_data(data, size);
}

