VD vga_stosl(VD *dst, u32 val, U INT count)
{//fast VGA fill using 32-bit stores
	u32 *value;
	value = (u32*)dst;
	while(count--)
		*value++ = val;
}

VD vga_movsl(VD *dst, const VD *src, U INT count)
{//fast VGA copy using 32-bit loads and stores
	u32 *value;
	const u32 *source_value;
	value = (u32*)dst;
	source_value = (const u32*)src;
	while(count--)
		*value++ = *source_value++;
}

VD fast_memset8(VD *dst, u8 val, U INT bytes)
{
	u32 fill;
	u8 *tail;
	U INT rem;
	fill = (u32)val;
	fill = fill + fill * 256;
	fill = fill + fill * 65536;
	vga_stosl(dst, fill, bytes / 4);
	tail = (u8*)dst + (bytes & ~3U);
	rem = bytes & 3U;
	while(rem--)
		*tail++ = val;
}

VD fast_memcpy8(VD *dst, const VD *src, U INT bytes)
{
	u8 *value;
	const u8 *source_value;
	U INT rem;
	vga_movsl(dst, src, bytes / 4);
	value = (u8*)dst + (bytes & ~3U);
	source_value = (const u8*)src + (bytes & ~3U);
	rem = bytes & 3U;
	while(rem--)
		*value++ = *source_value++;
}

U INT gfx_off(U INT off)
{
	return off & 0xFFFF;
}

VD gfx_set_start(U INT off)
{
	vga_start = off & 0xFFFF;
	outb(0x3D4, 0x0C);
	outb(0x3D5, (u8)(vga_start >> 8));
	outb(0x3D4, 0x0D);
	outb(0x3D5, (u8)vga_start);
}

VD gfx_ready(VD)
{
	outb(0x3C4, 0x02);
	outb(0x3C5, 0x0F);
	outb(0x3C4, 0x04);
	outb(0x3C5, 0x06);
	outb(0x3CE, 0x00);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x01);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x03);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x05);
	outb(0x3CF, 0x02);
	outb(0x3CE, 0x06);
	outb(0x3CF, 0x05);
	outb(0x3CE, 0x07);
	outb(0x3CF, 0x0F);
	outb(0x3CE, 0x08);
	outb(0x3CF, 0xFF);
}

VD gfx_write_masked(U INT off, u8 mask, u8 col)
{
	u8 junk;
	if(mask == 0)
		return;
	outb(0x3CE, 0x08);
	outb(0x3CF, mask);
	junk = GFX[off];
	(VD)junk;
	GFX[off] = col & 0x0F;
}

VD gfx_direct_plane(U INT plane)
{
	outb(0x3C4, 0x02);
	outb(0x3C5, 1 << plane);
	outb(0x3C4, 0x04);
	outb(0x3C5, 0x06);
	outb(0x3CE, 0x00);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x01);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x03);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x04);
	outb(0x3CF, plane);
	outb(0x3CE, 0x05);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x06);
	outb(0x3CF, 0x05);
	outb(0x3CE, 0x08);
	outb(0x3CF, 0xFF);
}

VD gfx_mode2(VD)
{
	outb(0x3C4, 0x02);
	outb(0x3C5, 0x0F);
	outb(0x3C4, 0x04);
	outb(0x3C5, 0x06);
	outb(0x3CE, 0x00);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x01);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x03);
	outb(0x3CF, 0x00);
	outb(0x3CE, 0x05);
	outb(0x3CF, 0x02);
	outb(0x3CE, 0x06);
	outb(0x3CF, 0x05);
	outb(0x3CE, 0x07);
	outb(0x3CF, 0x0F);
	outb(0x3CE, 0x08);
	outb(0x3CF, 0xFF);
}

VD gfx_fill_linear(U INT off, U INT bytes, u8 col)
{
	u32 val;
	u8 *tail;
	U INT rem;
	if(bytes == 0)
		return;
	off &= 0xFFFF;
	gfx_mode2();
	val = (u32)(col & 0x0F);
	val = val + val * 256;
	val = val + val * 65536;
	vga_stosl((VD*)(GFX + off), val, bytes / 4);
	tail = GFX + off + (bytes & ~3U);
	rem = bytes & 3U;
	while(rem--)
		*tail++ = col & 0x0F;
}

VD gfx_fill_span(U INT off, U INT bytes, u8 col)
{
	U INT first;
	off &= 0xFFFF;
	while(bytes) {
		first = 0x10000 - off;
		if(first > bytes)
			first = bytes;
		gfx_fill_linear(off, first, col);
		bytes -= first;
		off = 0;
	}
}

VD gfx_fill(u8 col)
{
	gfx_set_start(0);
	gfx_fill_span(0, 80 * 480, col);
}

VD gfx_clear_text_row(INT row, u8 col)
{
	U INT line;
	if(row < 0 || row >= H)
		return;
	for(line = 0; line < 8; line++)
		gfx_fill_span(vga_start + row * 8 * 80 + line * 80, 80, col);
}

VD gfx_clear_text_rect(INT x_coordinate, INT y_coordinate, INT width, INT height, u8 col)
{
	INT pixel_y;
	INT lines;
	u32 val;
	u8 *tail;
	U INT off;
	U INT rem;
	if(width <= 0 || height <= 0)
		return;
	if(x_coordinate < 0 || y_coordinate < 0 || x_coordinate + width > W || y_coordinate + height > H)
		return;
	gfx_mode2();
	val = (u32)(col & 0x0F);
	val = val + val * 256;
	val = val + val * 65536;
	lines = height * 8;
	for(pixel_y = 0; pixel_y < lines; pixel_y++) {
		off = gfx_off(vga_start + ((y_coordinate * 8 + pixel_y) * 80) + x_coordinate);
		if(off + (U INT)width > 0x10000) {
			gfx_fill_span(vga_start + ((y_coordinate * 8 + pixel_y) * 80) + x_coordinate, width, col);
			gfx_mode2();
			continue;
		}
		vga_stosl((VD*)(GFX + off), val, ((U INT)width) / 4);
		tail = GFX + off + (((U INT)width) & ~3U);
		rem = ((U INT)width) & 3U;
		while(rem--)
			*tail++ = col & 0x0F;
	}
}

VD gfx_scroll_text_rect_up_8(INT x_coordinate, INT y_coordinate, INT width, INT height, u8 col)
{
	INT plane;
	INT pixel_y;
	INT lines;
	U INT dst;
	U INT src;
	if(width <= 0 || height <= 1)
		return;
	if(x_coordinate < 0 || y_coordinate < 0 || x_coordinate + width > W || y_coordinate + height > H)
		return;
	lines = (height - 1) * 8;
	for(plane = 0; plane < 4; plane++) {
		gfx_direct_plane(plane);
		for(pixel_y = 0; pixel_y < lines; pixel_y++) {
			dst = gfx_off(vga_start + ((y_coordinate * 8 + pixel_y) * 80) + x_coordinate);
			src = gfx_off(dst + 8 * 80);
			fast_memcpy8((VD*)(GFX + dst), (const VD*)(GFX + src), width);
		}
	}
	gfx_clear_text_rect(x_coordinate, y_coordinate + height - 1, width, 1, col);
	gfx_ready();
}

VD gfx_scroll_wm_text_rect_up_8(INT x_coordinate, INT y_coordinate, INT width, INT height, u8 col)
{
	INT plane;
	INT pixel_y;
	INT lines;
	U INT dst;
	U INT src;
	if(width != 40 || (x_coordinate & 3)) {
		gfx_scroll_text_rect_up_8(x_coordinate, y_coordinate, width, height, col);
		return;
	}
	if(height <= 1)
		return;
	if(x_coordinate < 0 || y_coordinate < 0 || x_coordinate + width > W || y_coordinate + height > H)
		return;
	lines = (height - 1) * 8;
	for(plane = 0; plane < 4; plane++) {
		gfx_direct_plane(plane);
		for(pixel_y = 0; pixel_y < lines; pixel_y++) {
			dst = gfx_off(vga_start + ((y_coordinate * 8 + pixel_y) * 80) + x_coordinate);
			src = gfx_off(vga_start + (((y_coordinate + 1) * 8 + pixel_y) * 80) + x_coordinate);
			fast_memcpy8((VD*)(GFX + dst), (const VD*)(GFX + src), 40);
		}
	}
	gfx_clear_text_rect(x_coordinate + 1, y_coordinate + height - 1, width - 2, 1, col);
	gfx_ready();
}

VD gfx_scroll_up_8(u8 col)
{
	U INT next;
	next = vga_start + 8 * 80;
	if(next + 80 * 480 > 0x10000) {
		gfx_set_start(0);
		screen_redraw();
		return;
	}
	gfx_set_start(next);
	gfx_clear_text_row(H - 1, col);
}

VD cursor_hide(VD)
{
	INT old;
	if(cursor_drawn && cursor_x < W && cursor_y < H) {
		old = cursor_y * W + cursor_x;
		cursor_drawn = 0;
		screen_draw_cell(cursor_x, cursor_y, screen_Cs[old], screen_attrs[old], 0);
	}
	else
		cursor_drawn = 0;
}

VD screen_draw_cell(INT x_coordinate, INT y_coordinate, C character, u8 col, INT cursor)
{
	INT row;
	u8 foreground_color;
	u8 background_color;
	u8 bits;
	u8 *font;
	U INT off;
	if(x_coordinate < 0 || x_coordinate >= W || y_coordinate < 0 || y_coordinate >= H)
		return;
	foreground_color = col & 0x0F;
	background_color = (col >> 4) & 0x0F;
	if(cursor) {
		u8 temporary_value = foreground_color;
		foreground_color = background_color;
		background_color = temporary_value;
	}
	font = FONT8X8 + ((u8)character * 8);
	gfx_ready();
	for(row = 0; row < 8; row++) {
		if(character == ' ')
			bits = 0;
		else
			bits = font[row];
		off = gfx_off(vga_start + ((y_coordinate * 8 + row) * 80) + x_coordinate);
		gfx_write_masked(off, 0xFF, background_color);
		gfx_write_masked(off, bits, foreground_color);
	}
}

VD screen_put_at(INT x_coordinate, INT y_coordinate, C character, u8 col)
{
	INT index;
	INT redraw_mouse;
	if(wm_on && !wm_redrawing && console_mode == CON_WINDOW) {
		/* Store INTo the window buffer before clipping to the
		   physical screen. This keeps offscreen/half-offscreen
		   windows from losing output while they are outside view. */
		wm_store_cell(x_coordinate, y_coordinate, character, col);
		if(x_coordinate < 0 || x_coordinate >= W || y_coordinate < 0 || y_coordinate >= H)
			return;
		if(!wm_cell_visible_for(wm_active, x_coordinate, y_coordinate))
			return;
	}
	else if(x_coordinate < 0 || x_coordinate >= W || y_coordinate < 0 || y_coordinate >= H)
		return;
	redraw_mouse = mouse_cell_hit(x_coordinate, y_coordinate);
	if(redraw_mouse)
		mouse_hide();
	index = y_coordinate * W + x_coordinate;
	screen_Cs[index] = character;
	screen_attrs[index] = col;
	screen_draw_cell(x_coordinate, y_coordinate, character, col, cursor_drawn && cursor_x == (U INT)x_coordinate && cursor_y == (U INT)y_coordinate);
	if(redraw_mouse)
		mouse_show();
}

VD screen_set_cell(INT index, C character, u8 col)
{
	if(index < 0 || index >= W * H)
		return;
	screen_put_at(index % W, index / W, character, col);
}

VD screen_get_cell(INT index, C *character, u8 *col)
{
	if(index < 0 || index >= W * H) {
		*character = ' ';
		*col = color;
		return;
	}
	*character = screen_Cs[index];
	*col = screen_attrs[index];
}

INT con_abs_x(VD)
{
	if(console_mode == CON_WINDOW)
		return con_x + cx;
	return cx;
}

INT con_abs_y(VD)
{
	if(console_mode == CON_WINDOW)
		return con_y + cy;
	return cy;
}

VD con_set_full(VD)
{
	console_mode = CON_FULL;
	con_x = 0;
	con_y = 0;
	con_w = W;
	con_h = H;
}

VD con_set_window(INT x_coordinate, INT y_coordinate, INT width, INT height)
{
	console_mode = CON_WINDOW;
	con_x = x_coordinate;
	con_y = y_coordinate;
	con_w = width;
	con_h = height;
}

VD con_save(WMWindow *win)
{
	win->cx = cx;
	win->cy = cy;
	win->cwd = as_cwd;
}

VD con_load(WMWindow *win)
{
	con_set_window(win->x, win->y, win->w, win->h);
	cx = win->cx;
	cy = win->cy;
	as_cwd = win->cwd;
}

INT wm_index_of(WMWindow *win)
{
	INT index;
	for(index = 0; index < WM_WINDOWS; index++)
		if(win == &wm_windows[index])
			return index;
	return -1;
}

VD wm_init_buffers(VD)
{
	INT window_id;
	INT index;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++) {
		for(index = 0; index < WM_CONTENT_W * WM_CONTENT_H; index++) {
			wm_buf_Cs[window_id * WM_BUFFER_SIZE + index] = ' ';
			wm_buf_attrs[window_id * WM_BUFFER_SIZE + index] = 0x1F;
		}
	}
}

INT wm_alive_count(VD)
{
	INT window_id;
	INT count;
	count = 0;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++)
		if(wm_windows[window_id].alive)
			count++;
	return count;
}

INT wm_next_alive_from(INT from)
{
	INT index;
	INT window_id;
	for(index = 1; index <= WM_WINDOWS; index++) {
		window_id = (from + index) % WM_WINDOWS;
		if(wm_windows[window_id].alive)
			return window_id;
	}
	return -1;
}

INT wm_active_ok(VD)
{
	return wm_active >= 0 && wm_active < WM_WINDOWS && wm_windows[wm_active].alive;
}

VD wm_z_remove(INT window_id)
{
	INT index;
	INT inner_index;
	for(index = 0; index < wm_z_count; index++) {
		if(wm_z_order[index] == window_id) {
			for(inner_index = index; inner_index < wm_z_count - 1; inner_index++)
				wm_z_order[inner_index] = wm_z_order[inner_index + 1];
			wm_z_count--;
			return;
		}
	}
}

VD wm_z_add_top(INT window_id)
{
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	wm_z_remove(window_id);
	if(wm_z_count < WM_WINDOWS)
		wm_z_order[wm_z_count++] = window_id;
}

VD wm_bring_front(INT window_id)
{
	wm_z_add_top(window_id);
}

VD wm_apply_geometry(INT window_id, INT base_x, INT base_y, INT base_width, INT base_height)
{
	WMWindow *win;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	win = &wm_windows[window_id];
	if(base_width < 4)
		base_width = 4;
	if(base_height < 4)
		base_height = 4;
	if(base_width > W)
		base_width = W;
	if(base_height > H - 1)
		base_height = H - 1;
	/* Position is INTentionally NOT clamped.
	   Windows may be dragged/spawned past the screen borders;
	   the drawing code clips whatever is actually visible. */
	win->bx = base_x;
	win->by = base_y;
	win->bw = base_width;
	win->bh = base_height;
	win->x = base_x + 1;
	win->y = base_y + 1;
	win->w = base_width - 2;
	win->h = base_height - 2;
	if(win->w > WM_CONTENT_W)
		win->w = WM_CONTENT_W;
	if(win->h > WM_CONTENT_H)
		win->h = WM_CONTENT_H;
	if(win->cx >= (U INT)win->w)
		win->cx = 0;
	if(win->cy >= (U INT)win->h)
		if(win->h)
			win->cy = win->h - 1;
		else
			win->cy = 0;
}

VD wm_blank_window_buffer(INT window_id)
{
	INT index;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	for(index = 0; index < WM_CONTENT_W * WM_CONTENT_H; index++) {
		wm_buf_Cs[window_id * WM_BUFFER_SIZE + index] = ' ';
		wm_buf_attrs[window_id * WM_BUFFER_SIZE + index] = 0x1F;
	}
}

VD wm_init_new_window(INT window_id, INT base_x, INT base_y, INT base_width, INT base_height)
{
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	wm_windows[window_id].alive = 1;
	wm_windows[window_id].fullscreen = 0;
	wm_windows[window_id].carded = 0;
	wm_windows[window_id].card_old_bx = base_x;
	wm_windows[window_id].card_old_by = base_y;
	wm_windows[window_id].card_old_bw = base_width;
	wm_windows[window_id].card_old_bh = base_height;
	wm_windows[window_id].cx = 0;
	wm_windows[window_id].cy = 0;
	wm_windows[window_id].cwd = as_cwd;
	wm_windows[window_id].old_bx = base_x;
	wm_windows[window_id].old_by = base_y;
	wm_windows[window_id].old_bw = base_width;
	wm_windows[window_id].old_bh = base_height;
	wm_windows[window_id].input_len = 0;
	wm_windows[window_id].input_x = 0;
	wm_windows[window_id].input_y = 0;
	wm_windows[window_id].input[0] = 0;
	wm_windows[window_id].task_cmd[0] = 0;
	wm_windows[window_id].task_pending = 0;
	wm_windows[window_id].task_data = 0;
	wm_windows[window_id].task_size = 0;
	wm_windows[window_id].task_pos = 0;
	wm_windows[window_id].task_running = 0;
	wm_windows[window_id].task_sp = 0;
	wm_windows[window_id].task_wake = 0;
	wm_windows[window_id].tune_song[0] = 0;
	wm_windows[window_id].tune_pos = 0;
	wm_windows[window_id].tune_tempo = 120;
	wm_windows[window_id].tune_running = 0;
	wm_windows[window_id].tune_until = 0;
	wm_windows[window_id].tune_sounding = 0;
	wm_blank_window_buffer(window_id);
	wm_apply_geometry(window_id, base_x, base_y, base_width, base_height);
	wm_set_title(window_id, "Shell");
}

INT wm_create_window(INT kind)
{
	INT window_id;
	INT base_x;
	INT base_y;
	INT base_width;
	INT base_height;
	INT old;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++)
		if(!wm_windows[window_id].alive)
			break;
	if(window_id >= WM_WINDOWS)
		return -1;
	if(kind == WM_ADD_CARD) {
		base_width = WM_CARD_W;
		base_height = WM_CARD_H;
		base_x = wm_next_card_x;
		base_y = wm_next_card_y;
		/* Start cards at the top-left edge, then keep cascading
		   down/right forever. No wrap and no border clamp. */
		wm_next_card_x += 4;
		wm_next_card_y += 3;
	}
	else {
		base_width = WM_SIDE_W;
		base_height = WM_SIDE_H;
		if(wm_next_side)
			base_x = W - WM_SIDE_W;
		else
			base_x = 0;
		base_y = 1;
		wm_next_side = !wm_next_side;
	}
	old = wm_active;
	if(old >= 0 && old < WM_WINDOWS && wm_windows[old].alive)
		con_save(&wm_windows[old]);
	wm_init_new_window(window_id, base_x, base_y, base_width, base_height);
	wm_active = window_id;
	wm_bring_front(window_id);
	con_load(&wm_windows[window_id]);
	wm_redraw_region(base_x, base_y, base_x + base_width - 1, base_y + base_height - 1);
	wm_start_shell_window(window_id);
	wm_redraw_region(base_x, base_y, base_x + base_width - 1, base_y + base_height - 1);
	return window_id;
}

VD wm_close_window(INT window_id)
{
	INT next;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	if(window_id == wm_selected_win)
		wm_clear_highlight();
	if(wm_windows[window_id].tune_sounding)
		nosound();
	as_edit_win_close(window_id);
	wm_windows[window_id].alive = 0;
	if(window_id == wm_help_win)
		wm_help_win = -1;
	wm_windows[window_id].fullscreen = 0;
	wm_windows[window_id].carded = 0;
	wm_windows[window_id].task_running = 0;
	wm_windows[window_id].task_pending = 0;
	wm_windows[window_id].task_sp = 0;
	wm_windows[window_id].task_wake = 0;
	wm_windows[window_id].tune_running = 0;
	wm_windows[window_id].tune_until = 0;
	wm_windows[window_id].tune_sounding = 0;
	wm_z_remove(window_id);
	wm_drag_win = -1;
	wm_mouse_select_win = -1;
	if(wm_active == window_id) {
		if(wm_z_count > 0)
			next = wm_z_order[wm_z_count - 1];
		else
			next = -1;
		wm_active = next;
	}
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
	else
		con_set_full();
	wm_redraw_region(wm_windows[window_id].bx, wm_windows[window_id].by, wm_windows[window_id].bx + wm_windows[window_id].bw - 1, wm_windows[window_id].by + wm_windows[window_id].bh - 1);
}

VD wm_toggle_fullscreen(INT window_id)
{
	WMWindow *win;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	con_save(&wm_windows[window_id]);
	win = &wm_windows[window_id];
	if(!win->fullscreen) {
		win->carded = 0;
		win->old_bx = win->bx;
		win->old_by = win->by;
		win->old_bw = win->bw;
		win->old_bh = win->bh;
		win->fullscreen = 1;
		wm_apply_geometry(window_id, 0, 1, 80, 59);
	}
	else {
		win->fullscreen = 0;
		wm_apply_geometry(window_id, win->old_bx, win->old_by, win->old_bw, win->old_bh);
	}
	con_load(&wm_windows[window_id]);
	wm_redraw_all();
}

VD wm_toggle_card(INT window_id)
{
	WMWindow *win;
	INT base_x;
	INT base_y;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	con_save(&wm_windows[window_id]);
	win = &wm_windows[window_id];
	if(win->fullscreen) {
		win->fullscreen = 0;
		wm_apply_geometry(window_id, win->old_bx, win->old_by, win->old_bw, win->old_bh);
	}
	if(!win->carded) {
		win->card_old_bx = win->bx;
		win->card_old_by = win->by;
		win->card_old_bw = win->bw;
		win->card_old_bh = win->bh;
		win->carded = 1;
		base_x = win->bx;
		base_y = win->by;
		if(base_x + WM_CARD_W > W)
			base_x = W - WM_CARD_W;
		if(base_y + WM_CARD_H > H)
			base_y = H - WM_CARD_H;
		wm_apply_geometry(window_id, base_x, base_y, WM_CARD_W, WM_CARD_H);
	}
	else {
		win->carded = 0;
		wm_apply_geometry(window_id, win->card_old_bx, win->card_old_by, win->card_old_bw, win->card_old_bh);
	}
	wm_bring_front(window_id);
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	wm_redraw_all();
}

VD wm_draw_top_controls(VD)
{
	if(!wm_on)
		return;
	screen_put_at(WM_PLUS_X - 1, 0, '[', 0xF1);
	screen_put_at(WM_PLUS_X, 0, '+', 0xF1);
	screen_put_at(WM_PLUS_X + 1, 0, ']', 0xF1);
}

VD wm_draw_add_menu(VD)
{
	INT x_coordinate;
	INT y_coordinate;
	u8 col;
	col = 0x1F;
	for(x_coordinate = 0; x_coordinate < WM_MENU_W; x_coordinate++) {
		screen_put_at(WM_MENU_X + x_coordinate, WM_MENU_Y, (C)196, col);
		screen_put_at(WM_MENU_X + x_coordinate, WM_MENU_Y + WM_MENU_H - 1, (C)196, col);
	}
	for(y_coordinate = 0; y_coordinate < WM_MENU_H; y_coordinate++) {
		screen_put_at(WM_MENU_X, WM_MENU_Y + y_coordinate, (C)179, col);
		screen_put_at(WM_MENU_X + WM_MENU_W - 1, WM_MENU_Y + y_coordinate, (C)179, col);
	}
	screen_put_at(WM_MENU_X, WM_MENU_Y, (C)218, col);
	screen_put_at(WM_MENU_X + WM_MENU_W - 1, WM_MENU_Y, (C)191, col);
	screen_put_at(WM_MENU_X, WM_MENU_Y + WM_MENU_H - 1, (C)192, col);
	screen_put_at(WM_MENU_X + WM_MENU_W - 1, WM_MENU_Y + WM_MENU_H - 1, (C)217, col);
	screen_write_at(WM_MENU_X + 2, WM_MENU_Y + 1, "+ Add window", col);
	screen_write_at(WM_MENU_X + 2, WM_MENU_Y + 2, "Card window", 0x1F);
	screen_write_at(WM_MENU_X + 2, WM_MENU_Y + 3, "Side window", 0x1F);
}

VD wm_hide_add_menu(VD)
{
	if(!wm_add_menu)
		return;
	wm_add_menu = 0;
	wm_redraw_region(WM_MENU_X, WM_MENU_Y, WM_MENU_X + WM_MENU_W - 1, WM_MENU_Y + WM_MENU_H - 1);
	wm_draw_top_controls();
}

INT wm_handle_add_menu_click(INT target_x, INT target_y)
{
	if(!wm_add_menu)
		return 0;
	if(target_x >= WM_MENU_X && target_x < WM_MENU_X + WM_MENU_W &&
	   target_y >= WM_MENU_Y && target_y < WM_MENU_Y + WM_MENU_H)
	{
		if(target_y == WM_MENU_Y + 2) {
			wm_hide_add_menu();
			wm_create_window(WM_ADD_CARD);
			return 1;
		}
		if(target_y == WM_MENU_Y + 3) {
			wm_hide_add_menu();
			wm_create_window(WM_ADD_SIDE);
			return 1;
		}
		return 1;
	}
	wm_hide_add_menu();
	return 0;
}

VD wm_prepare_selected_run_line(CC *cmd)
{
	INT x_value;
	INT oldcolor;
	if(!cmd || !cmd[0])
		return;
	cursor_hide();
	oldcolor = color;
	color = 0x1A;
	cy = con_h - 1;
	cx = 0;
	for(x_value = 0; x_value < con_w; x_value++)
		screen_put_at(con_x + x_value, con_y + cy, ' ', color);
	cx = 0;
	print(cmd);
	putc('\n');
	color = oldcolor;
}

VD wm_sync_input_from_screen(INT window_id)
{
	WMWindow *win;
	INT pos;
	INT len;
	C character;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	win->input_len = 0;
	win->input[0] = 0;
	if(win->input_y < 0 || win->input_y >= win->h)
		return;
	if(win->input_x < 0)
		win->input_x = 0;
	if(win->input_x >= win->w)
		return;
	len = 0;
	for(pos = win->input_x; pos < win->w && len < WM_INPUT_MAX - 1; pos++) {
		character = wm_buf_Cs[window_id * WM_BUFFER_SIZE + win->input_y * WM_CONTENT_W + pos];
		win->input[len++] = character;
	}
	while(len > 0 && win->input[len - 1] == ' ')
		len--;
	win->input[len] = 0;
	win->input_len = len;
}

INT wm_cursor_on_prompt_line(INT window_id)
{
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return 0;
	return cy == (U INT)wm_windows[window_id].input_y && cx >= (U INT)wm_windows[window_id].input_x;
}

VD wm_insert_C_here(INT window_id, C character)
{
	WMWindow *win;
	INT row;
	INT col;
	INT x_value;
	INT index;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	row = cy;
	col = cx;
	if(row < 0 || row >= win->h || col < 0 || col >= win->w)
		return;
	cursor_hide();
	for(x_value = win->w - 1; x_value > col; x_value--) {
		wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value - 1];
		wm_buf_attrs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value] = wm_buf_attrs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value - 1];
	}
	index = row * WM_CONTENT_W + col;
	wm_buf_Cs[window_id * WM_BUFFER_SIZE + index] = character;
	wm_buf_attrs[window_id * WM_BUFFER_SIZE + index] = color;
	if(wm_selected_win == window_id)
		wm_clear_highlight();
	wm_draw_content_region(window_id, col, row, win->w - 1, row);
	if(cx + 1 < (U INT)win->w)
		cx++;
	if(wm_cursor_on_prompt_line(window_id))
		wm_sync_input_from_screen(window_id);
	else
		wm_select_line(window_id, row);
	cursor_update();
}

VD wm_backspace_here(INT window_id)
{
	WMWindow *win;
	INT row;
	INT col;
	INT x_value;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	row = cy;
	col = cx;
	if(row < 0 || row >= win->h || col <= 0 || col > win->w)
		return;
	if(row == win->input_y && col <= win->input_x)
		return;
	cursor_hide();
	col--;
	cx = col;
	for(x_value = col; x_value < win->w - 1; x_value++) {
		wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value + 1];
		wm_buf_attrs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value] = wm_buf_attrs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + x_value + 1];
	}
	wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + win->w - 1] = ' ';
	wm_buf_attrs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + win->w - 1] = color;
	if(wm_selected_win == window_id)
		wm_clear_highlight();
	wm_draw_content_region(window_id, col, row, win->w - 1, row);
	if(wm_cursor_on_prompt_line(window_id))
		wm_sync_input_from_screen(window_id);
	else
		wm_select_line(window_id, row);
	cursor_update();
}

INT wm_create_plain_window(INT kind)
{
	INT window_id;
	INT base_x;
	INT base_y;
	INT base_width;
	INT base_height;
	INT old;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++)
		if(!wm_windows[window_id].alive)
			break;
	if(window_id >= WM_WINDOWS)
		return -1;
	if(kind == WM_ADD_CARD) {
		base_width = WM_CARD_W;
		base_height = WM_CARD_H;
		base_x = wm_next_card_x;
		base_y = wm_next_card_y;
		/* Start cards at the top-left edge, then keep cascading
		   down/right forever. No wrap and no border clamp. */
		wm_next_card_x += 4;
		wm_next_card_y += 3;
	}
	else {
		base_width = WM_SIDE_W;
		base_height = WM_SIDE_H;
		if(wm_next_side)
			base_x = W - WM_SIDE_W;
		else
			base_x = 0;
		base_y = 1;
		wm_next_side = !wm_next_side;
	}
	old = wm_active;
	if(old >= 0 && old < WM_WINDOWS && wm_windows[old].alive)
		con_save(&wm_windows[old]);
	wm_init_new_window(window_id, base_x, base_y, base_width, base_height);
	wm_active = window_id;
	wm_bring_front(window_id);
	con_load(&wm_windows[window_id]);
	wm_redraw_region(base_x, base_y, base_x + base_width - 1, base_y + base_height - 1);
	return window_id;
}

VD wm_draw_help_card(INT window_id)
{
	INT old;
	u8 oldcolor;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	old = wm_active;
	oldcolor = color;
	if(old >= 0 && old < WM_WINDOWS && wm_windows[old].alive)
		con_save(&wm_windows[old]);
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	color = 0x1F;
	clear();
	wm_set_title(window_id, "Help");
	print("AneoEngine Help\n");
	print("Useful files:\n");
	print("\ncommand help - /Help/CommandHelp.TXT\n");
	print("controls - /Help/Controls\n");
	print("about - /Help/AboutAneoEngine.TXT\n");
	print("FAQ - /Help/FAQ.TXT\n");
	print("Normal shell commands work here too.\n");
	wm_prompt();
	con_save(&wm_windows[window_id]);
	color = oldcolor;
	wm_active = old;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
}

VD wm_open_help_window(VD)
{
	INT window_id;
	if(!wm_on) {
		helpMenu();
		return;
	}
	if(wm_help_win >= 0 && wm_help_win < WM_WINDOWS && wm_windows[wm_help_win].alive) {
		wm_activate(wm_help_win);
		wm_task_focus_win = wm_help_win;
		return;
	}
	window_id = wm_create_plain_window(WM_ADD_CARD);
	if(window_id < 0)
		return;
	wm_help_win = window_id;
	wm_windows[window_id].task_cmd[0] = 0;
	wm_windows[window_id].task_pending = 0;
	wm_windows[window_id].task_running = 0;
	wm_windows[window_id].task_sp = 0;
	wm_windows[window_id].task_wake = 0;
	wm_windows[window_id].tune_running = 0;
	wm_windows[window_id].tune_until = 0;
	wm_windows[window_id].tune_sounding = 0;
	wm_draw_help_card(window_id);
	wm_activate(window_id);
	wm_task_focus_win = window_id;
}

VD wm_store_cell(INT x_value, INT y_value, C character, u8 col)
{
	WMWindow *win;
	INT region_x;
	INT region_y;
	INT index;
	if(!wm_on || wm_redrawing)
		return;
	if(console_mode != CON_WINDOW)
		return;
	if(wm_active < 0 || wm_active >= WM_WINDOWS)
		return;
	win = &wm_windows[wm_active];
	if(x_value < win->x || y_value < win->y || x_value >= win->x + win->w || y_value >= win->y + win->h)
		return;
	region_x = x_value - win->x;
	region_y = y_value - win->y;
	if(region_x < 0 || region_y < 0 || region_x >= WM_CONTENT_W || region_y >= WM_CONTENT_H)
		return;
	index = region_y * WM_CONTENT_W + region_x;
	wm_buf_Cs[wm_active * WM_BUFFER_SIZE + index] = character;
	wm_buf_attrs[wm_active * WM_BUFFER_SIZE + index] = col;
}

VD wm_capture(INT window_id)
{
	WMWindow *win;
	INT x_value;
	INT y_value;
	INT source_index;
	INT destination_index;
	if(!wm_on || window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(win->w > WM_CONTENT_W || win->h > WM_CONTENT_H)
		return;
	for(y_value = 0; y_value < win->h; y_value++) {
		for(x_value = 0; x_value < win->w; x_value++) {
			INT screen_x = win->x + x_value;
			INT screen_y = win->y + y_value;
			if(screen_x < 0 || screen_x >= W || screen_y < 0 || screen_y >= H)
				continue;
			source_index = screen_y * W + screen_x;
			destination_index = y_value * WM_CONTENT_W + x_value;
			wm_buf_Cs[window_id * WM_BUFFER_SIZE + destination_index] = screen_Cs[source_index];
			if(!wm_cell_selected(window_id, x_value, y_value))
				wm_buf_attrs[window_id * WM_BUFFER_SIZE + destination_index] = screen_attrs[source_index];
		}
	}
}

VD wm_capture_window(WMWindow *win)
{
	INT window_id;
	window_id = wm_index_of(win);
	if(window_id >= 0)
		wm_capture(window_id);
}

VD wm_draw_content(INT window_id)
{
	WMWindow *win;
	INT x_coordinate;
	INT y_coordinate;
	INT source_index;
	INT destination_index;
	u8 col;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	wm_redrawing = 1;
	for(y_coordinate = 0; y_coordinate < win->h; y_coordinate++) {
		for(x_coordinate = 0; x_coordinate < win->w; x_coordinate++) {
			INT screen_x = win->x + x_coordinate;
			INT screen_y = win->y + y_coordinate;
			if(screen_x < 0 || screen_x >= W || screen_y < 0 || screen_y >= H)
				continue;
			destination_index = y_coordinate * WM_CONTENT_W + x_coordinate;
			source_index = screen_y * W + screen_x;
			col = wm_buf_attrs[window_id * WM_BUFFER_SIZE + destination_index];
			if(wm_cell_selected(window_id, x_coordinate, y_coordinate))
				col = 0x70;
			screen_Cs[source_index] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + destination_index];
			screen_attrs[source_index] = col;
			screen_draw_cell(screen_x, screen_y, screen_Cs[source_index], col, 0);
		}
	}
	wm_redrawing = 0;
}

VD wm_draw_content_region(INT window_id, INT rx0, INT ry0, INT rx1, INT ry1)
{
	WMWindow *win;
	INT x_coordinate;
	INT y_coordinate;
	INT screen_x;
	INT screen_y;
	INT source_index;
	INT destination_index;
	u8 col;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(rx0 < 0)
		rx0 = 0;
	if(ry0 < 0)
		ry0 = 0;
	if(rx1 >= win->w)
		rx1 = win->w - 1;
	if(ry1 >= win->h)
		ry1 = win->h - 1;
	if(rx0 > rx1 || ry0 > ry1)
		return;
	wm_redrawing = 1;
	for(y_coordinate = ry0; y_coordinate <= ry1; y_coordinate++) {
		for(x_coordinate = rx0; x_coordinate <= rx1; x_coordinate++) {
			screen_x = win->x + x_coordinate;
			screen_y = win->y + y_coordinate;
			if(screen_x < 0 || screen_x >= W || screen_y < 0 || screen_y >= H)
				continue;
			if(!wm_cell_visible_for(window_id, screen_x, screen_y))
				continue;
			destination_index = y_coordinate * WM_CONTENT_W + x_coordinate;
			source_index = screen_y * W + screen_x;
			col = wm_buf_attrs[window_id * WM_BUFFER_SIZE + destination_index];
			if(wm_cell_selected(window_id, x_coordinate, y_coordinate))
				col = 0x70;
			screen_Cs[source_index] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + destination_index];
			screen_attrs[source_index] = col;
			screen_draw_cell(screen_x, screen_y, screen_Cs[source_index], col, 0);
		}
	}
	wm_redrawing = 0;
}

VD wm_compose_window_cell(INT window_id, INT screen_x, INT screen_y, C *outc, u8 *outcol)
{
	WMWindow *win;
	CC *status;
	u32 memory_bytes;
	u32 memory_temp;
	C memory_text[11];
	INT region_x;
	INT region_y;
	INT max;
	INT target_index;
	INT status_len;
	INT memory_digits;
	INT memory_start;
	INT memory_index;
	u8 col;
	u8 status_col;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(screen_x < win->bx || screen_y < win->by || screen_x >= win->bx + win->bw || screen_y >= win->by + win->bh)
		return;
	if(window_id == wm_active)
		col = 0x1F;
	else
		col = 0x17;
	region_x = screen_x - win->bx;
	region_y = screen_y - win->by;
	if(region_y == 0 || region_y == win->bh - 1 || region_x == 0 || region_x == win->bw - 1) {
		*outcol = col;
		*outc = ' ';
		if(region_y == 0 && region_x == 0)
			*outc = (C)218;
		else if(region_y == 0 && region_x == win->bw - 1)
			*outc = (C)191;
		else if(region_y == win->bh - 1 && region_x == 0)
			*outc = (C)192;
		else if(region_y == win->bh - 1 && region_x == win->bw - 1)
			*outc = (C)217;
		else if(region_y == 0 || region_y == win->bh - 1)
			*outc = (C)196;
		else
			*outc = (C)179;
		if(region_y == 0) {
			max = win->bw - 8;
			if(max > WM_TITLE_MAX - 1)
				max = WM_TITLE_MAX - 1;
			if(max < 0)
				max = 0;
			if(region_x > 0 && region_x < win->bw - 1)
				*outc = ' ';
			if(region_x >= 2 && region_x < 2 + max) {
				target_index = region_x - 2;
				if(win->title[target_index]) {
					*outc = win->title[target_index];
					*outcol = wm_flash_attr(col);
				}
			}
			if(region_x == win->bw - WM_CLOSE_MARGIN) {
				*outc = 'X';
				*outcol = col;
			}
		}
		else if(region_y == win->bh - 1 && region_x >= 2 && region_x < win->bw - 1) {
			memstat_window_state(window_id, &status, &status_col);
			status_len = 0;
			while(status[status_len])
				status_len++;
			if(region_x == 2) {
				*outc = '[';
				*outcol = wm_flash_attr(status_col);
			}
			else if(region_x >= 3 && region_x < 3 + status_len) {
				*outc = status[region_x - 3];
				*outcol = wm_flash_attr(status_col);
			}
			else if(region_x == 3 + status_len) {
				*outc = ']';
				*outcol = wm_flash_attr(status_col);
			}
			else {
				memory_bytes = memstat_window_bytes(window_id);
				memory_temp = memory_bytes;
				memory_digits = 1;
				while(memory_temp >= 10U && memory_digits < 10) {
					memory_temp /= 10U;
					memory_digits++;
				}
				memory_temp = memory_bytes;
				for(memory_index = memory_digits - 1; memory_index >= 0; memory_index--) {
					memory_text[memory_index] = '0' + (memory_temp % 10U);
					memory_temp /= 10U;
				}
				memory_start = win->bw - memory_digits - 2;
				if(memory_start > 4 + status_len) {
					memory_index = region_x - memory_start;
					if(memory_index >= 0 && memory_index < memory_digits) {
						*outc = memory_text[memory_index];
						*outcol = wm_flash_attr(col);
					}
				}
			}
		}
		return;
	}
	if(screen_x >= win->x && screen_y >= win->y && screen_x < win->x + win->w && screen_y < win->y + win->h) {
		INT buffer_index;
		INT cx0;
		INT cy0;
		cx0 = screen_x - win->x;
		cy0 = screen_y - win->y;
		buffer_index = cy0 * WM_CONTENT_W + cx0;
		*outc = wm_buf_Cs[window_id * WM_BUFFER_SIZE + buffer_index];
		if(wm_cell_selected(window_id, cx0, cy0))
			*outcol = 0x70;
		else
			*outcol = wm_buf_attrs[window_id * WM_BUFFER_SIZE + buffer_index];
	}
}

VD wm_compose_menu_cell(INT screen_x, INT screen_y, C *outc, u8 *outcol)
{
	CC *character;
	INT idx;
	if(!wm_add_menu)
		return;
	if(screen_x < WM_MENU_X || screen_x >= WM_MENU_X + WM_MENU_W || screen_y < WM_MENU_Y || screen_y >= WM_MENU_Y + WM_MENU_H)
		return;
	*outc = ' ';
	*outcol = 0x1F;
	if(screen_y == WM_MENU_Y || screen_y == WM_MENU_Y + WM_MENU_H - 1)
		*outc = (C)196;
	if(screen_x == WM_MENU_X || screen_x == WM_MENU_X + WM_MENU_W - 1)
		*outc = (C)179;
	if(screen_x == WM_MENU_X && screen_y == WM_MENU_Y)
		*outc = (C)218;
	else if(screen_x == WM_MENU_X + WM_MENU_W - 1 && screen_y == WM_MENU_Y)
		*outc = (C)191;
	else if(screen_x == WM_MENU_X && screen_y == WM_MENU_Y + WM_MENU_H - 1)
		*outc = (C)192;
	else if(screen_x == WM_MENU_X + WM_MENU_W - 1 && screen_y == WM_MENU_Y + WM_MENU_H - 1)
		*outc = (C)217;
	character = 0;
	if(screen_y == WM_MENU_Y + 1)
		character = "+ Add window";
	else if(screen_y == WM_MENU_Y + 2)
		character = "Card window";
	else if(screen_y == WM_MENU_Y + 3)
		character = "Side window";
	if(character) {
		idx = screen_x - (WM_MENU_X + 2);
		if(idx >= 0 && character[idx])
			*outc = character[idx];
	}
}

VD wm_compose_cell(INT screen_x, INT screen_y, C *outc, u8 *outcol)
{
	INT z_index;
	INT window_id;
	*outc = ' ';
	*outcol = WM_BG_ATTR;
	memstat_overlay_compose(screen_x, screen_y, outc, outcol);
	for(z_index = 0; z_index < wm_z_count; z_index++) {
		window_id = wm_z_order[z_index];
		wm_compose_window_cell(window_id, screen_x, screen_y, outc, outcol);
	}
	wm_compose_menu_cell(screen_x, screen_y, outc, outcol);
}

INT wm_cell_visible_for(INT window_id, INT screen_x, INT screen_y)
{
	INT z_index;
	INT pos;
	INT top;
	WMWindow *win;
	if(!wm_on || wm_redrawing)
		return 1;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return 1;
	if(wm_add_menu && screen_x >= WM_MENU_X && screen_x < WM_MENU_X + WM_MENU_W && screen_y >= WM_MENU_Y && screen_y < WM_MENU_Y + WM_MENU_H)
		return 0;
	pos = -1;
	for(z_index = 0; z_index < wm_z_count; z_index++)
		if(wm_z_order[z_index] == window_id)
			pos = z_index;
	if(pos < 0)
		return 1;
	for(z_index = pos + 1; z_index < wm_z_count; z_index++) {
		top = wm_z_order[z_index];
		if(top < 0 || top >= WM_WINDOWS || !wm_windows[top].alive)
			continue;
		win = &wm_windows[top];
		if(screen_x >= win->bx && screen_x < win->bx + win->bw && screen_y >= win->by && screen_y < win->by + win->bh)
			return 0;
	}
	return 1;
}

VD wm_redraw_region(INT rx0, INT ry0, INT rx1, INT ry1)
{
	INT x_coordinate;
	INT y_coordinate;
	INT index;
	C character;
	u8 col;
	INT redraw_mouse;
	if(rx0 < 0)
		rx0 = 0;
	if(ry0 < 1)
		ry0 = 1;
	if(rx1 >= W)
		rx1 = W - 1;
	if(ry1 >= H)
		ry1 = H - 1;
	if(rx0 > rx1 || ry0 > ry1)
		return;
	cursor_hide();
	redraw_mouse = mouse_drawn;
	if(redraw_mouse)
		mouse_hide();
	wm_redrawing = 1;
	for(y_coordinate = ry0; y_coordinate <= ry1; y_coordinate++) {
		for(x_coordinate = rx0; x_coordinate <= rx1; x_coordinate++) {
			wm_compose_cell(x_coordinate, y_coordinate, &character, &col);
			index = y_coordinate * W + x_coordinate;
			if(screen_Cs[index] != character || screen_attrs[index] != col) {
				screen_Cs[index] = character;
				screen_attrs[index] = col;
				screen_draw_cell(x_coordinate, y_coordinate, character, col, 0);
			}
		}
	}
	wm_redrawing = 0;
	cursor_update();
	if(redraw_mouse)
		mouse_show();
}

VD wm_redraw_window_move(INT window_id, INT obx, INT oby)
{
	WMWindow *win;
	INT rx0;
	INT ry0;
	INT rx1;
	INT ry1;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	win = &wm_windows[window_id];
	rx0 = obx;
	ry0 = oby;
	rx1 = obx + win->bw - 1;
	ry1 = oby + win->bh - 1;
	if(win->bx < rx0)
		rx0 = win->bx;
	if(win->by < ry0)
		ry0 = win->by;
	if(win->bx + win->bw - 1 > rx1)
		rx1 = win->bx + win->bw - 1;
	if(win->by + win->bh - 1 > ry1)
		ry1 = win->by + win->bh - 1;
	wm_redraw_region(rx0, ry0, rx1, ry1);
}

VD wm_clear_background(VD)
{
	INT x_coordinate;
	INT y_coordinate;
	INT index;
	cursor_hide();
	mouse_hide();
	gfx_clear_text_rect(0, 1, W, H - 1, 0x0F);
	for(y_coordinate = 1; y_coordinate < H; y_coordinate++) {
		for(x_coordinate = 0; x_coordinate < W; x_coordinate++) {
			index = y_coordinate * W + x_coordinate;
			screen_Cs[index] = ' ';
			screen_attrs[index] = WM_BG_ATTR;
		}
	}
}

VD wm_redraw_all(VD)
{
	INT oldmode;
	INT oldx;
	INT oldy;
	INT oldw;
	INT oldh;
	U INT oldcx;
	U INT oldcy;
	oldmode = console_mode;
	oldx = con_x;
	oldy = con_y;
	oldw = con_w;
	oldh = con_h;
	oldcx = cx;
	oldcy = cy;
	con_set_full();
	draw_tb();
	update_rtc_only();
	wm_redraw_region(0, 1, W - 1, H - 1);
	wm_draw_top_controls();
	console_mode = oldmode;
	con_x = oldx;
	con_y = oldy;
	con_w = oldw;
	con_h = oldh;
	cx = oldcx;
	cy = oldcy;
}

VD wm_activate(INT window_id)
{
	INT old;
	INT rx0;
	INT ry0;
	INT rx1;
	INT ry1;
	WMWindow *win;
	WMWindow *oldwin;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	old = wm_active;
	if(old >= 0 && old < WM_WINDOWS && wm_windows[old].alive)
		con_save(&wm_windows[old]);
	cursor_hide();
	wm_active = window_id;
	wm_bring_front(window_id);
	con_load(&wm_windows[wm_active]);
	win = &wm_windows[window_id];
	rx0 = win->bx;
	ry0 = win->by;
	rx1 = win->bx + win->bw - 1;
	ry1 = win->by + win->bh - 1;
	if(old >= 0 && old < WM_WINDOWS && wm_windows[old].alive) {
		oldwin = &wm_windows[old];
		if(oldwin->bx < rx0) rx0 = oldwin->bx;
		if(oldwin->by < ry0) ry0 = oldwin->by;
		if(oldwin->bx + oldwin->bw - 1 > rx1) rx1 = oldwin->bx + oldwin->bw - 1;
		if(oldwin->by + oldwin->bh - 1 > ry1) ry1 = oldwin->by + oldwin->bh - 1;
	}
	wm_redraw_region(rx0, ry0, rx1, ry1);
	cursor_update();
}

INT wm_hit_window(INT target_x, INT target_y)
{
	INT z_index;
	INT window_id;
	WMWindow *win;
	for(z_index = wm_z_count - 1; z_index >= 0; z_index--) {
		window_id = wm_z_order[z_index];
		if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
			continue;
		win = &wm_windows[window_id];
		if(target_x >= win->bx && target_x < win->bx + win->bw &&
		   target_y >= win->by && target_y < win->by + win->bh)
			return window_id;
	}
	return -1;
}

VD wm_extract_line_command(INT window_id, INT row, C *out)
{
	INT index;
	INT end;
	INT start;
	WMWindow *win;
	C line[WM_CONTENT_W + 1];
	out[0] = 0;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(row < 0 || row >= win->h)
		return;
	for(index = 0; index < win->w; index++)
		line[index] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + row * WM_CONTENT_W + index];
	line[win->w] = 0;
	end = win->w;
	while(end > 0 && line[end - 1] == ' ')
		end--;
	line[end] = 0;
	start = 0;
	for(index = 0; index < end; index++)
		if(line[index] == '>')
			start = index + 1;
	while(line[start] == ' ')
		start++;
	index = 0;
	while(line[start] && index < WM_INPUT_MAX - 1)
		out[index++] = line[start++];
	out[index] = 0;
}

INT wm_cell_in_selection(INT type, INT row, INT start_x, INT start_y, INT end_x, INT end_y, INT x_value, INT y_value)
{
	INT array;
	INT boundary;
	INT position;
	if(type == 1)
		return y_value == row;
	if(type != 2)
		return 0;
	array = start_y * WM_CONTENT_W + start_x;
	boundary = end_y * WM_CONTENT_W + end_x;
	position = y_value * WM_CONTENT_W + x_value;
	if(array > boundary) {
		INT temporary_value = array;
		array = boundary;
		boundary = temporary_value;
	}
	return position >= array && position <= boundary;
}

INT wm_cell_selected(INT window_id, INT x_value, INT y_value)
{
	if(window_id != wm_selected_win)
		return 0;
	return wm_cell_in_selection(wm_selected_type, wm_selected_row, wm_sel_x0, wm_sel_y0, wm_sel_x1, wm_sel_y1, x_value, y_value);
}

VD wm_draw_selected_cell(INT window_id, INT x_coordinate, INT y_coordinate, INT selected)
{
	WMWindow *win;
	INT source_index;
	INT buffer_index;
	u8 col;
	if(window_id < 0 || window_id >= WM_WINDOWS || x_coordinate < 0 || y_coordinate < 0 || x_coordinate >= WM_CONTENT_W || y_coordinate >= WM_CONTENT_H)
		return;
	win = &wm_windows[window_id];
	if(!win->alive || x_coordinate >= win->w || y_coordinate >= win->h)
		return;
	{
		INT screen_x = win->x + x_coordinate;
		INT screen_y = win->y + y_coordinate;
		if(screen_x < 0 || screen_x >= W || screen_y < 0 || screen_y >= H)
			return;
		buffer_index = y_coordinate * WM_CONTENT_W + x_coordinate;
		source_index = screen_y * W + screen_x;
		if(selected)
			col = 0x70;
		else
			col = wm_buf_attrs[window_id * WM_BUFFER_SIZE + buffer_index];
		screen_Cs[source_index] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + buffer_index];
		screen_attrs[source_index] = col;
		screen_draw_cell(screen_x, screen_y, screen_Cs[source_index], col, 0);
	}
}

VD wm_redraw_selection_change(INT oldwin, INT oldtype, INT oldrow, INT oldx0, INT oldy0, INT oldx1, INT oldy1, INT newwin, INT newtype, INT newrow, INT newx0, INT newy0, INT newx1, INT newy1)
{
	INT window_id;
	INT x_coordinate;
	INT y_coordinate;
	INT oldsel;
	INT newsel;
	INT miny;
	INT maxy;
	WMWindow *win;
	if(oldwin < 0 && newwin < 0)
		return;
	cursor_hide();
	mouse_hide();
	wm_redrawing = 1;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++) {
		if(window_id != oldwin && window_id != newwin)
			continue;
		if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
			continue;
		win = &wm_windows[window_id];
		miny = 0;
		maxy = win->h - 1;
		if(window_id == oldwin && window_id == newwin) {
			INT omin;
			INT omax;
			INT nmin;
			INT nmax;
			omin = 0;
			omax = WM_CONTENT_H - 1;
			nmin = 0;
			nmax = WM_CONTENT_H - 1;
			if(oldtype == 1)
				omin = omax = oldrow;
			else if(oldtype == 2) {
				if(oldy0 < oldy1)
					omin = oldy0;
				else
					omin = oldy1;
				if(oldy0 > oldy1)
					omax = oldy0;
				else
					omax = oldy1;
			}
			if(newtype == 1)
				nmin = nmax = newrow;
			else if(newtype == 2) {
				if(newy0 < newy1)
					nmin = newy0;
				else
					nmin = newy1;
				if(newy0 > newy1)
					nmax = newy0;
				else
					nmax = newy1;
			}
			if(omin < nmin)
				miny = omin;
			else
				miny = nmin;
			if(omax > nmax)
				maxy = omax;
			else
				maxy = nmax;
		}
		else if(window_id == oldwin) {
			if(oldtype == 1)
				miny = maxy = oldrow;
			else if(oldtype == 2) {
				if(oldy0 < oldy1)
					miny = oldy0;
				else
					miny = oldy1;
				if(oldy0 > oldy1)
					maxy = oldy0;
				else
					maxy = oldy1;
			}
		}
		else if(window_id == newwin) {
			if(newtype == 1)
				miny = maxy = newrow;
			else if(newtype == 2) {
				if(newy0 < newy1)
					miny = newy0;
				else
					miny = newy1;
				if(newy0 > newy1)
					maxy = newy0;
				else
					maxy = newy1;
			}
		}
		if(miny < 0)
			miny = 0;
		if(maxy >= win->h)
			maxy = win->h - 1;
		for(y_coordinate = miny; y_coordinate <= maxy; y_coordinate++) {
			for(x_coordinate = 0; x_coordinate < win->w; x_coordinate++) {
				if(window_id == oldwin)
					oldsel = wm_cell_in_selection(oldtype, oldrow, oldx0, oldy0, oldx1, oldy1, x_coordinate, y_coordinate);
				else
					oldsel = 0;
				if(window_id == newwin)
					newsel = wm_cell_in_selection(newtype, newrow, newx0, newy0, newx1, newy1, x_coordinate, y_coordinate);
				else
					newsel = 0;
				if(oldsel != newsel)
					wm_draw_selected_cell(window_id, x_coordinate, y_coordinate, newsel);
			}
		}
	}
	wm_redrawing = 0;
	cursor_update();
	mouse_show();
}

VD wm_extract_range_command(INT window_id, C *out)
{
	INT array;
	INT boundary;
	INT position;
	INT index;
	INT len;
	out[0] = 0;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	array = wm_sel_y0 * WM_CONTENT_W + wm_sel_x0;
	boundary = wm_sel_y1 * WM_CONTENT_W + wm_sel_x1;
	if(array > boundary) {
		INT temporary_value = array;
		array = boundary;
		boundary = temporary_value;
	}
	len = 0;
	for(position = array; position <= boundary && len < WM_INPUT_MAX - 1; position++) {
		if((position % WM_CONTENT_W) == 0 && position != array && len < WM_INPUT_MAX - 1)
			out[len++] = ' ';
		out[len++] = wm_buf_Cs[window_id * WM_BUFFER_SIZE + position];
	}
	out[len] = 0;
	while(out[0] == ' ') {
		for(index = 0; out[index]; index++)
			out[index] = out[index + 1];
	}
	while(len > 0 && out[len - 1] == ' ') {
		out[len - 1] = 0;
		len--;
	}
}

VD wm_finish_selected_cmd(INT window_id)
{
	INT index;
	INT start;
	INT len;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(wm_selected_type == 1)
		wm_extract_line_command(window_id, wm_selected_row, wm_selected_cmd);
	else if(wm_selected_type == 2)
		wm_extract_range_command(window_id, wm_selected_cmd);
	else
		wm_selected_cmd[0] = 0;
	start = 0;
	for(index = 0; wm_selected_cmd[index]; index++)
		if(wm_selected_cmd[index] == '>')
			start = index + 1;
	while(wm_selected_cmd[start] == ' ')
		start++;
	if(start) {
		index = 0;
		while(wm_selected_cmd[start])
			wm_selected_cmd[index++] = wm_selected_cmd[start++];
		wm_selected_cmd[index] = 0;
	}
	len = 0;
	while(wm_selected_cmd[len])
		len++;
	while(len > 0 && wm_selected_cmd[len - 1] == ' ')
		wm_selected_cmd[--len] = 0;
}

VD wm_clear_highlight(VD)
{
	INT oldwin;
	INT oldtype;
	INT oldrow;
	INT oldx0;
	INT oldy0;
	INT oldx1;
	INT oldy1;
	oldwin = wm_selected_win;
	oldtype = wm_selected_type;
	oldrow = wm_selected_row;
	oldx0 = wm_sel_x0;
	oldy0 = wm_sel_y0;
	oldx1 = wm_sel_x1;
	oldy1 = wm_sel_y1;
	wm_selected_win = -1;
	wm_selected_row = -1;
	wm_selected_type = 0;
	wm_selected_cmd[0] = 0;
	wm_redraw_selection_change(oldwin, oldtype, oldrow, oldx0, oldy0, oldx1, oldy1, -1, 0, -1, 0, 0, 0, 0);
}

VD wm_select_line(INT window_id, INT row)
{
	INT oldwin;
	INT oldtype;
	INT oldrow;
	INT oldx0;
	INT oldy0;
	INT oldx1;
	INT oldy1;
	INT lastx;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	if(row < 0 || row >= wm_windows[window_id].h)
		return;
	oldwin = wm_selected_win;
	oldtype = wm_selected_type;
	oldrow = wm_selected_row;
	oldx0 = wm_sel_x0;
	oldy0 = wm_sel_y0;
	oldx1 = wm_sel_x1;
	oldy1 = wm_sel_y1;
	lastx = wm_windows[window_id].w - 1;
	if(lastx < 0)
		lastx = 0;
	wm_selected_win = window_id;
	wm_selected_row = row;
	wm_selected_type = 1;
	wm_sel_x0 = 0;
	wm_sel_y0 = row;
	wm_sel_x1 = lastx;
	wm_sel_y1 = row;
	wm_finish_selected_cmd(window_id);
	wm_redraw_selection_change(oldwin, oldtype, oldrow, oldx0, oldy0, oldx1, oldy1, window_id, 1, row, 0, row, lastx, row);
}

VD wm_select_range(INT window_id, INT start_x, INT start_y, INT end_x, INT end_y)
{
	INT oldwin;
	INT oldtype;
	INT oldrow;
	INT oldx0;
	INT oldy0;
	INT oldx1;
	INT oldy1;
	WMWindow *win;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(start_x < 0)
		start_x = 0;
	if(start_y < 0)
		start_y = 0;
	if(end_x < 0)
		end_x = 0;
	if(end_y < 0)
		end_y = 0;
	if(start_x >= win->w)
		start_x = win->w - 1;
	if(end_x >= win->w)
		end_x = win->w - 1;
	if(start_y >= win->h)
		start_y = win->h - 1;
	if(end_y >= win->h)
		end_y = win->h - 1;
	oldwin = wm_selected_win;
	oldtype = wm_selected_type;
	oldrow = wm_selected_row;
	oldx0 = wm_sel_x0;
	oldy0 = wm_sel_y0;
	oldx1 = wm_sel_x1;
	oldy1 = wm_sel_y1;
	wm_selected_win = window_id;
	wm_selected_row = -1;
	wm_selected_type = 2;
	wm_sel_x0 = start_x;
	wm_sel_y0 = start_y;
	wm_sel_x1 = end_x;
	wm_sel_y1 = end_y;
	wm_finish_selected_cmd(window_id);
	wm_redraw_selection_change(oldwin, oldtype, oldrow, oldx0, oldy0, oldx1, oldy1, window_id, 2, -1, start_x, start_y, end_x, end_y);
}

VD screen_write_at(INT x_coordinate, INT y_coordinate, CC *string, u8 col)
{
	INT index;
	index = 0;
	while(string[index] && x_coordinate + index < W) {
		screen_put_at(x_coordinate + index, y_coordinate, string[index], col);
		index++;
	}
}

VD screen_put2_at(INT x_coordinate, INT y_coordinate, u8 count, u8 col)
{
	screen_put_at(x_coordinate, y_coordinate, '0' + (count / 10), col);
	screen_put_at(x_coordinate + 1, y_coordinate, '0' + (count % 10), col);
}

VD screen_redraw(VD)
{
	INT index;
	gfx_fill((color >> 4) & 0x0F);
	for(index = 0; index < W * H; index++)
		screen_draw_cell(index % W, index / W, screen_Cs[index], screen_attrs[index], cursor_drawn && cursor_x == (U INT)(index % W) && cursor_y == (U INT)(index / W));
}

VD gfx_pixel(INT pixel_x, INT pixel_y, u8 col)
{
	U INT off;
	u8 mask;
	if(pixel_x < 0 || pixel_x >= 640 || pixel_y < 0 || pixel_y >= 480)
		return;
	off = gfx_off(vga_start + pixel_y * 80 + (pixel_x >> 3));
	mask = 0x80 >> (pixel_x & 7);
	gfx_write_masked(off, mask, col & 0x0F);
}

INT mouse_cell_hit(INT x_coordinate, INT y_coordinate)
{
	INT start_x;
	INT start_y;
	INT end_x;
	INT end_y;
	if(!mouse_drawn)
		return 0;
	start_x = mouse_old_x / 8;
	start_y = mouse_old_y / 8;
	end_x = (mouse_old_x + MOUSE_W - 1) / 8;
	end_y = (mouse_old_y + MOUSE_H - 1) / 8;
	return x_coordinate >= start_x && x_coordinate <= end_x && y_coordinate >= start_y && y_coordinate <= end_y;
}

VD mouse_redraw_area(INT pixel_x, INT pixel_y)
{
	INT x_coordinate;
	INT y_coordinate;
	INT start_x;
	INT start_y;
	INT end_x;
	INT end_y;
	INT index;
	start_x = pixel_x / 8;
	start_y = pixel_y / 8;
	end_x = (pixel_x + MOUSE_W - 1) / 8;
	end_y = (pixel_y + MOUSE_H - 1) / 8;
	if(start_x < 0)
		start_x = 0;
	if(start_y < 0)
		start_y = 0;
	if(end_x >= W)
		end_x = W - 1;
	if(end_y >= H)
		end_y = H - 1;
	for(y_coordinate = start_y; y_coordinate <= end_y; y_coordinate++) {
		for(x_coordinate = start_x; x_coordinate <= end_x; x_coordinate++) {
			index = y_coordinate * W + x_coordinate;
			screen_draw_cell(x_coordinate, y_coordinate, screen_Cs[index], screen_attrs[index], cursor_drawn && cursor_x == (U INT)x_coordinate && cursor_y == (U INT)y_coordinate);
		}
	}
}

VD mouse_hide(VD)
{
	if(!mouse_drawn)
		return;
	mouse_redraw_area(mouse_old_x, mouse_old_y);
	mouse_drawn = 0;
}

u8 screen_pixel_color(INT pixel_x, INT pixel_y)
{
	INT target_x;
	INT target_y;
	INT region_x;
	INT region_y;
	INT index;
	u8 col;
	u8 foreground_color;
	u8 background_color;
	u8 bits;
	C character;
	if(pixel_x < 0 || pixel_x >= 640 || pixel_y < 0 || pixel_y >= 480)
		return 0;
	target_x = pixel_x >> 3;
	target_y = pixel_y >> 3;
	region_x = pixel_x & 7;
	region_y = pixel_y & 7;
	index = target_y * W + target_x;
	character = screen_Cs[index];
	col = screen_attrs[index];
	foreground_color = col & 0x0F;
	background_color = (col >> 4) & 0x0F;
	if(cursor_drawn && cursor_x == (U INT)target_x && cursor_y == (U INT)target_y) {
		u8 temporary_value = foreground_color;
		foreground_color = background_color;
		background_color = temporary_value;
	}
	if(character == ' ')
		bits = 0;
	else
		bits = FONT8X8[((u8)character * 8) + region_y];
	if(bits & (0x80 >> region_x))
		return foreground_color;
	return background_color;
}

VD mouse_draw_shape(INT x_coordinate, INT y_coordinate)
{
	INT row;
	INT col;
	gfx_ready();
	for(row = 0; row < MOUSE_H; row++) {
		for(col = 0; col < MOUSE_W; col++) {
			if(mouse_arrow[row] & (0x400 >> col))
				gfx_pixel(x_coordinate + col, y_coordinate + row, screen_pixel_color(x_coordinate + col, y_coordinate + row) ^ 0x0F);
		}
	}
}

VD mouse_show(VD)
{
	if(!mouse_ready || mouse_drawn)
		return;
	mouse_draw_shape(mouse_x, mouse_y);
	mouse_old_x = mouse_x;
	mouse_old_y = mouse_y;
	mouse_drawn = 1;
}

INT ps2_wait_input_clear(VD)
{
	INT temporary_value;
	for(temporary_value = 0; temporary_value < 100000; temporary_value++)
		if((inb(0x64) & 2) == 0)
			return 1;
	return 0;
}

INT ps2_wait_output_full(VD)
{
	INT temporary_value;
	for(temporary_value = 0; temporary_value < 100000; temporary_value++)
		if(inb(0x64) & 1)
			return 1;
	return 0;
}

VD mouse_write(u8 val)
{
	ps2_wait_input_clear();
	outb(0x64, 0xD4);
	ps2_wait_input_clear();
	outb(0x60, val);
	ps2_wait_output_full();
	inb(0x60);
}

VD mouse_flush_aux(VD)
{
	u8 status;
	INT temporary_value;
	for(temporary_value = 0; temporary_value < 64; temporary_value++) {
		status = inb(0x64);
		if(!(status & 1))
			return;
		if(!(status & 0x20))
			return;
		inb(0x60);
	}
}

VD ps2_flush_output(VD)
{//discard anything sitting in the PS/2 output buffer,
//keyboard or mouse, so command replies aren't misread
	INT temporary_value;
	for(temporary_value = 0; temporary_value < 64; temporary_value++) {
		if(!(inb(0x64) & 1))
			return;
		inb(0x60);
	}
}

VD kb_drain_mouse(VD)
{//throw away pending mouse bytes so modal getkey()
//loops (like the editor) never jam behind mouse data
	u8 status;
	INT temporary_value;
	for(temporary_value = 0; temporary_value < 64; temporary_value++) {
		status = inb(0x64);
		if(!(status & 1))
			return;
		if(!(status & 0x20))
			return;
		inb(0x60);
		mouse_packet_index = 0;
	}
}

VD mouse_init(VD)
{
	u8 status;
	mouse_ready = 0;
	ps2_wait_input_clear();
	outb(0x64, 0xA8);
	ps2_flush_output();
	ps2_wait_input_clear();
	outb(0x64, 0x20);
	if(ps2_wait_output_full())
		status = inb(0x60);
	else
		status = 0x44;
	status &= ~2;
	status &= ~0x20;
	status &= ~0x10; //keep the keyboard clock enabled
	status |= 0x40;  //keep scancode translation ON (set 1),
	                 //QEMU scrambles every key without this
	ps2_wait_input_clear();
	outb(0x64, 0x60);
	ps2_wait_input_clear();
	outb(0x60, status);
	mouse_flush_aux();
	mouse_write(0xF6);
	mouse_write(0xF4);
	mouse_flush_aux();
	mouse_packet_index = 0;
	mouse_ready = 1;
	mouse_show();
}

VD wm_move_window(INT window_id, INT nbx, INT nby)
{
	WMWindow *win;
	INT obx;
	INT oby;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	if(!wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	if(win->fullscreen)
		return;
	/* No border clamp: dragging can place a window partly or fully
	   outside the screen. Visible cells are clipped by redraw code. */
	if(nbx == win->bx && nby == win->by)
		return;
	obx = win->bx;
	oby = win->by;
	win->bx = nbx;
	win->by = nby;
	win->x = nbx + 1;
	win->y = nby + 1;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
	wm_redraw_window_move(window_id, obx, oby);
}

VD wm_mouse_down(INT target_x, INT target_y)
{
	INT window_id;
	WMWindow *win;
	if(target_y == 0 && target_x >= WM_PLUS_X - 1 && target_x <= WM_PLUS_X + 1) {
		if(wm_add_menu)
			wm_hide_add_menu();
		else {
			wm_add_menu = 1;
			wm_draw_add_menu();
		}
		return;
	}
	if(wm_handle_add_menu_click(target_x, target_y))
		return;
	window_id = wm_hit_window(target_x, target_y);
	if(window_id < 0)
		return;
	win = &wm_windows[window_id];
	if(target_y == win->by && target_x == win->bx + win->bw - WM_CLOSE_MARGIN) {
		wm_close_window(window_id);
		return;
	}
	wm_activate(window_id);
	win = &wm_windows[window_id];
	if((target_x == win->bx || target_x == win->bx + win->bw - 1 ||
	    target_y == win->by || target_y == win->by + win->bh - 1) &&
	   !win->fullscreen)
	{
		wm_mouse_select_win = -1;
		wm_drag_win = window_id;
		wm_drag_dx = target_x - win->bx;
		wm_drag_dy = target_y - win->by;
		return;
	}
	if(target_x >= win->x && target_x < win->x + win->w &&
	   target_y >= win->y && target_y < win->y + win->h)
	{
		wm_mouse_select_win = -1;
		cursor_update();
	}
}

VD wm_mouse_up(VD)
{
	wm_drag_win = -1;
	wm_mouse_select_win = -1;
}

VD wm_mouse_drag(INT target_x, INT target_y)
{
	if(wm_drag_win >= 0) {
		wm_move_window(wm_drag_win, target_x - wm_drag_dx, target_y - wm_drag_dy);
		return;
	}
}

VD wm_mouse_poll(VD)
{
	u8 status;
	u8 byte_value;
	INT delta_x;
	INT delta_y;
	INT target_x;
	INT target_y;
	INT old_left;
	INT old_tx;
	INT old_ty;
	INT bytes_read;
	if(!mouse_ready)
		return;
	old_left = mouse_left;
	old_tx = mouse_x / 8;
	old_ty = mouse_y / 8;
	bytes_read = 0;
	/* Consume at most one complete PS/2 packet per poll. This preserves
	   the controller's native 1x motion and avoids burst acceleration. */
	while((inb(0x64) & 1) && bytes_read < 3) {
		status = inb(0x64);
		if(!(status & 0x20))
			break;
		byte_value = inb(0x60);
		bytes_read++;
		if(mouse_packet_index == 0) {
			if(!(byte_value & 0x08))
				continue;
			if(byte_value & 0xC0)
				continue;
		}
		mouse_packet[mouse_packet_index] = byte_value;
		mouse_packet_index++;
		if(mouse_packet_index < 3)
			continue;
		mouse_packet_index = 0;
		/* Decode the PS/2 sign bits explicitly. AneoC's signed-char cast
		   does not sign-extend these bytes the same way GCC did. */
		delta_x = (INT)mouse_packet[1];
		if(mouse_packet[0] & 0x10)
			delta_x -= 256;
		delta_y = (INT)mouse_packet[2];
		if(mouse_packet[0] & 0x20)
			delta_y -= 256;
		mouse_hide();
		mouse_x += delta_x * MOUSE_SPEED;
		mouse_y -= delta_y * MOUSE_SPEED;
		if(mouse_x < 0)
			mouse_x = 0;
		if(mouse_y < 0)
			mouse_y = 0;
		if(mouse_x > 639)
			mouse_x = 639;
		if(mouse_y > 479)
			mouse_y = 479;
		mouse_prev_left = old_left;
		mouse_left = mouse_packet[0] & 1;
		target_x = mouse_x / 8;
		target_y = mouse_y / 8;
		if(wm_on) {
			if(mouse_left && !mouse_prev_left)
				wm_mouse_down(target_x, target_y);
			else if(mouse_left && mouse_prev_left) {
				if(target_x != old_tx || target_y != old_ty)
					wm_mouse_drag(target_x, target_y);
			}
			else if(!mouse_left && mouse_prev_left)
				wm_mouse_up();
		}
		mouse_show();
		return;
	}
}

u8 cmos_read(u8 reg)
{//read CMOS data from 0x70
        outb(CMOS_ADDR, reg);
        return inb(CMOS_DATA);
}

u8 bcd_to_bin(u8 val)
{//BIN to decimal conversion
        return (val & 0x0F) + ((val >> 4) * 10);
}
TD U C u8;
TD ST {
        u8 second;
        u8 minute;
        u8 hour;
        u8 day;
        u8 month;
        u8 year;
} RTCDateTime;

RTCDateTime rtc_get_datetime(VD)
{//write certain RTC values to CMOS to get
//the date and time from RTC
        RTCDateTime t;
        t.second = bcd_to_bin(cmos_read(RTC_SECONDS));
        t.minute = bcd_to_bin(cmos_read(RTC_MINUTES));
        t.hour   = bcd_to_bin(cmos_read(RTC_HOURS));
        t.day    = bcd_to_bin(cmos_read(RTC_DAY));
        t.month  = bcd_to_bin(cmos_read(RTC_MONTH));
        t.year   = bcd_to_bin(cmos_read(RTC_YEAR));
        return t;
}

VD cursor_update(VD)
{//common cursor updater
	INT old;
	INT now;
	INT address_x;
	INT address_y;
	if(cursor_drawn && cursor_x < W && cursor_y < H) {
		old = cursor_y * W + cursor_x;
		screen_draw_cell(cursor_x, cursor_y, screen_Cs[old], screen_attrs[old], 0);
	}
	address_x = con_abs_x();
	address_y = con_abs_y();
	cursor_x = address_x;
	cursor_y = address_y;
	if(wm_on && memstat_overlay_cell(address_x, address_y) && wm_hit_window(address_x, address_y) < 0) {
		cursor_drawn = 0;
		return;
	}
	cursor_drawn = 1;
	if(cursor_x < W && cursor_y < H) {
		now = cursor_y * W + cursor_x;
		screen_draw_cell(cursor_x, cursor_y, screen_Cs[now], screen_attrs[now], 1);
	}
}

