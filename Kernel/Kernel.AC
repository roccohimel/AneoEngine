}

VD as_two_args(CC *string, C *array, C *boundary)
{
	INT index = 0;
	INT inner_index = 0;
	while(*string == ' ')
		string++;
	while(*string && *string != ' ')
		array[index++] = *string++;
	array[index] = 0;
	while(*string == ' ')
		string++;
	while(*string && *string != ' ')
		boundary[inner_index++] = *string++;
	boundary[inner_index] = 0;
}

VD rmsemiv(C *line)
{
        if (!line)
                return;
        INT index = 0;
        INT inner_index = 0;
        while (line[index]) {
                if (line[index] == ';') {
                        index += 3;
                }
                else {
                        line[inner_index] = line[index];
                        inner_index++;
                        index++;
                }
        }
        line[inner_index] = '\0';
}

VD rmsemi(C *line)
{
        if (!line)
                return;
        INT index = 0;
        INT inner_index = 0;
        while (line[index]) {
                if (line[index] == '\"' && line[index + 1] == ')' && line[index + 2] == ';') {
                        index += 3;
                }
                else {
                        line[inner_index] = line[index];
                        inner_index++;
                        index++;
                }
        }
        line[inner_index] = '\0';
}

