VD scroll(VD)
{//scroll the screen
	INT x_coordinate;
	INT y_coordinate;
	INT src;
	INT dst;
	INT limit;
	if(console_mode == CON_WINDOW)
		limit = con_h;
	else
		limit = H;
	if(cy < (U INT)limit)
		return;
	cursor_hide();
	if(console_mode == CON_WINDOW) {
		if(wm_on && wm_active >= 0 && wm_active < WM_WINDOWS && wm_windows[wm_active].alive) {
			INT identifier;
			identifier = wm_active;
			for(y_coordinate = 0; y_coordinate < con_h - 1; y_coordinate++) {
				src = (y_coordinate + 1) * WM_CONTENT_W;
				dst = y_coordinate * WM_CONTENT_W;
				fast_memcpy8(wm_buf_Cs + identifier * WM_BUFFER_SIZE + dst, wm_buf_Cs + identifier * WM_BUFFER_SIZE + src, con_w);
				fast_memcpy8(wm_buf_attrs + identifier * WM_BUFFER_SIZE + dst, wm_buf_attrs + identifier * WM_BUFFER_SIZE + src, con_w);
			}
			dst = (con_h - 1) * WM_CONTENT_W;
			fast_memset8(wm_buf_Cs + identifier * WM_BUFFER_SIZE + dst, ' ', con_w);
			fast_memset8(wm_buf_attrs + identifier * WM_BUFFER_SIZE + dst, color, con_w);
			cy = con_h - 1;
			wm_redraw_region(wm_windows[identifier].x, wm_windows[identifier].y, wm_windows[identifier].x + wm_windows[identifier].w - 1, wm_windows[identifier].y + wm_windows[identifier].h - 1);
			return;
		}
		mouse_hide();
		for(y_coordinate = 0; y_coordinate < con_h - 1; y_coordinate++) {
			src = (con_y + y_coordinate + 1) * W + con_x;
			dst = (con_y + y_coordinate) * W + con_x;
			fast_memcpy8(screen_Cs + dst, screen_Cs + src, con_w);
			fast_memcpy8(screen_attrs + dst, screen_attrs + src, con_w);
		}
		dst = (con_y + con_h - 1) * W + con_x;
		fast_memset8(screen_Cs + dst, ' ', con_w);
		fast_memset8(screen_attrs + dst, color, con_w);
		gfx_scroll_text_rect_up_8(con_x, con_y, con_w, con_h, (color >> 4) & 0x0F);
		cy = con_h - 1;
		mouse_show();
		return;
	}
	vga_movsl((VD*)screen_Cs, (const VD*)(screen_Cs + W), ((H - 1) * W) / 4);
	vga_movsl((VD*)screen_attrs, (const VD*)(screen_attrs + W), ((H - 1) * W) / 4);
	for(x_coordinate = 0; x_coordinate < W; x_coordinate++) {
		dst = (H - 1) * W + x_coordinate;
		screen_Cs[dst] = ' ';
		screen_attrs[dst] = color;
	}
	gfx_scroll_up_8((color >> 4) & 0x0F);
	cy = H - 1;
}
