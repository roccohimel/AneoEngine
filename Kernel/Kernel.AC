VD putc(C character)
{//place Cacter
	INT limit;
	INT address_x;
	INT address_y;
	if(console_mode == CON_WINDOW)
		limit = con_w;
	else
		limit = W;
	if(character == '\n') {
		cx = 0;
		cy++;
		scroll();
		cursor_update();
		return;
	}
	if(character == '\b') {
		if(cx > 0)
			cx--;
		address_x = con_abs_x();
		address_y = con_abs_y();
		screen_put_at(address_x, address_y, ' ', color);
		cursor_update();
		return;
	}
	address_x = con_abs_x();
	address_y = con_abs_y();
	screen_put_at(address_x, address_y, character, color);
	cx++;
	if(cx >= (U INT)limit) {
		cx = 0;
		cy++;
	}
	scroll();
	cursor_update();
}

VD printx_digit(u32 digit)
{
	if(digit < 10)
		putc('0' + digit);
	else
		putc('A' + (digit - 10));
}

VD printx(u32 x_value)
{//print a hexadecimal value
	printx_digit((x_value >> 28) & 0xF);
	printx_digit((x_value >> 24) & 0xF);
	printx_digit((x_value >> 20) & 0xF);
	printx_digit((x_value >> 16) & 0xF);
	printx_digit((x_value >> 12) & 0xF);
	printx_digit((x_value >> 8) & 0xF);
	printx_digit((x_value >> 4) & 0xF);
	printx_digit(x_value & 0xF);
}

