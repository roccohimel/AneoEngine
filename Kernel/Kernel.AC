INT wm_shell_target_window(VD)
{
	if(wm_task_exec_win >= 0 && wm_task_exec_win < WM_WINDOWS && wm_windows[wm_task_exec_win].alive)
		return wm_task_exec_win;
	if(wm_on && wm_active_ok())
		return wm_active;
	return -1;
