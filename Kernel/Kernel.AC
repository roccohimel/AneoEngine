		index++;
	while(index > 0 &&
	      (string[index - 1] == ' ' ||
	       string[index - 1] == '\n' ||
	       string[index - 1] == '\r' ||
	       string[index - 1] == '\t'))
	{
		string[index - 1] = 0;
		index--;
