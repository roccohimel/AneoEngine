INT wm_tune_freq(C note, INT accidental, INT octave)
{
	INT idx;
	INT frequency;
	idx = 0;
	if(note == 'C') idx = 0;
	else if(note == 'D') idx = 2;
	else if(note == 'E') idx = 4;
	else if(note == 'F') idx = 5;
	else if(note == 'G') idx = 7;
	else if(note == 'A') idx = 9;
	else if(note == 'B') idx = 11;
	idx += accidental;
	while(idx < 0) {
		idx += 12;
		octave--;
	}
	while(idx >= 12) {
		idx -= 12;
		octave++;
	}
	frequency = wm_tune_table[idx];
	while(octave > 4) {
		frequency *= 2;
		octave--;
	}
	while(octave < 4) {
		frequency /= 2;
		octave++;
	}
	if(frequency < 1)
		frequency = 1;
	return frequency;
}

INT wm_tune_duration_ms(INT tempo, C dur)
{
	INT cursor;
	INT duration_ms;
	if(tempo <= 0)
		tempo = 120;
	cursor = 60000 / tempo;
	if(dur == 'w' || dur == 'W')
		duration_ms = cursor * 4;
	else if(dur == 'h' || dur == 'H')
		duration_ms = cursor * 2;
	else if(dur == 'e' || dur == 'E')
		duration_ms = cursor / 2;
	else if(dur == 's' || dur == 'S')
		duration_ms = cursor / 4;
	else
		duration_ms = cursor;
	if(duration_ms < 10)
		duration_ms = 10;
	return duration_ms;
}

VD wm_tune_start(INT window_id, CC *song)
{
	INT index;
	WMWindow *win;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive || !song)
		return;
	win = &wm_windows[window_id];
	index = 0;
	while(song[index] && index < WM_INPUT_MAX - 1) {
		win->tune_song[index] = song[index];
		index++;
	}
	win->tune_song[index] = 0;
	win->tune_pos = 0;
	if(win->tune_tempo <= 0)
		win->tune_tempo = 120;
	win->tune_running = 1;
	win->tune_until = 0;
	win->tune_sounding = 0;
}

INT wm_tune_step(INT window_id)
{
	WMWindow *win;
	C *character;
	C note;
	C dur;
	INT accidental;
	INT octave;
	INT freq;
	INT duration_ms;
	INT tempo;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return 0;
	win = &wm_windows[window_id];
	if(!win->tune_running)
		return 0;
	if(win->tune_until) {
		if(total_ticks < win->tune_until)
			return 1;
		if(win->tune_sounding)
			nosound();
		win->tune_sounding = 0;
		win->tune_until = 0;
	}
	character = win->tune_song;
	for(;;) {
		while(character[win->tune_pos] == ' ' || character[win->tune_pos] == '\t' || character[win->tune_pos] == ',')
			win->tune_pos++;
		if(!character[win->tune_pos]) {
			win->tune_running = 0;
			nosound();
			return 0;
		}
		if(character[win->tune_pos] == 'T' || character[win->tune_pos] == 't') {
			win->tune_pos++;
			tempo = 0;
			while(character[win->tune_pos] >= '0' && character[win->tune_pos] <= '9') {
				tempo = tempo * 10 + (character[win->tune_pos] - '0');
				win->tune_pos++;
			}
			if(tempo > 0)
				win->tune_tempo = tempo;
			continue;
		}
		note = character[win->tune_pos++];
		if(note >= 'a' && note <= 'z')
			note -= 32;
		accidental = 0;
		if(character[win->tune_pos] == '#' || character[win->tune_pos] == '+') {
			accidental = 1;
			win->tune_pos++;
		}
		else if(character[win->tune_pos] == 'b' || character[win->tune_pos] == '-') {
			accidental = -1;
			win->tune_pos++;
		}
		octave = 4;
		if(character[win->tune_pos] >= '0' && character[win->tune_pos] <= '9')
			octave = character[win->tune_pos++] - '0';
		dur = 'q';
		if(character[win->tune_pos] == 'w' || character[win->tune_pos] == 'W' ||
		   character[win->tune_pos] == 'h' || character[win->tune_pos] == 'H' ||
		   character[win->tune_pos] == 'q' || character[win->tune_pos] == 'Q' ||
		   character[win->tune_pos] == 'e' || character[win->tune_pos] == 'E' ||
		   character[win->tune_pos] == 's' || character[win->tune_pos] == 'S')
			dur = character[win->tune_pos++];
		duration_ms = wm_tune_duration_ms(win->tune_tempo, dur);
		if(note == 'R') {
			nosound();
			win->tune_sounding = 0;
		}
		else if(note == 'A' || note == 'B' || note == 'C' || note == 'D' || note == 'E' || note == 'F' || note == 'G') {
			freq = wm_tune_freq(note, accidental, octave);
			beep((u32)freq);
			win->tune_sounding = 1;
		}
		else {
			continue;
		}
		win->tune_until = total_ticks + (u64)duration_ms;
		return 1;
	}
}

INT wm_is_wm_command(CC *line)
{
	if(!line)
		return 0;
	if(starts(line, "run(\"") && ends(line, "\");"))
		return 1;
	if(starts(line, "sleep(") && ends(line, ");"))
		return 1;
	if(starts(line, "tune(\"") && ends(line, "\");"))
		return 1;
	return 0;
}

u8 memstat_overlay_attr(u8 src)
{//make text draw over the white desktop background.
//Default white text becomes black so it stays readable.
	u8 foreground_color;
	foreground_color = src & 0x0F;
	if(foreground_color == 0x0F)
		foreground_color = 0x00;
	return 0xF0 | foreground_color;
}

INT memstat_overlay_cell(INT x_coordinate, INT y_coordinate)
{
	if(!wm_on || !memstat_overlay_ready || memstat_overlay_rows <= 0)
		return 0;
	if(x_coordinate < MEMSTAT_OVERLAY_X || x_coordinate >= MEMSTAT_OVERLAY_X + MEMSTAT_OVERLAY_W)
		return 0;
	if(y_coordinate < memstat_overlay_y || y_coordinate >= memstat_overlay_y + memstat_overlay_rows)
		return 0;
	return 1;
}

VD memstat_overlay_clear_buf(VD)
{
	INT x_coordinate;
	INT y_coordinate;
	for(y_coordinate = 0; y_coordinate < MEMSTAT_OVERLAY_H; y_coordinate++) {
		for(x_coordinate = 0; x_coordinate < MEMSTAT_OVERLAY_W; x_coordinate++) {
			memstat_overlay_Cs[y_coordinate * MEMSTAT_OVERLAY_W + x_coordinate] = ' ';
			memstat_overlay_attrs[y_coordinate * MEMSTAT_OVERLAY_W + x_coordinate] = 0xF0;
		}
	}
}

VD memstat_overlay_putc(INT row, INT *x_coordinate, C character, u8 col)
{
	if(row < 0 || row >= MEMSTAT_OVERLAY_H)
		return;
	if(*x_coordinate < 0 || *x_coordinate >= MEMSTAT_OVERLAY_W)
		return;
	memstat_overlay_Cs[row * MEMSTAT_OVERLAY_W + *x_coordinate] = character;
	memstat_overlay_attrs[row * MEMSTAT_OVERLAY_W + *x_coordinate] = memstat_overlay_attr(col);
	(*x_coordinate)++;
}

VD memstat_overlay_puts(INT row, INT *x_coordinate, CC *string, u8 col)
{
	INT index;
	if(!string)
		return;
	index = 0;
	while(string[index] && *x_coordinate < MEMSTAT_OVERLAY_W) {
		memstat_overlay_putc(row, x_coordinate, string[index], col);
		index++;
	}
}

VD memstat_overlay_put_uINT(INT row, INT *x_coordinate, U INT count, u8 col)
{
	C buf[11];
	INT index;
	if(count == 0) {
		memstat_overlay_putc(row, x_coordinate, '0', col);
		return;
	}
	index = 0;
	while(count && index < 10) {
		buf[index++] = '0' + (count % 10U);
		count /= 10U;
	}
	while(index--)
		memstat_overlay_putc(row, x_coordinate, buf[index], col);
}

u32 memstat_window_bytes(INT window_id)
{
	u32 bytes;
	WMWindow *win;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return 0;
	win = &wm_windows[window_id];
	if(!win->alive)
		return 0;
	bytes = (u32)sizeof(WMWindow);
	bytes += (u32)(WM_CONTENT_W * WM_CONTENT_H * 2);
	if(win->task_running)
		bytes += (u32)win->task_size;
	bytes += (u32)as_edit_win_mem(window_id);
	return bytes;
}

VD memstat_window_state(INT window_id, CC **name, u8 *col)
{
	WMWindow *win;
	*name = "IDLE";
	*col = 0x1F;
	if(window_id < 0 || window_id >= WM_WINDOWS)
		return;
	win = &wm_windows[window_id];
	if(!win->alive)
		return;
	if(as_edit_win_open(window_id)) {
		*name = "EDITOR";
		*col = 0x1E;
	}
	else if(win->tune_running) {
		*name = "TUNE";
		*col = 0x1D;
	}
	else if(win->task_wake != 0) {
		*name = "SLEEP";
		*col = 0x1D;
	}
	else if(win->task_running) {
		*name = "SCRIPT";
		*col = 0x1A;
	}
	else if(win->task_pending) {
		*name = "QUEUED";
		*col = 0x1A;
	}
}

CC *memstat_task_text(INT identifier)
{
	WMWindow *win = &wm_windows[identifier];
	CC *character;
	if(as_edit_win_open(identifier)) character = as_edit_win_path(identifier);
	else if(win->tune_running && win->tune_song[0]) character = win->tune_song;
	else if(win->task_cmd[0]) character = win->task_cmd;
	else character = win->title;
	if(character && character[0])
		return character;
	return "Shell";
}

u32 memstat_total_ram_bytes(VD)
{
	u32 count;
	if(memstat_total_cached)
		return memstat_total_cached;
	if(!wm_flash_last)
		return total_mem;
	count = (u32)cmos_read(0x34) | ((u32)cmos_read(0x35) << 8);
	if(count && count != 0xFFFFU)
		if(count > 65279U)
			memstat_total_cached = 0xFFFFFFFFU;
		else
			memstat_total_cached = 16U * 1024U * 1024U + count * 65536U;
	else {
		count = (u32)cmos_read(0x30) | ((u32)cmos_read(0x31) << 8);
		if(count && count != 0xFFFFU)
			memstat_total_cached = (1024U + count) * 1024U;
	}
	if(memstat_total_cached)
		return memstat_total_cached;
	return total_mem;
}

VD memstat_overlay_build(VD)
{
	INT identifier;
	INT x_coordinate;
	INT row;
	INT index;
	INT count;
	INT task_width = 1;
	INT memory_width = 1;
	INT used_column;
	INT line_width;
	u32 bytes;
	u32 used = 0;
	u32 total;
	CC *task;
	CC *state;
	u8 state_col;
	memstat_overlay_clear_buf();
	for(identifier = 0; identifier < WM_WINDOWS; identifier++) {
		if(!wm_windows[identifier].alive)
			continue;
		task = memstat_task_text(identifier);
		for(count = 0; task[count]; count++);
		if(count > task_width) task_width = count;
		bytes = memstat_window_bytes(identifier);
		used += bytes;
		for(count = 1; bytes >= 10U; count++) bytes /= 10U;
		if(count > memory_width) memory_width = count;
	}
	if(mem_used) {
		used += mem_used;
		bytes = mem_used;
		for(count = 1; bytes >= 10U; count++) bytes /= 10U;
		if(count > memory_width) memory_width = count;
	}
	if(task_width > MEMSTAT_OVERLAY_W - 27 - memory_width)
		task_width = MEMSTAT_OVERLAY_W - 27 - memory_width;
	if(task_width < 1) task_width = 1;
	used_column = 19 + task_width;
	line_width = used_column + 7 + memory_width;
	if(line_width > MEMSTAT_OVERLAY_W) line_width = MEMSTAT_OVERLAY_W;
	row = 0;
	x_coordinate = 0;
	memstat_overlay_puts(row, &x_coordinate, "WID_STAT____TASK__", 0x1F);
	for(index = 0; index < task_width; index++) memstat_overlay_putc(row, &x_coordinate, '_', 0x1F);
	memstat_overlay_puts(row, &x_coordinate, "_USEDMEM", 0x1F);
	for(index = 0; index < memory_width; index++) memstat_overlay_putc(row, &x_coordinate, '_', 0x1F);
	row++;
	for(identifier = 0; identifier < WM_WINDOWS && row < MEMSTAT_OVERLAY_H; identifier++) {
		if(!wm_windows[identifier].alive)
			continue;
		x_coordinate = 0;
		memstat_overlay_put_uINT(row, &x_coordinate, (U INT)identifier, 0x1F);
		while(x_coordinate < 4) memstat_overlay_putc(row, &x_coordinate, ' ', 0x1F);
		memstat_window_state(identifier, &state, &state_col);
		memstat_overlay_putc(row, &x_coordinate, '[', state_col);
		for(index = 0; state[index] && index < 9; index++)
			memstat_overlay_putc(row, &x_coordinate, state[index], state_col);
		while(index++ < 9)
			memstat_overlay_putc(row, &x_coordinate, ' ', state_col);
		memstat_overlay_putc(row, &x_coordinate, ']', state_col);
		memstat_overlay_puts(row, &x_coordinate, "  ", 0x1F);
		task = memstat_task_text(identifier);
		for(index = 0; task[index] && index < task_width; index++) memstat_overlay_putc(row, &x_coordinate, task[index], 0x1F);
		while(x_coordinate < used_column) memstat_overlay_putc(row, &x_coordinate, ' ', 0x1F);
		memstat_overlay_put_uINT(row++, &x_coordinate, memstat_window_bytes(identifier), 0x1F);
	}
	if(mem_used && row < MEMSTAT_OVERLAY_H) {
		x_coordinate = 0;
		memstat_overlay_putc(row, &x_coordinate, 'N', 0x1F);
		while(x_coordinate < 4) memstat_overlay_putc(row, &x_coordinate, ' ', 0x1F);
		memstat_overlay_putc(row, &x_coordinate, 'N', 0x1F);
		while(x_coordinate < 17) memstat_overlay_putc(row, &x_coordinate, ' ', 0x1F);
		memstat_overlay_puts(row, &x_coordinate, "Core", 0x1F);
		while(x_coordinate < used_column) memstat_overlay_putc(row, &x_coordinate, ' ', 0x1F);
		memstat_overlay_put_uINT(row++, &x_coordinate, mem_used, 0x1F);
	}
	if(row < MEMSTAT_OVERLAY_H) {
		x_coordinate = 0;
		for(index = 0; index < line_width; index++) memstat_overlay_putc(row, &x_coordinate, '_', 0x1F);
		row++;
	}
	total = memstat_total_ram_bytes();
	if(total < used) total = used;
	if(row < MEMSTAT_OVERLAY_H) {
		x_coordinate = 0;
		memstat_overlay_puts(row, &x_coordinate, "Total memory: ", 0x1F);
		memstat_overlay_put_uINT(row, &x_coordinate, total / 1024U, 0x1F);
		memstat_overlay_puts(row++, &x_coordinate, " KB", 0x1F);
	}
	if(row < MEMSTAT_OVERLAY_H) {
		x_coordinate = 0;
		memstat_overlay_puts(row, &x_coordinate, "Used memory: ", 0x1F);
		memstat_overlay_put_uINT(row++, &x_coordinate, used, 0x1F);
	}
	if(row < MEMSTAT_OVERLAY_H) {
		x_coordinate = 0;
		memstat_overlay_puts(row, &x_coordinate, "Free memory : ", 0x1F);
		memstat_overlay_put_uINT(row++, &x_coordinate, total - used, 0x1F);
	}
	memstat_overlay_rows = row;
	if(memstat_overlay_rows < 1) memstat_overlay_rows = 1;
	memstat_overlay_y = H - memstat_overlay_rows;
	if(memstat_overlay_y < 1) memstat_overlay_y = 1;
	memstat_overlay_ready = 1;
}

VD memstat_overlay_compose(INT screen_x, INT screen_y, C *outc, u8 *outcol)
{
	INT overlay_x;
	INT origin_y;
	if(!memstat_overlay_cell(screen_x, screen_y))
		return;
	if(!memstat_overlay_ready)
		memstat_overlay_build();
	overlay_x = screen_x - MEMSTAT_OVERLAY_X;
	origin_y = screen_y - memstat_overlay_y;
	*outc = memstat_overlay_Cs[origin_y * MEMSTAT_OVERLAY_W + overlay_x];
	*outcol = memstat_overlay_attrs[origin_y * MEMSTAT_OVERLAY_W + overlay_x];
}

VD memstat_overlay_refresh(INT force)
{
	INT sec;
	INT old_y;
	INT old_rows;
	INT start_y;
	INT end_y;
	INT old_bottom;
	INT new_bottom;
	if(!wm_on)
		return;
	sec = rtc_get_second();
	if(!force && sec == memstat_last_sec)
		return;
	old_y = memstat_overlay_y;
	old_rows = memstat_overlay_rows;
	memstat_last_sec = sec;
	memstat_overlay_build();
	if(old_rows <= 0) {
		start_y = memstat_overlay_y;
		end_y = memstat_overlay_y + memstat_overlay_rows - 1;
	}
	else {
		old_bottom = old_y + old_rows - 1;
		new_bottom = memstat_overlay_y + memstat_overlay_rows - 1;
		if(old_y < memstat_overlay_y)
			start_y = old_y;
		else
			start_y = memstat_overlay_y;
		if(old_bottom > new_bottom)
			end_y = old_bottom;
		else
			end_y = new_bottom;
	}
	if(start_y < 1)
		start_y = 1;
	if(end_y >= H)
		end_y = H - 1;
	if(start_y <= end_y)
		wm_redraw_region(0, start_y, W - 1, end_y);
}

VD memstat(VD)
{
	INT x_coordinate;
	INT y_coordinate;
	INT end;
	u8 oldcolor;
	oldcolor = color;
	memstat_overlay_build();
	for(y_coordinate = 0; y_coordinate < memstat_overlay_rows; y_coordinate++) {
		end = MEMSTAT_OVERLAY_W;
		while(end > 0 && memstat_overlay_Cs[y_coordinate * MEMSTAT_OVERLAY_W + end - 1] == ' ')
			end--;
		for(x_coordinate = 0; x_coordinate < end; x_coordinate++) {
			color = memstat_overlay_attrs[y_coordinate * MEMSTAT_OVERLAY_W + x_coordinate];
			putc(memstat_overlay_Cs[y_coordinate * MEMSTAT_OVERLAY_W + x_coordinate]);
		}
		putc('\n');
	}
	color = oldcolor;
}

VD wm_enqueue_cmd(INT window_id, CC *cmd)
{
	INT index;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive || !cmd)
		return;
	index = 0;
	while(cmd[index] && index < WM_INPUT_MAX - 1) {
		wm_windows[window_id].task_cmd[index] = cmd[index];
		index++;
	}
	wm_windows[window_id].task_cmd[index] = 0;
	wm_windows[window_id].task_pending = 1;
	wm_set_title(window_id, wm_windows[window_id].task_cmd);
	wm_redraw_region(wm_windows[window_id].bx, wm_windows[window_id].by, wm_windows[window_id].bx + wm_windows[window_id].bw - 1, wm_windows[window_id].by);
}

VD wm_task_begin_script_data(INT window_id, C *data, INT size)
{
	wm_windows[window_id].task_data = data;
	wm_windows[window_id].task_size = size;
	wm_windows[window_id].task_pos = 0;
	wm_windows[window_id].task_running = 1;
	wm_windows[window_id].task_pending = 0;
	wm_windows[window_id].task_wake = 0;
	wm_windows[window_id].tune_running = 0;
	wm_windows[window_id].tune_until = 0;
	wm_windows[window_id].tune_sounding = 0;
}

VD wm_task_start_script(INT window_id, CC *path)
{
	C *data;
	INT size;
	C clean[WM_INPUT_MAX];
	INT old_active;
	INT old_exec;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	old_active = wm_active;
	old_exec = wm_task_exec_win;
	wm_task_exec_win = window_id;
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	wm_task_clean_path(path, clean);
	wm_windows[window_id].task_running = 0;
	wm_windows[window_id].task_pending = 0;
	wm_windows[window_id].task_wake = 0;
	wm_windows[window_id].task_sp = 0;
	if(as_get_file_data(clean, &data, &size) != 0)
		print_red("File not found\n");
	else
		acri_run_data(data, size);
	if(wm_windows[window_id].alive && wm_active == window_id)
		con_save(&wm_windows[window_id]);
	wm_task_exec_win = old_exec;
	if(wm_active == window_id)
		wm_active = old_active;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
}

VD wm_task_chain_script(INT window_id, CC *path)
{
	WMWindow *win;
	C *data;
	INT size;
	C clean[WM_INPUT_MAX];
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	wm_task_clean_path(path, clean);
	if(as_get_file_data(clean, &data, &size) != 0) {
		print_red("File not found\n");
		return;
	}
	if(win->task_running) {
		if(win->task_sp >= WM_TASK_STACK_MAX) {
			print_red("Script stack full\n");
			return;
		}
		win->task_stack_data[win->task_sp] = win->task_data;
		win->task_stack_size[win->task_sp] = win->task_size;
		win->task_stack_pos[win->task_sp] = win->task_pos;
		win->task_sp++;
	}
	wm_task_begin_script_data(window_id, data, size);
}

VD wm_extract_quoted_arg(CC *line, C *out)
{
	INT index;
	INT inner_index;
	out[0] = 0;
	if(!line)
		return;
	index = 0;
	while(line[index] && line[index] != '"')
		index++;
	if(!line[index])
		return;
	index++;
	inner_index = 0;
	while(line[index] && line[index] != '"' && inner_index < WM_INPUT_MAX - 1)
		out[inner_index++] = line[index++];
	out[inner_index] = 0;
}

VD wm_task_clean_path(CC *src, C *dst)
{
	INT index;
	INT inner_index;
	dst[0] = 0;
	if(!src)
		return;
	index = 0;
	while(src[index] == ' ' || src[index] == '\t')
		index++;
	inner_index = 0;
	if(src[index] == 'R' && src[index + 1] == 'o' && src[index + 2] == 'o' && src[index + 3] == 't' && src[index + 4] == '/') {
		dst[inner_index++] = '/';
		index += 5;
	}
	while(src[index] && src[index] != ';' && inner_index < WM_INPUT_MAX - 1)
		dst[inner_index++] = src[index++];
	dst[inner_index] = 0;
	trim_end(dst);
}

INT wm_task_try_file(INT window_id, CC *line)
{
	C path[WM_INPUT_MAX];
	C *data;
	INT size;
	INT old_active;
	INT old_exec;
	if(!line || !line[0])
		return 0;
	if(strcmp(line, "__help;") == 0 || starts(line, "print(") || starts(line, "tune(") || starts(line, "sleep(") ||
	   starts(line, "run(") || starts(line, "cd(") || starts(line, "ls") ||
	   starts(line, "cat(") || starts(line, "edit(") || starts(line, "mkdir(") ||
	   starts(line, "touch(") || starts(line, "rm(") || starts(line, "cp(") ||
	   starts(line, "mv(") || starts(line, "comment(") || starts(line, "color(") ||
	   starts(line, "beep(") || strcmp(line, "save;") == 0 || strcmp(line, "load;") == 0 ||
	   strcmp(line, "ls;") == 0 || strcmp(line, "cls;") == 0 || strcmp(line, "n;") == 0)
		return 0;
	old_active = wm_active;
	old_exec = wm_task_exec_win;
	wm_task_exec_win = window_id;
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	wm_task_clean_path(line, path);
	if(as_get_file_data(path, &data, &size) == 0) {
		con_save(&wm_windows[window_id]);
		wm_task_exec_win = old_exec;
		wm_active = old_active;
		if(wm_active_ok())
			con_load(&wm_windows[wm_active]);
		if(wm_windows[window_id].task_running)
			wm_task_chain_script(window_id, path);
		else
			wm_task_start_script(window_id, path);
		return 1;
	}
	con_save(&wm_windows[window_id]);
	wm_task_exec_win = old_exec;
	wm_active = old_active;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
	return 0;
}

INT wm_task_run_line(INT window_id, C *line)
{
	INT old_active;
	INT old_exec;
	INT wait;
	u8 oldcolor;
	C arg[WM_INPUT_MAX];
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return 0;
	if(wm_task_try_file(window_id, line))
		return 0;
	old_active = wm_active;
	old_exec = wm_task_exec_win;
	oldcolor = color;
	wait = 0;
	wm_task_exec_win = window_id;
	wm_in_task_step = 1;
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	color = 0x1F;
	cursor_hide();
	if(starts(line, "tune(\"") && ends(line, "\");")) {
		wm_extract_quoted_arg(line, arg);
		wm_tune_start(window_id, arg);
		wm_tune_step(window_id);
		wait = wm_windows[window_id].tune_running || wm_windows[window_id].tune_until;
	}
	else if(starts(line, "sleep(") && ends(line, ");")) {
		wm_windows[window_id].task_wake = total_ticks + atoi(line + 6);
		wait = 1;
	}
	else if(starts(line, "run(\"") && ends(line, "\");")) {
		wm_extract_quoted_arg(line, arg);
		if(wm_windows[window_id].task_running)
			wm_task_chain_script(window_id, arg);
		else
			wm_task_start_script(window_id, arg);
	}
	else {
		shell_exec(line);
		if(wm_windows[window_id].task_wake != 0 || wm_windows[window_id].tune_running)
			wait = 1;
	}
	if(wm_windows[window_id].alive)
		con_save(&wm_windows[window_id]);
	wm_in_task_step = 0;
	wm_task_exec_win = old_exec;
	if(wm_task_focus_win >= 0 && wm_task_focus_win < WM_WINDOWS && wm_windows[wm_task_focus_win].alive)
		old_active = wm_task_focus_win;
	wm_task_focus_win = -1;
	wm_active = old_active;
	color = oldcolor;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
	cursor_update();
	return wait;
}

VD wm_task_prompt_if_idle(INT window_id)
{
	INT old_active;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	if(as_edit_win_open(window_id))
		return;
	if(wm_windows[window_id].task_running || wm_windows[window_id].task_pending || wm_windows[window_id].task_wake != 0 || wm_windows[window_id].tune_running)
		return;
	old_active = wm_active;
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	wm_prompt();
	con_save(&wm_windows[window_id]);
	wm_active = old_active;
	if(wm_active_ok())
		con_load(&wm_windows[wm_active]);
}

VD wm_task_step(INT window_id)
{
	WMWindow *win;
	C line[WM_INPUT_MAX];
	INT inner_index;
	INT had_wait;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	win = &wm_windows[window_id];
	had_wait = win->tune_running || win->task_wake != 0;
	if(wm_tune_step(window_id))
		return;
	if(win->task_wake != 0) {
		if(total_ticks < win->task_wake)
			return;
		win->task_wake = 0;
	}
	if(had_wait && !win->task_running && !win->task_pending && win->task_wake == 0 && !win->tune_running) {
		wm_task_prompt_if_idle(window_id);
		return;
	}
	if(win->task_pending) {
		strcpy(line, win->task_cmd);
		win->task_pending = 0;
		if(wm_task_run_line(window_id, line))
			return;
		if(wm_windows[window_id].alive && !wm_windows[window_id].task_running && !wm_windows[window_id].task_pending && wm_windows[window_id].task_wake == 0 && !wm_windows[window_id].tune_running) {
			wm_task_prompt_if_idle(window_id);
			return;
		}
	}
	if(!win->task_running)
		return;
	for(inner_index = 0; inner_index < 8 && win->task_running; inner_index++) {
		INT third_index;
		third_index = 0;
		while(win->task_pos < win->task_size && win->task_data[win->task_pos] != '\n' && third_index < WM_INPUT_MAX - 1)
			line[third_index++] = win->task_data[win->task_pos++];
		line[third_index] = 0;
		if(win->task_pos < win->task_size && win->task_data[win->task_pos] == '\n')
			win->task_pos++;
		trim_end(line);
		if(line[0] == 0)
			continue;
		if(line[0] == '/' && line[1] == '/')
			continue;
		if(wm_task_run_line(window_id, line))
			return;
		if(wm_windows[window_id].task_wake != 0 || wm_windows[window_id].tune_running || wm_windows[window_id].task_pending)
			return;
		if(win->task_pos >= win->task_size)
			break;
	}
	if(win->task_pos >= win->task_size && win->task_running) {
		if(win->task_sp > 0) {
			win->task_sp--;
			win->task_data = win->task_stack_data[win->task_sp];
			win->task_size = win->task_stack_size[win->task_sp];
			win->task_pos = win->task_stack_pos[win->task_sp];
			return;
		}
		win->task_running = 0;
		wm_task_prompt_if_idle(window_id);
	}
}

VD ticks_poll(VD)
{//advance total_ticks by polling PIT channel 0
//(same wraparound trick as sleep(), 1 wrap = ~1ms)
	u16 now;
	now = pit_read_counter();
	if(!ticks_initialized) {
		ticks_last = now;
		ticks_initialized = 1;
		return;
	}
	if(now > ticks_last)
		total_ticks++;
	ticks_last = now;
}

u8 wm_flash_attr(u8 col)
{
	(VD)col;
	if(wm_flash_phase)
		return 0x1F;
	return 0xF1;
}

VD wm_flash_poll(VD)
{
	WMWindow *win;
	u64 now;
	INT window_id;
	INT redraw_top;
	INT redraw_bottom;
	if(!wm_on)
		return;
	now = total_ticks;
	redraw_top = 0;
	redraw_bottom = 0;
	if(now - wm_flash_last >= 500) {
		wm_flash_last = now;
		wm_flash_phase = !wm_flash_phase;
		redraw_top = 1;
		redraw_bottom = 1;
	}
	if(!redraw_top && !redraw_bottom)
		return;
	for(window_id = 0; window_id < WM_WINDOWS; window_id++) {
		win = &wm_windows[window_id];
		if(!win->alive)
			continue;
		if(redraw_top)
			wm_redraw_region(win->bx, win->by,
				win->bx + win->bw - 1, win->by);
		if(redraw_bottom)
			wm_redraw_region(win->bx, win->by + win->bh - 1,
				win->bx + win->bw - 1, win->by + win->bh - 1);
	}
}

VD wm_tasks_step(VD)
{
	INT count;
	INT window_id;
	INT stepped;
	ticks_poll();
	stepped = 0;
	for(count = 0; count < WM_WINDOWS; count++) {
		window_id = (wm_task_rr + count) % WM_WINDOWS;
		if(!wm_windows[window_id].alive)
			continue;
		if(!wm_windows[window_id].task_pending &&
		   !wm_windows[window_id].task_running &&
		   wm_windows[window_id].task_wake == 0 &&
		   !wm_windows[window_id].tune_running)
			continue;
		wm_task_step(window_id);
		stepped = 1;
	}
	if(stepped)
		wm_task_rr = (wm_task_rr + 1) % WM_WINDOWS;
}

VD wm_submit_line(INT window_id, CC *line)
{
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	if(line && line[0])
		wm_enqueue_cmd(window_id, line);
}

VD wm_handle_key(INT character_code)
{
	WMWindow *win;
	INT maxx;
	INT maxy;
	INT count;
	C line[WM_INPUT_MAX];
	if(character_code == '\t' && ctrl) {
		wm_switch();
		return;
	}
	if(shift && character_code == 3) {
		wm_create_window(WM_ADD_CARD);
		return;
	}
	if(shift && character_code == 14) {
		wm_create_window(WM_ADD_SIDE);
		return;
	}
	if(shift && character_code == 17) {
		if(wm_active_ok()) {
			wm_close_window(wm_active);
			cursor_update();
		}
		return;
	}
	if(!wm_active_ok())
		return;
	win = &wm_windows[wm_active];
	con_load(win);
	if(as_edit_win_open(wm_active)) {
		color = 0x1F;
		if(character_code == '\t') {
			for(count = 0; count < 8; count++)
				as_edit_key_win(wm_active, ' ');
			con_save(win);
			return;
		}
		if(character_code == 6 || character_code == 3) {
			con_save(win);
			if(character_code == 6)
				wm_toggle_fullscreen(wm_active);
			else
				wm_toggle_card(wm_active);
			if(wm_active_ok() && as_edit_win_open(wm_active)) {
				con_load(&wm_windows[wm_active]);
				as_edit_win_refresh(wm_active);
				con_save(&wm_windows[wm_active]);
				cursor_update();
			}
			return;
		}
		if(as_edit_key_win(wm_active, character_code)) {//editor closed, give the window its shell back
			clear();
			wm_prompt();
		}
		con_save(win);
		return;
	}
	color = 0x1A;
	if(character_code == '\t') {
		for(count = 0; count < 8; count++)
			wm_insert_C_here(wm_active, ' ');
		con_save(win);
		return;
	}
	if(character_code == 6) {
		con_save(win);
		wm_toggle_fullscreen(wm_active);
		return;
	}
	if(character_code == 3) {
		con_save(win);
		wm_toggle_card(wm_active);
		return;
	}
	if(character_code == 12) {
		if(wm_cursor_on_prompt_line(wm_active))
			wm_sync_input_from_screen(wm_active);
		strcpy(line, win->input);
		wm_clear_highlight();
		wm_shift_selecting = 0;
		clear();
		wm_prompt();
		print(line);
		strcpy(win->input, line);
		win->input_len = strlen(line);
		cursor_update();
		con_save(win);
		return;
	}
	if(character_code == '\n') {
		if(wm_selected_win == wm_active && wm_selected_cmd[0]) {
			strcpy(line, wm_selected_cmd);
			wm_clear_highlight();
			wm_prepare_selected_run_line(line);
			con_save(win);
			wm_submit_line(wm_active, line);
			return;
		}
		if(wm_cursor_on_prompt_line(wm_active))
			wm_sync_input_from_screen(wm_active);
		else {
			wm_select_line(wm_active, cy);
			strcpy(line, wm_selected_cmd);
			wm_clear_highlight();
			wm_prepare_selected_run_line(line);
			con_save(win);
			wm_submit_line(wm_active, line);
			return;
		}
		win->input[win->input_len] = 0;
		strcpy(line, win->input);
		win->input_len = 0;
		win->input[0] = 0;
		putc('\n');
		if(line[0] == 0) {
			wm_prompt();
			con_save(win);
			return;
		}
		con_save(win);
		wm_submit_line(wm_active, line);
		return;
	}
	if(character_code == '\b') {
		wm_backspace_here(wm_active);
		con_save(win);
		return;
	}
	maxx = win->w;
	maxy = win->h;
	if(character_code == KEY_UP || character_code == KEY_DOWN || character_code == KEY_LEFT || character_code == KEY_RIGHT) {
		if(shift && !wm_shift_selecting) {
			wm_shift_ax = cx;
			wm_shift_ay = cy;
			wm_shift_selecting = 1;
		}
		if(character_code == KEY_UP) {
			if(cy > 0)
				cy--;
		}
		else if(character_code == KEY_DOWN) {
			if(cy + 1 < (U INT)maxy)
				cy++;
		}
		else if(character_code == KEY_LEFT) {
			if(cx > 0)
				cx--;
		}
		else if(character_code == KEY_RIGHT) {
			if(cx + 1 < (U INT)maxx)
				cx++;
		}
		if(shift)
			wm_select_range(wm_active, wm_shift_ax, wm_shift_ay, cx, cy);
		else
			wm_shift_selecting = 0;
		cursor_update();
		con_save(win);
		return;
	}
	if(character_code >= 32 && character_code < 127) {
		wm_shift_selecting = 0;
		wm_insert_C_here(wm_active, (C)character_code);
		con_save(win);
	}
}

VD wm_start_shell_window(INT window_id)
{
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	color = 0x1F;
	wm_set_title(window_id, "Terminal");
	clear();
	wm_prompt();
	con_save(&wm_windows[window_id]);
}

VD wm_start_window(INT window_id)
{
	CC *path;
	C cmd[WM_INPUT_MAX];
	INT index;
	INT inner_index;
	if(window_id < 0 || window_id >= WM_WINDOWS || !wm_windows[window_id].alive)
		return;
	path = "/RunCmds.AC";
	if(window_id == 1)
		path = "/Everist/Index/Main.AC";
	wm_active = window_id;
	con_load(&wm_windows[window_id]);
	color = 0x1F;
	inner_index = 0;
	cmd[inner_index++] = 'r';
	cmd[inner_index++] = 'u';
	cmd[inner_index++] = 'n';
	cmd[inner_index++] = '(';
	cmd[inner_index++] = '\"';
	index = 0;
	while(path[index] && inner_index < WM_INPUT_MAX - 4)
		cmd[inner_index++] = path[index++];
	cmd[inner_index++] = '\"';
	cmd[inner_index++] = ')';
	cmd[inner_index++] = ';';
	cmd[inner_index] = 0;
	wm_set_title(window_id, cmd);
	clear();
	print(cmd);
	print("\n");
	wm_enqueue_cmd(window_id, cmd);
	con_save(&wm_windows[window_id]);
}

VD wm_switch(VD)
{
	INT next;
	wm_clear_highlight();
	next = wm_next_alive_from(wm_active);
	if(next >= 0)
		wm_activate(next);
}

VD wm(VD)
{
	INT character_value;
	INT memstat_last_sec;
	INT sec;
	wm_on = 1;
	wm_active = 0;
	con_set_full();
	color = 0x1F;
	gfx_set_start(0);
	nosound();
	wm_setup();
	wm_clear_background();
	memstat_overlay_refresh(1);
	draw_tb();
	update_rtc_only();
	wm_draw();
	mouse_init();
	wm_start_window(0);
	wm_start_window(1);
	memstat_overlay_refresh(1);
	wm_active = 0;
	con_load(&wm_windows[0]);
	wm_redraw_all();
	cursor_update();
	wm_flash_phase = 0;
	wm_flash_last = total_ticks;
	memstat_last_sec = -1;
	for(;;) {
		sec = rtc_get_second();
		if(sec != memstat_last_sec) {
			update_rtc_only();
			memstat_overlay_refresh(1);
			memstat_last_sec = sec;
		}
		ticks_poll();
		wm_flash_poll();
		wm_mouse_poll();
		wm_tasks_step();
		character_value = getkey();
		if(character_value)
			wm_handle_key(character_value);
		wm_tasks_step();
	}
}

INT shell(VD)
{//shell loop
	wm();
	return 0;
}

VD kmain(VD)
{//main
	clear();
	startupSeq();
}
