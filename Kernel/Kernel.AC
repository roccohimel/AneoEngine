#define KEY_UP    0x101
#define KEY_DOWN  0x102
#define KEY_LEFT  0x103
#define KEY_RIGHT 0x104

INT readline(C *buf, INT max)
{//read input
        INT index = 0;
        INT character_code;
        INT memstat_last_sec = -1;
        INT sec;
        INT maxx;
        INT maxy;
        INT spaces;
        for(;;) {//while waiting, update the RTC from the top bar
                sec = rtc_get_second();
		if(sec != memstat_last_sec) {
        		update_rtc_only();
        		memstat_last_sec = sec;
		}
		if(wm_on)
			wm_mouse_poll();
                character_code = getkey();
                if(!character_code)
                        continue;
		if(character_code == '\t') {
			spaces = 0;
			while(spaces < 8 && index < max - 1) {
				buf[index++] = ' ';
				putc(' ');
				spaces++;
			}
			continue;
		}
		if(wm_on && character_code == 6) {
			buf[index] = 0;
			if(wm_active_ok()) {
				con_save(&wm_windows[wm_active]);
				wm_toggle_fullscreen(wm_active);
			}
			index = 0;
			continue;
		}
		if(wm_on && character_code == 3) {
			buf[index] = 0;
			if(wm_active_ok()) {
				con_save(&wm_windows[wm_active]);
				wm_toggle_card(wm_active);
			}
			index = 0;
			continue;
		}
                if(character_code == '\n') {
			if(wm_on && wm_selected_win == wm_active && wm_selected_cmd[0]) {
				strcpy(buf, wm_selected_cmd);
				wm_clear_highlight();
				wm_prepare_selected_run_line(buf);
				return 0;
			}
                        buf[index] = 0;
                        putc('\n');
                        return 0;
                }
                if(character_code == '\b') {
                        if(index > 0) {
                                index--;
                                putc('\b');
                        }
                        continue;
                }
		if(console_mode == CON_WINDOW)
			maxx = con_w;
		else
			maxx = W;
		if(console_mode == CON_WINDOW)
			maxy = con_h;
		else
			maxy = H;
		if(character_code == KEY_UP || character_code == KEY_DOWN || character_code == KEY_LEFT || character_code == KEY_RIGHT) {
			U INT oldcx;
			U INT oldcy;
			oldcx = cx;
			oldcy = cy;
			if(wm_on && console_mode == CON_WINDOW && shift && !wm_shift_selecting) {
				wm_shift_ax = cx;
				wm_shift_ay = cy;
				wm_shift_selecting = 1;
			}
			if(character_code == KEY_UP) {
				if(cy > 0)
					cy--;
			}
			else if(character_code == KEY_DOWN) {
				if(cy + 1 < (U INT)maxy)
					cy++;
			}
			else if(character_code == KEY_LEFT) {
				if(cx > 0)
					cx--;
			}
			else if(character_code == KEY_RIGHT) {
				if(cx + 1 < (U INT)maxx)
					cx++;
			}
			if(wm_on && console_mode == CON_WINDOW) {
				if(shift)
					wm_select_range(wm_active, wm_shift_ax, wm_shift_ay, cx, cy);
				else {
					wm_shift_selecting = 0;
					if(wm_selected_type != 2 || wm_selected_win != wm_active)
						wm_select_line(wm_active, cy);
				}
			}
			else {
				(VD)oldcx;
				(VD)oldcy;
			}
			cursor_update();
			continue;
		}
		if(character_code == 12) {
			buf[index] = 0;
			clear();
			redraw_shell_input(buf, index);
			continue;
		}
		if(index < max - 1) {
			if(wm_on) {
				wm_shift_selecting = 0;
				wm_clear_highlight();
			}
                        buf[index] = character_code;
                        index++;
                        putc(character_code);
                }
        }
	return 0;
}

INT starts(CC *string, CC *pointer)
{
	INT index = 0;
	while(pointer[index]) {
		if(string[index] != pointer[index])
			return 0;
		index++;
	}
	return 1;
}

INT ends(CC *string, CC *pointer)
{
	if (!string || !pointer)
		return 0;
	INT s_len = strlen(string);
    	INT p_len = strlen(pointer);
    	if (p_len > s_len)
		return 0;
    	INT index = p_len - 1;
    	while (index >= 0) {
        	if (string[s_len - p_len + index] != pointer[index])
            		return 0;
        	index--;
    	}
    	return 1;
}

C *skip(C *string)
