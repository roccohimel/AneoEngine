TD U S u16;
TD U INT u32;
#define KEY_F1  0x3B
#define KEY_F2  0x3C
#define KEY_F3  0x3D
#define KEY_F4  0x3E
#define KEY_F5  0x3F
#define KEY_F6  0x40
#define KEY_F7  0x41
#define KEY_F8  0x42
#define KEY_F9  0x43
#define KEY_F10 0x44
#define KEY_F11 0x57
#define KEY_F12 0x58
extern INT as_edit_win_mem(INT id);
extern CC *as_edit_win_path(INT id);
extern u8 inb(u16 port);
extern VD print(CC *s);
extern INT helpMenu(VD);
extern VD reset(VD);
extern INT utilsMenu(VD);
extern VD cpustat(VD);
extern VD clear(VD);
extern U INT raw;
extern VD run_script(CC *path);
extern VD update_rtc_only(VD);
extern VD draw_tb(VD);
extern INT wm_on;
extern INT wm_create_window(INT kind);
extern VD wm_enqueue_cmd(INT id, CC *cmd);
extern VD wm_open_help_window(VD);
extern VD entropy(VD);
SC CC keymap[128] =
{//allowed Cs
	0, 27, '1', '2', '3', '4', '5', '6',
	'7', '8', '9', '0', '-', '=', '\b', '\t',
	'q', 'w', 'e', 'r', 't', 'y', 'u', 'i',
	'o', 'p', '[', ']', '\n', 0, 'a', 's',
	'd', 'f', 'g', 'h', 'j', 'k', 'l', ';',
	'\'', '`', 0, '\\', 'z', 'x', 'c', 'v',
	'b', 'n', 'm', ',', '.', '/', 0, '*',
	0, ' ', 0
};
SC CC shiftmap[128] =
{//allowed Cs when shift is pressed
	0, 27, '!', '@', '#', '$', '%', '^',
	'&', '*', '(', ')', '_', '+', '\b', '\t',
	'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I',
	'O', 'P', '{', '}', '\n', 0, 'A', 'S',
	'D', 'F', 'G', 'H', 'J', 'K', 'L', ':',
	'"', '~', 0, '|', 'Z', 'X', 'C', 'V',
	'B', 'N', 'M', '<', '>', '?', 0, '*',
	0, ' ', 0
};
INT shift = 0;
#define KEY_UP    0x101
#define KEY_DOWN  0x102
#define KEY_LEFT  0x103
#define KEY_RIGHT 0x104
#define ESC       27
INT ctrl = 0;
INT ext = 0;

VD clearet(VD)
{
	clear();
	draw_tb();
	update_rtc_only();
	run_script("/RunCmds.c");
}

SC VD HandleFn(u8 scan_code)
{
	switch(scan_code) {
		case KEY_F1:
			wm_open_help_window();
			break;
		case KEY_F2:
			raw = 1;
			break;
		case KEY_F3:
			raw = 0;
			break;
		case KEY_F4:
			entropy();
                        break;
		case KEY_F5:
                        print("This is the F5 key\n");
                        break;
		case KEY_F6:
                        print("This is the F6 key\n");
                        break;
		case KEY_F7:
                        print("This is the F7 key\n");
                        break;
		case KEY_F8:
                        print("This is the F8 key\n");
                        break;
		case KEY_F9:
                        print("This is the F9 key\n");
                        break;
		case KEY_F10:
                        print("This is the F10 key\n");
                        break;
	}
}

INT getkey(VD)
{
	u8 status;
	u8 scan_code;
	C character;
	status = inb(0x64);
	if(!(status & 1))
		return 0;
	if(status & 0x20) {
		if(wm_on)
			return 0;
		inb(0x60);
		return 0;
	}
	scan_code = inb(0x60);
	if(scan_code == 0xE0) {
		ext = 1;
		return 0;
	}
	if(scan_code == 0x01) {
		return ESC;
	}
	if(ext) {
		ext = 0;
		if(scan_code == 0x48)
			return KEY_UP;
		if(scan_code == 0x50)
			return KEY_DOWN;
		if(scan_code == 0x4B)
			return KEY_LEFT;
		if(scan_code == 0x4D)
			return KEY_RIGHT;
		return 0;
	}
	if(scan_code == 42 || scan_code == 54) {
		shift = 1;
		return 0;
	}
	if(scan_code == 170 || scan_code == 182) {
		shift = 0;
		return 0;
	}
	if(scan_code == 29) {
		ctrl = 1;
		return 0;
	}
	if(scan_code == 157) {
		ctrl = 0;
		return 0;
	}
	if(scan_code & 0x80)
		return 0;
	if(
		(scan_code >= KEY_F1 && scan_code <= KEY_F10) ||
		scan_code == KEY_F11 ||
		scan_code == KEY_F12
	)
	{
		HandleFn(scan_code);
		return 0;
	}
	if(scan_code >= 128)
		return 0;
	if(shift)
		character = shiftmap[scan_code];
	else
		character = keymap[scan_code];
	if(ctrl && character >= 'a' && character <= 'z')
		return character - 'a' + 1;
	if(ctrl && character >= 'A' && character <= 'Z')
		return character - 'A' + 1;
	return character;
}
